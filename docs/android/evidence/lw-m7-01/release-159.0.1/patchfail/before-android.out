-                onPingItemClicked = {
-                    gleanDebugToolsStore.dispatch(GleanDebugToolsAction.ChangePingType(it))
-                },
-                onSendPing = { gleanDebugToolsStore.dispatch(GleanDebugToolsAction.SendPing) },
-            )
-        }
-    }
-}
