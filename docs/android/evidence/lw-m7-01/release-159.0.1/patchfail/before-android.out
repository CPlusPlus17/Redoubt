-        onOpenDebugView(false)
-    }
-
-    HorizontalDivider()
-
-    GleanDebugButton(text = stringResource(R.string.glean_debug_tools_copy_debug_view_link)) {
-        onCopyDebugViewLink(false)
-    }
-}
-
-@Composable
-private fun GleanDebugSendPingsSection(
