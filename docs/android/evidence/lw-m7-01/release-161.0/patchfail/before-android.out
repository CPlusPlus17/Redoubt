+    @Test
+    fun `restored periodic work uses automatic path and explicit work uses manual path`() =
+        runTest(testDispatcher) {
+            val manager = mock<AddonManager>()
+            val automatic = argumentCaptor<((AddonUpdater.Status) -> Unit)>()
+            val manual = argumentCaptor<((AddonUpdater.Status) -> Unit)>()
+            GlobalAddonDependencyProvider.initialize(manager, mock())
+            whenever(manager.updateAddonAutomatically(anyString(), automatic.capture())).then {
+                automatic.value(AddonUpdater.Status.NoUpdateAvailable)
+            }
+            whenever(manager.updateAddon(anyString(), manual.capture())).then {
+                manual.value(AddonUpdater.Status.NoUpdateAvailable)
+            }
