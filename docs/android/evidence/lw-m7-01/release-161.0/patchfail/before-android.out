---[snip]---------- --> third_party/application-services/build-scripts/component-common.gradle.rej:
--- third_party/application-services/build-scripts/component-common.gradle
+++ third_party/application-services/build-scripts/component-common.gradle
@@ -101,6 +101,19 @@
 
 kotlin {
     jvmToolchain(rootProject.config.jvmTargetCompatibility)
+    // LibreWolf (patches/android/build-fixes.patch, section 2): in a
+    // mozilla-central build the UniFFI bindings come pre-generated from
+    // toolkit/components/uniffi-bindgen-gecko-js/android (see the srcDirs line
+    // above), and every one of them ends uniffiEnsureInitialized() with a bare
+    // `UniffiLib` reference. Kotlin 2.4 reports that as "Expression is unused",
+    // and the conventions plugin turns every Kotlin warning into an error.
+    // The files are generated and checked in upstream, so the fix belongs in
+    // the build config, not in 21 generated files.
+    if (gradle.hasProperty("mozconfig")) {
+        compilerOptions {
+            freeCompilerArgs.add("-Xwarning-level=UNUSED_EXPRESSION:disabled")
+        }
+    }
 }
 
 dependencies {
