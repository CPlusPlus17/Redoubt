+            verify(manager, never()).updateAddon(eq("restored"), any())
+
+            val explicit = createWorker("explicit", listOf(DefaultAddonUpdater.WORK_TAG_IMMEDIATE))
+            doReturn(this).`when`(explicit).attemptScope
+            explicit.updateAttemptStorage = mock()
+            assertEquals(ListenableWorker.Result.success(), explicit.startWork().await())
+            verify(manager).updateAddon(eq("explicit"), any())
+            verify(manager, never()).updateAddonAutomatically(eq("explicit"), any())
+        }
