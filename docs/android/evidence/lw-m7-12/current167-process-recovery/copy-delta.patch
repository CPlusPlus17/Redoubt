+def fresh_namespace(path):
+    require(not path.exists() and not path.is_symlink(), 'fresh checkpoint namespace required: ' + str(path))
+
+
+def preserved_tree(path):
+    """Exact regular-file inventory, excluding no entries inside this bounded root."""
+    require(path.is_dir() and not path.is_symlink(), 'prior evidence directory absent/linked: ' + str(path))
+    files = {}
+    for folder, directories, names in os.walk(path, followlinks=False):
+        for name in directories + names:
+            entry = Path(folder) / name
+            require(not entry.is_symlink(), 'linked prior evidence is not accepted: ' + str(entry))
+        for name in names:
+            entry = Path(folder) / name
+            require(entry.is_file(), 'nonregular prior evidence: ' + str(entry))
+            files[str(entry.relative_to(path))] = record(entry)
+    require(files, 'empty prior evidence inventory')
+    return {'root': str(path), 'files': {name: files[name] for name in sorted(files)}}
+
+
+def prior_services():
+    result = {}
+    for kind, invocation in PRIOR_INVOCATIONS.items():
+        observed = service(f'redoubt-fenix-regression-{kind}-20260909.service', invocation,
+                           terminal=(kind == 'apk'))
+        if kind == 'runtime':
+            # Failed/interrupted runtime is retained diagnostic history. It is
+            # never promoted to an acceptance gate for the corrected candidate.
+            require((observed['ActiveState'], observed['SubState']) in
+                    {('active', 'exited'), ('inactive', 'dead'), ('failed', 'failed')},
+                    'prior runtime must be terminal before preserving its evidence')
+        result[kind] = observed
+    return result
+
+
+def prior_checkpoint_inputs():
+    terminal = prior_services()
+    parent = json.loads((HERE / 'parent-inputs.json').read_text())
+    code = {}
+    for name, pin in parent['original_driver_inputs'].items():
+        observed = record(REPO / name)
+        require(observed['sha256'] == pin['sha256'] and observed['bytes'] == pin['bytes'],
+                'historical checkpoint driver bytes changed: ' + name)
+        code[name] = observed
+    trees = {kind: preserved_tree(path) for kind, path in PRIOR_EVIDENCE.items()}
+    trees['apks'] = preserved_tree(PRIOR_APKS)
+    apks = apk_set(PRIOR_APKS)
+    for kind, path in PRIOR_EVIDENCE.items():
+        state = json.loads((path / 'result.json').read_text())
+        require(state['kind'] == kind and state['service']['InvocationID'] == PRIOR_INVOCATIONS[kind]
+                and state['source_manifest']['sha256'] == PRIOR_SOURCE,
+                'prior checkpoint identity differs')
+        require(checked(state['inputs']) == path / 'inputs.json'
+                and checked(state['source_manifest']) == path / 'source-sha256.txt',
+                'prior checkpoint input/source path differs')
+        config = json.loads((path / 'inputs.json').read_text())
+        require(config['source_sha256'] == PRIOR_SOURCE and config['kind'] == kind,
+                'prior checkpoint configuration differs')
+        for name in ('common.py', 'build.py', 'runtime.py'):
+            key = 'docs/android/evidence/lw-m7-12/current167/' + name
+            require(config['repository_files'][key] == code[key], 'prior config/code binding changed')
+        if kind == 'apk':
+            require(state['status'] == 'PASS' and state['apks'] == apks,
+                    'prior successful APK identity differs')
+        else:
+            require(config['apks'] == apks, 'prior runtime selected different APKs')
+    require(prior_services() == terminal, 'prior checkpoint service changed during inventory')
+    return {'scope': 'Preserved successful old APK and failed/interrupted runtime; not recovery acceptance',
+            'services': terminal, 'trees': trees, 'original_driver_files': code}
+
+
+def check_prior_checkpoint(expected):
+    require(prior_checkpoint_inputs() == expected, 'historical checkpoint evidence/code/APKs changed')
