diff --git a/toolkit/components/translations/tests/unit/test_android_translation_assets.js b/toolkit/components/translations/tests/unit/test_android_translation_assets.js
new file mode 100644
--- /dev/null
+++ b/toolkit/components/translations/tests/unit/test_android_translation_assets.js
@@ -0,0 +1,50 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+const { AppConstants } = ChromeUtils.importESModule(
+  "resource://gre/modules/AppConstants.sys.mjs"
+);
+
+add_task({ skip_if: () => AppConstants.platform !== "android" }, async function test_packaged_catalog_and_wasm_offline() {
+  do_get_profile();
+  const { AndroidTranslationAssets, decompressAndroidTranslationAsset } =
+    ChromeUtils.importESModule(
+      "resource://gre/modules/translations/AndroidTranslationAssets.sys.mjs"
+    );
+  const assets = AndroidTranslationAssets.instance;
+  const wasOffline = Services.io.offline;
+  Services.io.offline = true;
+  try {
+    const models = await assets.client("models").get();
+    const nightly = ["default", "nightly"].includes(AppConstants.MOZ_UPDATE_CHANNEL);
+    Assert.equal(models.length, nightly ? 362 : 347);
+    Assert.ok(models.every(record => record.filter_expression !== "env.appinfo.OS != 'Android'"));
+    const [wasm] = await assets.client("wasm").get();
+    Assert.equal(wasm.version, "4.0");
+    const payload = await assets.read(wasm);
+    const bytes = await decompressAndroidTranslationAsset(new Blob([payload.buffer]), wasm);
+    Assert.equal(bytes.byteLength, 4960506);
+    Assert.deepEqual(Array.from(new Uint8Array(bytes).slice(0, 4)), [0, 97, 115, 109]);
+    await Assert.rejects(assets.client("models").sync(), /sync is disabled/);
+    await Assert.rejects(assets.read({ ...models[0], id: "unlisted" }), /Unlisted/);
+  } finally {
+    Services.io.offline = wasOffline;
+  }
+});
+
+add_task({ skip_if: () => AppConstants.platform !== "android" }, async function test_delete_and_passive_missing_cache() {
+  const { AndroidTranslationAssets } = ChromeUtils.importESModule(
+    "resource://gre/modules/translations/AndroidTranslationAssets.sys.mjs"
+  );
+  const assets = AndroidTranslationAssets.instance;
+  Assert.equal((await assets.deleteAll()).length, 377);
+  const [model] = await assets.client("models").get();
+  Assert.ok(!(await assets.client("models").attachments.isDownloaded(model)));
+  await Assert.rejects(assets.client("models").attachments.download(model), /./);
+  const controller = new AbortController();
+  controller.abort();
+  await Assert.rejects(assets.withDownloadOperation(
+    operation => assets.downloadRecords([model], operation), controller.signal
+  ), /cancelled/);
+  Assert.ok(!(await assets.client("models").attachments.isDownloaded(model)));
+});
