+import androidx.preference.PreferenceFragmentCompat
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import mozilla.components.feature.syncedtabs.commands.SyncedTabsCommandsFlushScheduler
+import mozilla.components.service.fxa.AccountServices
+import mozilla.components.service.fxa.sync.cancelAccountSyncWork
+import org.mozilla.fenix.HomeActivity
+import org.mozilla.fenix.R
+import java.util.concurrent.TimeUnit
+
+/** Actual Android account-service control. A Gecko pref cannot gate Fenix services. */
+object AccountServicesPreference {
+    const val KEY = "account_services_restart"
+    const val OPEN_SETTINGS = "org.mozilla.fenix.OPEN_ACCOUNT_SERVICES_SETTINGS"
+    private const val CANCEL_TIMEOUT_SECONDS = 10L
+
+    fun addTo(fragment: PreferenceFragmentCompat) {
+        val enabled = AccountServices.isEnabled
+        val preference = Preference(fragment.requireContext()).apply {
+            key = KEY
+            order = -1
+            isPersistent = false
+            title = context.getString(R.string.account_services_title)
+            summary = context.getString(
+                if (enabled) R.string.account_services_enabled else R.string.account_services_disabled,
+            )
+            setOnPreferenceClickListener {
+                showChangeDialog(fragment, !enabled)
+                true
+            }
+        }
+        fragment.preferenceScreen.addPreference(preference)
+    }
+
+    fun disabledView(fragment: Fragment): View = LinearLayout(fragment.requireContext()).apply {
+        orientation = LinearLayout.VERTICAL
+        val padding = (24 * resources.displayMetrics.density).toInt()
+        setPadding(padding, padding, padding, padding)
+        addView(TextView(context).apply { setText(R.string.account_services_disabled) })
+        addView(Button(context).apply {
+            setText(R.string.account_services_enable_restart)
+            setOnClickListener { showChangeDialog(fragment, true) }
+        })
+    }
+
+    fun showChangeDialog(fragment: Fragment, enabled: Boolean) {
+        val action = if (enabled) R.string.account_services_enable_restart else R.string.account_services_disable_restart
+        MaterialAlertDialogBuilder(fragment.requireContext())
+            .setTitle(action)
+            .setMessage(if (enabled) R.string.account_services_enable_explanation else R.string.account_services_disable_explanation)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(action) { _, _ ->
+                val context = fragment.context?.applicationContext ?: return@setPositiveButton
+                val restart = restartIntent(context)
+                if (restart == null) {
+                    showError(context)
+                    return@setPositiveButton
+                }
+                fragment.lifecycleScope.launch {
+                    // Once committed, rotation/navigation must not strand a half-applied choice.
+                    withContext(NonCancellable) {
+                        val applied = applyAccountServicesChange(
+                            commit = { withContext(Dispatchers.IO) { AccountServices.commitChoiceForRestart(context, enabled) } },
+                            cancel = {
+                                withContext(Dispatchers.IO) {
+                                    // Each cancellation is submitted before waiting for either receipt.
+                                    val sync = cancelAccountSyncWork(context)
+                                    val commands = SyncedTabsCommandsFlushScheduler.cancelPendingWork(context)
+                                    sync.result.get(CANCEL_TIMEOUT_SECONDS, TimeUnit.SECONDS)
+                                    commands.result.get(CANCEL_TIMEOUT_SECONDS, TimeUnit.SECONDS)
+                                }
+                            },
+                            restart = {
+                                // Same process-restart pattern as Firefox Labs, with a checked
+                                // in-package launcher component and no forwarded auth URL/extras.
+                                try {
+                                    context.startActivity(restart)
+                                } finally {
+                                    Process.killProcess(Process.myPid())
+                                }
+                            },
+                        )
+                        if (!applied) showError(context)
+                    }
+                }
+            }
+            .show()
+    }
+
+    internal fun restartIntent(context: Context): Intent? {
+        val component = context.packageManager.getLaunchIntentForPackage(context.packageName)?.component ?: return null
+        if (component.packageName != context.packageName) return null
+        return Intent.makeRestartActivityTask(component).putExtra(OPEN_SETTINGS, true)
+    }
+
+    /** Drop the callback URL entirely; an external link may open this control but never change it. */
+    fun openSettings(context: Context) {
+        context.startActivity(
+            Intent(context, HomeActivity::class.java)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP)
+                .putExtra(OPEN_SETTINGS, true),
+        )
+    }
+
+    private fun showError(context: Context) {
+        Toast.makeText(context, R.string.account_services_change_failed, Toast.LENGTH_LONG).show()
+    }
+}
+
+/** A failed commit keeps the running policy. Cancellation failure must still reach restart. */
+internal suspend fun applyAccountServicesChange(
+    commit: suspend () -> Boolean,
+    cancel: suspend () -> Unit,
+    restart: suspend () -> Unit,
+): Boolean {
+    val committed = try {
+        commit()
+    } catch (_: Exception) {
+        false
+    }
+    if (!committed) return false
+    try {
+        cancel()
+    } finally {
+        restart()
+    }
+    return true
+}
