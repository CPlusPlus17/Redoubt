--- /dev/null
+++ b/toolkit/mozapps/extensions/internal/AndroidAddonState.sys.mjs
@@ -0,0 +1,64 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Android may kill the process immediately after an embedder API completes.
+ * Keep one writer for the database and derived startup cache; a resolved save
+ * covers the mutations coalesced into its write cycle. There is no timer,
+ * shutdown-only flush, swallowed failure or overlapping use of a temp file.
+ *
+ * The supplied write callback persists the authoritative database first, then
+ * the derived cache. Startup reconciliation repairs a process death between
+ * those writes. This is not a transaction spanning the two files.
+ */
+export class AndroidAddonState {
+  #write;
+  #dirty = false;
+  #pending = null;
+  #operations = new Map();
+
+  constructor(write) {
+    this.#write = write;
+  }
+
+  save() {
+    this.#dirty = true;
+    if (!this.#pending) {
+      this.#pending = Promise.resolve().then(async () => {
+        try {
+          while (this.#dirty) {
+            this.#dirty = false;
+            try {
+              await this.#write();
+            } catch (error) {
+              // Retain unsaved work without spinning on a full or broken disk.
+              // The next explicit save retries; current callers all reject.
+              this.#dirty = true;
+              throw error;
+            }
+          }
+        } finally {
+          // Clear synchronously with the drain ending: a subsequent save must
+          // start a new drain, never attach to an already-finished one.
+          this.#pending = null;
+        }
+      });
+    }
+    return this.#pending;
+  }
+
+  /** Serialize acknowledged operations on one installed extension. */
+  run(id, operation) {
+    const previous = this.#operations.get(id) ?? Promise.resolve();
+    const result = previous.catch(() => {}).then(operation);
+    this.#operations.set(id, result);
+    const cleanup = () => {
+      if (this.#operations.get(id) === result) {
+        this.#operations.delete(id);
+      }
+    };
+    result.then(cleanup, cleanup);
+    return result;
+  }
+}
