diff --git a/toolkit/mozapps/extensions/test/xpcshell/test_android_addon_state.js b/toolkit/mozapps/extensions/test/xpcshell/test_android_addon_state.js
--- /dev/null
+++ b/toolkit/mozapps/extensions/test/xpcshell/test_android_addon_state.js
@@ -0,0 +1,187 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+// Read the actual files immediately after API completion. Do not call a test
+// flush helper, sleep, or gracefully shut down before these assertions.
+createAppInfo("xpcshell@tests.mozilla.org", "XPCShell", "1", "1.9.2");
+const STATE_ID = "durability@tests.mozilla.org";
+const CACHE_PATH = PathUtils.join(gProfD.path, "addonStartup.json.lz4");
+const DB_PATH = PathUtils.join(gProfD.path, "extensions.json");
+
+async function installStateAddon(version = "1.0") {
+  return promiseInstallWebExtension({
+    manifest: {
+      version,
+      browser_specific_settings: { gecko: { id: STATE_ID } },
+    },
+  });
+}
+
+async function diskState() {
+  const db = await IOUtils.readJSON(DB_PATH);
+  const cache = await IOUtils.readJSON(CACHE_PATH, { decompress: true });
+  return {
+    addon: db.addons.find(addon => addon.id === STATE_ID),
+    state: cache["app-profile"]?.addons[STATE_ID],
+  };
+}
+
+async function assertEnabled(enabled) {
+  const disk = await diskState();
+  Assert.equal(disk.addon.userDisabled, !enabled, "Durable user choice");
+  Assert.equal(disk.addon.active, enabled, "Durable registry activity");
+  Assert.equal(disk.state.enabled, enabled, "Durable startup eligibility");
+}
+
+add_setup(async function () {
+  await promiseStartupManager();
+  registerCleanupFunction(promiseShutdownManager);
+});
+
+add_task(async function acknowledged_operations_are_persisted() {
+  let addon = await installStateAddon();
+  await assertEnabled(true);
+  await addon.disable();
+  await assertEnabled(false);
+  Assert.ok(!WebExtensionPolicy.getByID(STATE_ID)?.active);
+  await addon.enable();
+  await assertEnabled(true);
+  await Promise.all([addon.disable(), addon.enable(), addon.disable()]);
+  await assertEnabled(false);
+
+  // A verified replacement must inherit the current disabled choice.
+  addon = await installStateAddon("2.0");
+  Assert.equal(addon.version, "2.0");
+  await assertEnabled(false);
+  Assert.equal((await diskState()).state.version, "2.0");
+  await addon.uninstall();
+  const disk = await diskState();
+  Assert.equal(disk.addon, undefined);
+  Assert.equal(disk.state, undefined);
+  Assert.ok(!WebExtensionPolicy.getByID(STATE_ID)?.active);
+});
+
+add_task(async function failed_writes_reject_and_same_choice_can_retry() {
+  const { sinon } = ChromeUtils.importESModule(
+    "resource://testing-common/Sinon.sys.mjs"
+  );
+  const addon = await installStateAddon();
+  const sandbox = sinon.createSandbox();
+  const original = IOUtils.writeJSON.bind(IOUtils);
+  try {
+    sandbox.stub(IOUtils, "writeJSON").callsFake((path, ...args) => {
+      if (path === CACHE_PATH) {
+        return Promise.reject(new Error("injected cache write failure"));
+      }
+      return original(path, ...args);
+    });
+    await Assert.rejects(addon.disable(), /injected cache write failure/);
+  } finally {
+    sandbox.restore();
+  }
+  await addon.disable();
+  await assertEnabled(false);
+  await addon.uninstall();
+});
+
+add_task(async function existing_profiles_reconcile_both_cache_mismatches() {
+  for (const enabled of [false, true]) {
+    let addon = await installStateAddon();
+    if (!enabled) {
+      await addon.disable();
+    }
+    await assertEnabled(enabled);
+    await promiseShutdownManager();
+    const cache = await IOUtils.readJSON(CACHE_PATH, { decompress: true });
+    cache["app-profile"].addons[STATE_ID].enabled = !enabled;
+    await IOUtils.writeJSON(CACHE_PATH, cache, { compress: true });
+    Services.prefs.setBoolPref("extensions.pendingOperations", false);
+
+    const starts = [];
+    const listener = (method, event) => {
+      // EventEmitter passes the event name before its payload.
+      const data = event ?? method;
+      if (data.method === "startup" && data.params.id === STATE_ID) {
+        starts.push(data);
+      }
+    };
+    AddonTestUtils.on("bootstrap-method", listener);
+    try {
+      await promiseStartupManager();
+    } finally {
+      AddonTestUtils.off("bootstrap-method", listener);
+    }
+    addon = await promiseAddonByID(STATE_ID);
+    Assert.equal(addon.isActive, enabled);
+    Assert.equal(starts.length > 0, enabled, "No stale enabled background ran");
+    await assertEnabled(enabled);
+    await addon.uninstall();
+  }
+});
+
+add_task(async function known_first_install_missing_from_cache_is_recovered() {
+  await installStateAddon();
+  await promiseShutdownManager();
+  const cache = await IOUtils.readJSON(CACHE_PATH, { decompress: true });
+  delete cache["app-profile"].addons[STATE_ID];
+  await IOUtils.writeJSON(CACHE_PATH, cache, { compress: true });
+  Services.prefs.setBoolPref("extensions.pendingOperations", false);
+  Services.prefs.setIntPref("extensions.startupScanScopes", 0);
+  await promiseStartupManager();
+  const addon = await promiseAddonByID(STATE_ID);
+  Assert.ok(addon, "An installed database identity survives an older cache");
+  await assertEnabled(true);
+  await addon.uninstall();
+});
+
+add_task(async function removed_file_with_old_database_and_cache_stays_removed() {
+  await installStateAddon();
+  const internal = await AddonTestUtils.getXPIExports().XPIDatabase.getAddonByID(
+    STATE_ID
+  );
+  const addonPath = internal._sourceBundle.path;
+  await promiseShutdownManager();
+  await IOUtils.remove(addonPath);
+  Services.prefs.setBoolPref("extensions.pendingOperations", false);
+  Services.prefs.setIntPref("extensions.startupScanScopes", 0);
+  await promiseStartupManager();
+  Assert.equal(await promiseAddonByID(STATE_ID), null);
+  Assert.ok(!WebExtensionPolicy.getByID(STATE_ID)?.active);
+  const disk = await diskState();
+  Assert.equal(disk.addon, undefined);
+  Assert.equal(disk.state, undefined);
+});
+
+add_task(async function missing_or_corrupt_database_preserves_cached_disable() {
+  for (const failure of ["missing", "syntax", "malformed"]) {
+    let addon = await installStateAddon();
+    await addon.disable();
+    await assertEnabled(false);
+    await promiseShutdownManager();
+    if (failure === "missing") {
+      await IOUtils.remove(DB_PATH);
+    } else {
+      await IOUtils.writeUTF8(DB_PATH, failure === "syntax" ? "{" : "{}");
+    }
+    Services.prefs.setBoolPref("extensions.pendingOperations", false);
+    const starts = [];
+    const listener = (event, data) => {
+      if (data.method === "startup" && data.params.id === STATE_ID) {
+        starts.push(data);
+      }
+    };
+    AddonTestUtils.on("bootstrap-method", listener);
+    try {
+      await promiseStartupManager();
+    } finally {
+      AddonTestUtils.off("bootstrap-method", listener);
+    }
+    addon = await promiseAddonByID(STATE_ID);
+    Assert.ok(addon, `${failure}: installed extension was recovered`);
+    Assert.ok(addon.userDisabled, `${failure}: recovered disabled choice`);
+    Assert.ok(!addon.isActive, `${failure}: no active registry entry`);
+    Assert.equal(starts.length, 0, `${failure}: no disabled background started`);
+    await assertEnabled(false);
+    await addon.uninstall();
+  }
+});
