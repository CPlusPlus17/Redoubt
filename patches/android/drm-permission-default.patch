+                        )
+                    }
                 setOnClickListener {
                     saveActionInSettings(SitePermissionsRules.Action.ASK_TO_ALLOW)
                 }
@@ -128,7 +133,15 @@ class SitePermissionsManagePhoneFeatureFragment : Fragment(), SystemInsetsPadded
                 }
                 restoreState(AUTOPLAY_ALLOW_ON_WIFI)
             } else {
-                text = getString(R.string.preference_option_phone_feature_blocked)
+                text =
+                    if (args.phoneFeature == PhoneFeature.MEDIA_KEY_SYSTEM_ACCESS) {
+                        getCombinedLabel(
+                            getString(R.string.preference_option_phone_feature_blocked),
+                            getString(R.string.phone_feature_recommended),
+                        )
+                    } else {
+                        getString(R.string.preference_option_phone_feature_blocked)
+                    }
                 setOnClickListener {
                     saveActionInSettings(BLOCKED)
                 }
