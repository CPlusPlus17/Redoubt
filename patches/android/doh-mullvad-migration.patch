diff --git a/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/lw/DohProviderMigrationTest.kt b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/lw/DohProviderMigrationTest.kt
new file mode 100644
--- /dev/null
+++ b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/lw/DohProviderMigrationTest.kt
@@ -0,0 +1,182 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.lw
+
+import android.app.Activity
+import android.app.AlertDialog
+import android.content.SharedPreferences
+import android.os.Looper
+import androidx.core.content.edit
+import mozilla.components.concept.engine.Engine
+import mozilla.components.support.test.robolectric.testContext
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mozilla.fenix.R
+import org.mozilla.fenix.ext.getPreferenceKey
+import org.mozilla.fenix.utils.Settings
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+
+@RunWith(RobolectricTestRunner::class)
+class DohProviderMigrationTest {
+    private lateinit var settings: Settings
+
+    @Before
+    fun setUp() {
+        settings = Settings(testContext)
+    }
+
+    @Test
+    fun `Mullvad DoH endpoints are recognised`() {
+        for (url in listOf(
+            "https://dns.mullvad.net/dns-query",
+            "https://base.dns.mullvad.net/dns-query",
+            "https://adblock.dns.mullvad.net/dns-query",
+            "https://all.dns.mullvad.net/dns-query",
+            "https://DNS.Mullvad.NET/dns-query",
+            "https://dns.mullvad.net./dns-query",
+            " https://family.dns.mullvad.net/dns-query ",
+            "https://doh.mullvad.net/dns-query",
+        )) {
+            assertTrue(url, DohProviderMigration.isMullvadProvider(url))
+        }
+    }
+
+    @Test
+    fun `other providers are not recognised`() {
+        for (url in listOf(
+            "",
+            "not a uri",
+            "https://dns10.quad9.net/dns-query",
+            "https://mullvad.net/dns-query",
+            "https://notdns.mullvad.net/dns-query",
+            "https://dns.mullvad.net.example.com/dns-query",
+            "https://example.com/dns.mullvad.net",
+        )) {
+            assertFalse(url, DohProviderMigration.isMullvadProvider(url))
+        }
+    }
+
+    @Test
+    fun `a Mullvad provider in use is replaced, the mode is kept and the notice is queued`() {
+        for (mode in listOf(Engine.DohSettingsMode.INCREASED, Engine.DohSettingsMode.MAX)) {
+            settings.preferences.edit(commit = true) { clear() }
+            settings.setDohSettingsMode(mode)
+            settings.dohProviderUrl = "https://base.dns.mullvad.net/dns-query"
+
+            assertTrue(DohProviderMigration.migrate(testContext, settings))
+
+            assertEquals(Settings.LIBREWOLF_DOH_PROVIDER_URI, settings.dohProviderUrl)
+            assertEquals(mode, settings.getDohSettingsMode())
+            assertTrue(DohProviderMigration.isNoticePending(settings))
+            assertTrue(settings.preferences.getBoolean(DohProviderMigration.KEY_DONE, false))
+        }
+    }
+
+    @Test
+    fun `a stored but inactive Mullvad provider is replaced without a notice`() {
+        for (mode in listOf(Engine.DohSettingsMode.OFF, Engine.DohSettingsMode.DEFAULT)) {
+            settings.preferences.edit(commit = true) { clear() }
+            settings.setDohSettingsMode(mode)
+            settings.dohProviderUrl = "https://dns.mullvad.net/dns-query"
+
+            assertTrue(DohProviderMigration.migrate(testContext, settings))
+
+            assertEquals(Settings.LIBREWOLF_DOH_PROVIDER_URI, settings.dohProviderUrl)
+            assertEquals(mode, settings.getDohSettingsMode())
+            assertFalse(DohProviderMigration.isNoticePending(settings))
+        }
+    }
+
+    @Test
+    fun `other providers are left alone`() {
+        settings.setDohSettingsMode(Engine.DohSettingsMode.MAX)
+        settings.dohProviderUrl = "https://custom.example/dns-query"
+
+        assertFalse(DohProviderMigration.migrate(testContext, settings))
+
+        assertEquals("https://custom.example/dns-query", settings.dohProviderUrl)
+        assertEquals(Engine.DohSettingsMode.MAX, settings.getDohSettingsMode())
+        assertFalse(DohProviderMigration.isNoticePending(settings))
+    }
+
+    @Test
+    fun `the migration runs once, so a later explicit choice is respected`() {
+        settings.setDohSettingsMode(Engine.DohSettingsMode.INCREASED)
+        assertFalse(DohProviderMigration.migrate(testContext, settings))
+
+        settings.dohProviderUrl = "https://dns.mullvad.net/dns-query"
+        assertFalse(DohProviderMigration.migrate(testContext, settings))
+
+        assertEquals("https://dns.mullvad.net/dns-query", settings.dohProviderUrl)
+        assertFalse(DohProviderMigration.isNoticePending(settings))
+    }
+
+    @Test
+    fun `the provider is written under the key Settings reads, in the edit that sets the flags`() {
+        val key = testContext.getPreferenceKey(R.string.pref_key_doh_provider_uri)
+        settings.setDohSettingsMode(Engine.DohSettingsMode.MAX)
+        settings.dohProviderUrl = "https://dns.mullvad.net/dns-query"
+        val seen = mutableListOf<Pair<String?, Boolean>>()
+        val listener = SharedPreferences.OnSharedPreferenceChangeListener { prefs, changed ->
+            seen += changed to prefs.getBoolean(DohProviderMigration.KEY_DONE, false)
+        }
+        settings.preferences.registerOnSharedPreferenceChangeListener(listener)
+
+        assertTrue(DohProviderMigration.migrate(testContext, settings))
+        settings.preferences.unregisterOnSharedPreferenceChangeListener(listener)
+
+        assertEquals(Settings.LIBREWOLF_DOH_PROVIDER_URI, settings.preferences.getString(key, null))
+        // One commit: when the provider change is announced, the done flag is
+        // already visible.
+        assertTrue(seen.toString(), seen.contains(key to true))
+    }
+
+    @Test
+    fun `the notice is shown once per activity and only cleared by the user`() {
+        settings.preferences.edit(commit = true) { putBoolean(DohProviderMigration.KEY_NOTICE_PENDING, true) }
+        val activity = Robolectric.buildActivity(Activity::class.java).setup().get()
+
+        val dialog = DohProviderMigration.maybeShowNotice(activity, settings)
+        assertNotNull(dialog)
+        assertTrue(dialog!!.isShowing)
+        // onResume again (e.g. back from Settings) while the dialog is up.
+        assertNull(DohProviderMigration.maybeShowNotice(activity, settings))
+        assertTrue(DohProviderMigration.isNoticePending(settings))
+
+        (dialog as AlertDialog).getButton(AlertDialog.BUTTON_POSITIVE).performClick()
+        shadowOf(Looper.getMainLooper()).idle()
+
+        assertFalse(DohProviderMigration.isNoticePending(settings))
+        assertNull(DohProviderMigration.maybeShowNotice(activity, settings))
+    }
+
+    @Test
+    fun `a recreated activity shows the notice again`() {
+        settings.preferences.edit(commit = true) { putBoolean(DohProviderMigration.KEY_NOTICE_PENDING, true) }
+        val first = Robolectric.buildActivity(Activity::class.java).setup()
+
+        assertNotNull(DohProviderMigration.maybeShowNotice(first.get(), settings))
+        // Rotation or a theme change: the activity goes away under the dialog
+        // and none of the dialog's listeners run.
+        first.pause().stop().destroy()
+        val second = Robolectric.buildActivity(Activity::class.java).setup().get()
+
+        assertTrue(DohProviderMigration.isNoticePending(settings))
+        val dialog = DohProviderMigration.maybeShowNotice(second, settings)
+        assertNotNull(dialog)
+
+        dialog!!.cancel()
+        shadowOf(Looper.getMainLooper()).idle()
+        assertFalse(DohProviderMigration.isNoticePending(settings))
+    }
+}
