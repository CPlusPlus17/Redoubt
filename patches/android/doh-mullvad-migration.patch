@@ -0,0 +1,112 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.lw
+
+import androidx.core.content.edit
+import mozilla.components.concept.engine.Engine
+import mozilla.components.support.test.robolectric.testContext
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mozilla.fenix.utils.Settings
+import org.robolectric.RobolectricTestRunner
+
+@RunWith(RobolectricTestRunner::class)
+class DohProviderMigrationTest {
+    private lateinit var settings: Settings
+
+    @Before
+    fun setUp() {
+        settings = Settings(testContext)
+    }
+
+    @Test
+    fun `Mullvad DoH endpoints are recognised`() {
+        for (url in listOf(
+            "https://dns.mullvad.net/dns-query",
+            "https://base.dns.mullvad.net/dns-query",
+            "https://adblock.dns.mullvad.net/dns-query",
+            "https://all.dns.mullvad.net/dns-query",
+            "https://DNS.Mullvad.NET/dns-query",
+            "https://dns.mullvad.net./dns-query",
+            " https://family.dns.mullvad.net/dns-query ",
+            "https://doh.mullvad.net/dns-query",
+        )) {
+            assertTrue(url, DohProviderMigration.isMullvadProvider(url))
+        }
+    }
+
+    @Test
+    fun `other providers are not recognised`() {
+        for (url in listOf(
+            "",
+            "not a uri",
+            "https://dns10.quad9.net/dns-query",
+            "https://mullvad.net/dns-query",
+            "https://notdns.mullvad.net/dns-query",
+            "https://dns.mullvad.net.example.com/dns-query",
+            "https://example.com/dns.mullvad.net",
+        )) {
+            assertFalse(url, DohProviderMigration.isMullvadProvider(url))
+        }
+    }
+
+    @Test
+    fun `a Mullvad provider in use is replaced, the mode is kept and the notice is queued`() {
+        for (mode in listOf(Engine.DohSettingsMode.INCREASED, Engine.DohSettingsMode.MAX)) {
+            settings.preferences.edit(commit = true) { clear() }
+            settings.setDohSettingsMode(mode)
+            settings.dohProviderUrl = "https://base.dns.mullvad.net/dns-query"
+
+            assertTrue(DohProviderMigration.migrate(settings))
+
+            assertEquals(Settings.LIBREWOLF_DOH_PROVIDER_URI, settings.dohProviderUrl)
+            assertEquals(mode, settings.getDohSettingsMode())
+            assertTrue(DohProviderMigration.isNoticePending(settings))
+        }
+    }
+
+    @Test
+    fun `a stored but inactive Mullvad provider is replaced without a notice`() {
+        for (mode in listOf(Engine.DohSettingsMode.OFF, Engine.DohSettingsMode.DEFAULT)) {
+            settings.preferences.edit(commit = true) { clear() }
+            settings.setDohSettingsMode(mode)
+            settings.dohProviderUrl = "https://dns.mullvad.net/dns-query"
+
+            assertTrue(DohProviderMigration.migrate(settings))
+
+            assertEquals(Settings.LIBREWOLF_DOH_PROVIDER_URI, settings.dohProviderUrl)
+            assertEquals(mode, settings.getDohSettingsMode())
+            assertFalse(DohProviderMigration.isNoticePending(settings))
+        }
+    }
+
+    @Test
+    fun `other providers are left alone`() {
+        settings.setDohSettingsMode(Engine.DohSettingsMode.MAX)
+        settings.dohProviderUrl = "https://custom.example/dns-query"
+
+        assertFalse(DohProviderMigration.migrate(settings))
+
+        assertEquals("https://custom.example/dns-query", settings.dohProviderUrl)
+        assertEquals(Engine.DohSettingsMode.MAX, settings.getDohSettingsMode())
+        assertFalse(DohProviderMigration.isNoticePending(settings))
+    }
+
+    @Test
+    fun `the migration runs once, so a later explicit choice is respected`() {
+        settings.setDohSettingsMode(Engine.DohSettingsMode.INCREASED)
+        assertFalse(DohProviderMigration.migrate(settings))
+
+        settings.dohProviderUrl = "https://dns.mullvad.net/dns-query"
+        assertFalse(DohProviderMigration.migrate(settings))
+
+        assertEquals("https://dns.mullvad.net/dns-query", settings.dohProviderUrl)
+        assertFalse(DohProviderMigration.isNoticePending(settings))
+    }
+}
