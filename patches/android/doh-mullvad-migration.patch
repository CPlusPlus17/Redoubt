+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/lw/DohProviderMigration.kt
@@ -0,0 +1,120 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Redoubt: one-time move off Mullvad's discontinued DNS over HTTPS service.
+//
+// The 153 ESR beta listed "Mullvad (No Filtering)" in the DoH provider picker.
+// Mullvad is shutting that service down; a profile still pointing at it loses
+// DoH in Increased Protection and all name resolution in Max Protection. Before
+// the engine reads the stored provider (Core.engine), a Mullvad URI is replaced
+// with Settings.LIBREWOLF_DOH_PROVIDER_URI, the Android default, and the mode is
+// kept. The check runs once per profile, so a Mullvad URI the user enters
+// afterwards as a custom provider is left alone. When DoH was actually in use,
+// HomeActivity shows a one-time dialog naming the new provider.
+//
+// The state lives in fenix_preferences next to the provider it describes: the
+// provider write and the done flag go through the same SharedPreferences, so
+// they reach disk together or not at all.
+
+package org.mozilla.fenix.lw
+
+import android.app.Activity
+import android.app.AlertDialog
+import androidx.annotation.VisibleForTesting
+import androidx.core.content.edit
+import mozilla.components.concept.engine.Engine
+import mozilla.components.support.base.log.logger.Logger
+import org.mozilla.fenix.R
+import org.mozilla.fenix.ext.components
+import org.mozilla.fenix.utils.Settings
+import java.net.URI
+import java.net.URISyntaxException
+
+/**
+ * Replaces a stored Mullvad DoH provider once, and shows the notice for it.
+ */
+object DohProviderMigration {
+    @VisibleForTesting
+    internal const val KEY_DONE = "lw_doh_mullvad_migration_done"
+
+    @VisibleForTesting
+    internal const val KEY_NOTICE_PENDING = "lw_doh_mullvad_migration_notice_pending"
+
+    // dns.mullvad.net and its filtering variants (base., adblock., extended.,
+    // family., all.dns.mullvad.net), plus doh.mullvad.net, the service's
+    // earlier name.
+    private const val MULLVAD_DOH_DOMAIN = "dns.mullvad.net"
+    private const val MULLVAD_LEGACY_DOH_HOST = "doh.mullvad.net"
+
+    private val logger = Logger("DohProviderMigration")
+
+    private var noticeShowing = false
+
+    /** True when [url] points at a Mullvad DoH endpoint. */
+    @VisibleForTesting
+    internal fun isMullvadProvider(url: String): Boolean {
+        val host = try {
+            URI(url.trim()).host
+        } catch (e: URISyntaxException) {
+            null
+        } ?: return false
+        val name = host.lowercase().trimEnd('.')
+        return name == MULLVAD_DOH_DOMAIN ||
+            name.endsWith(".$MULLVAD_DOH_DOMAIN") ||
+            name == MULLVAD_LEGACY_DOH_HOST
+    }
+
+    /**
+     * Runs once per profile, before the engine is created. Returns true when the
+     * stored provider was replaced.
+     */
+    fun migrate(settings: Settings): Boolean {
+        val prefs = settings.preferences
+        if (prefs.getBoolean(KEY_DONE, false)) {
+            return false
+        }
+        val previous = settings.dohProviderUrl
+        val replace = isMullvadProvider(previous)
+        val mode = settings.getDohSettingsMode()
+        if (replace) {
+            settings.dohProviderUrl = Settings.LIBREWOLF_DOH_PROVIDER_URI
+            logger.info("Replaced discontinued Mullvad DoH provider; mode $mode kept")
+        }
+        val inUse = mode == Engine.DohSettingsMode.INCREASED || mode == Engine.DohSettingsMode.MAX
+        prefs.edit {
+            putBoolean(KEY_DONE, true)
+            if (replace && inUse) {
+                putBoolean(KEY_NOTICE_PENDING, true)
+            }
+        }
+        return replace
+    }
+
+    @VisibleForTesting
+    internal fun isNoticePending(settings: Settings): Boolean =
+        settings.preferences.getBoolean(KEY_NOTICE_PENDING, false)
+
+    /**
+     * Called from HomeActivity.onResume. Shows the notice until the user
+     * dismisses it; an activity torn down underneath it shows it again on the
+     * next start.
+     */
+    fun maybeShowNotice(activity: Activity) {
+        val settings = activity.components.settings
+        if (noticeShowing || activity.isFinishing || !isNoticePending(settings)) {
+            return
+        }
+        val host = URI(Settings.LIBREWOLF_DOH_PROVIDER_URI).host ?: Settings.LIBREWOLF_DOH_PROVIDER_URI
+        noticeShowing = true
+        AlertDialog.Builder(activity)
+            .setTitle(R.string.lw_doh_mullvad_migrated_title)
+            .setMessage(activity.getString(R.string.lw_doh_mullvad_migrated_message, host))
+            .setPositiveButton(android.R.string.ok, null)
+            .setOnDismissListener {
+                noticeShowing = false
+                settings.preferences.edit { putBoolean(KEY_NOTICE_PENDING, false) }
+            }
+            .show()
+    }
+}
