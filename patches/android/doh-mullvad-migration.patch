+<?xml version="1.0" encoding="utf-8"?>
+<!-- Redoubt: the one-time notice after a Mullvad DNS over HTTPS provider is
+     replaced (org.mozilla.fenix.lw.DohProviderMigration). Kept out of
+     strings.xml on purpose: that file is synced from android-l10n on every
+     rebase and would drop these. -->
+<resources>
+    <string name="lw_doh_mullvad_migrated_title">DNS over HTTPS provider changed</string>
+    <string name="lw_doh_mullvad_migrated_message">Mullvad has discontinued its DNS over HTTPS service. Redoubt now uses %1$s instead, with your protection level unchanged. You can choose another provider in Settings under DNS over HTTPS.</string>
+</resources>
