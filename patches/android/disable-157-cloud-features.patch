index 0000000..972a1b3
--- /dev/null
+++ b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/LibreWolfCloudFeaturesTest.kt
@@ -0,0 +1,102 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import mozilla.components.lib.shake.ShakeSensitivity
+import mozilla.components.service.merino.manifest.ManifestEntry
+import mozilla.components.support.test.robolectric.testContext
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mozilla.fenix.home.topsites.store.toPopularSite
+import org.mozilla.fenix.ipprotection.store.DefaultIPProtectionPromptRepository
+import org.mozilla.fenix.summarization.SummarizationSettingsBinding
+import org.mozilla.fenix.summarization.onboarding.FenixSummarizationFeatureConfiguration
+import org.mozilla.fenix.summarization.onboarding.SummarizeDiscoveryEvent
+import org.mozilla.fenix.utils.Settings
+import org.robolectric.RobolectricTestRunner
+
+/**
+ * LibreWolf (disable-157-cloud-features.patch): Shake to Summarize, Google Lens, Merino shortcut icons and
+ * IP Protection are off whatever a caller, a stale preference or the feature's own settings say.
+ */
+@RunWith(RobolectricTestRunner::class)
+class LibreWolfCloudFeaturesTest {
+    private lateinit var settings: Settings
+
+    private class EnabledSummarizationSettingsBinding : SummarizationSettingsBinding {
+        override val isFeatureEnabled: StateFlow<Boolean> = MutableStateFlow(true)
+        override val isGestureEnabled: StateFlow<Boolean> = MutableStateFlow(true)
+        override val shakeSensitivity: StateFlow<ShakeSensitivity> = MutableStateFlow(ShakeSensitivity.Medium)
+    }
+
+    @Before
+    fun setUp() {
+        settings = Settings(testContext)
+    }
+
+    @Test
+    fun `the cloud feature flags read false and ignore writes`() {
+        settings.shakeToSummarizeFeatureFlagEnabled = true
+        settings.googleLensIntegrationEnabled = true
+        settings.enableAddShortcutsImprovement = true
+        settings.isIPProtectionEnabled = true
+
+        assertFalse(settings.shakeToSummarizeFeatureFlagEnabled)
+        assertFalse(settings.googleLensIntegrationEnabled)
+        assertFalse(settings.enableAddShortcutsImprovement)
+        assertFalse(settings.isIPProtectionAvailable)
+    }
+
+    @Test
+    fun `no summarize surface shows even when the feature is switched on in its own settings`() {
+        settings.shakeToSummarizeFeatureFlagEnabled = true
+        val configuration =
+            FenixSummarizationFeatureConfiguration(
+                settings = settings,
+                summarizationSettingsBinding = EnabledSummarizationSettingsBinding(),
+            )
+
+        assertFalse(configuration.isFeatureAvailable)
+        assertFalse(configuration.canShowFeature)
+        assertFalse(configuration.showMenuItem)
+        assertFalse(configuration.shouldHighlightMenuItem)
+        assertFalse(configuration.shouldHighlightOverflowMenuItem)
+        assertFalse(configuration.shouldToolbarShowCfr)
+        assertFalse(configuration.shouldHighlightToolbarMenuButton)
+
+        configuration.cacheDiscoveryEvent(SummarizeDiscoveryEvent.CfrExposure)
+        assertFalse(settings.shakeToSummarizeToolbarCfrShown)
+    }
+
+    @Test
+    fun `the IP Protection onboarding prompt never shows`() {
+        settings.isIPProtectionEnabled = true
+        settings.onboardingCompletedTimestamp = 0L
+        val repository = DefaultIPProtectionPromptRepository(settings)
+
+        assertFalse(repository.canShowIPProtectionPrompt(System.currentTimeMillis()))
+    }
+
+    @Test
+    fun `a popular site never carries a Merino image CDN icon`() {
+        val entry =
+            ManifestEntry(
+                rank = 1,
+                domain = "example",
+                categories = emptyList(),
+                serpCategories = emptyList(),
+                url = "https://example.com",
+                title = "example",
+                icon = "https://prod-images.merino.prod.webservices.mozgcp.net/favicons/example.png",
+            )
+
+        assertNull(entry.toPopularSite().iconUrl)
+    }
+}
