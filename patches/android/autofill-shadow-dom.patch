+  _isInOpenShadowTree(aElement) {
+    let root = aElement.getRootNode();
+    if (!ShadowRoot.isInstance(root)) {
+      return false;
+    }
+    while (ShadowRoot.isInstance(root)) {
+      if (root.mode !== "open") {
+        return false;
+      }
+      root = root.host.getRootNode();
+    }
+    return true;
+  }
