+  /**
+   * Redoubt: the <input>, <select> and <textarea> elements under aRoot in
+   * tree order, descending into open shadow roots (Element.shadowRoot is null
+   * for closed and UA-widget roots). Elements owned by a form other than
+   * aForm are left out, as createFromDocumentRoot does.
+   */
+  _shadowInclusiveElements(aRoot, aForm) {
+    const elements = [];
+    const visit = node => {
+      for (const el of node.querySelectorAll("*")) {
+        if (
