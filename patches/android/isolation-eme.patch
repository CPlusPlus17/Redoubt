 namespace mozilla {
 
 StaticAutoPtr<MediaDrmRemoteCDMParent::DrmCallbackMap>
     MediaDrmRemoteCDMParent::sCbMap;
 
+// Redoubt (LW-M7-39): on Android 12 and 13 the NDK drops every MediaDrm event
+// whose data is empty (frameworks/av media/ndk/NdkMediaDrm.cpp,
+// DrmListener::sendEvent: "if (dataSize > 0)", logcat "E NdkMediaDrm: invalid
+// event data size=0"; Android 14 changed it to ">= 0"). Java's MediaDrm
+// listener, which the non-isolated path uses, has no such check.
+static bool RedoubtNdkDropsEmptyDrmEvents() {
+  if (__builtin_available(android 34, *)) {
+    return false;
+  }
+  if (__builtin_available(android 31, *)) {
+    return true;
+  }
+  return false;
+}
+
+// Redoubt (LW-M7-39): a Widevine service certificate response is a
+// SignedMessage whose first field (1, varint) is type SERVICE_CERTIFICATE (5).
+static bool RedoubtIsWidevineServiceCertificate(
+    const nsTArray<uint8_t>& aResponse) {
+  return aResponse.Length() > 2 && aResponse[0] == 0x08 &&
+         aResponse[1] == 0x05;
+}
