+bool MediaDrmRemoteCDMParent::RedoubtSkipDuplicateKeyRequired(
+    const nsString& aSessionId) {
+  const auto i = mSessions.find(aSessionId);
+  if (i == mSessions.end() || !i->second.redoubtKeyRequestIssued) {
+    return false;
+  }
+  i->second.redoubtKeyRequestIssued = false;
+  printf_stderr(
+      "Redoubt isolation-eme: KEY_REQUIRED after the service certificate "
+      "arrived after all; the license was already requested, skipped\n");
+  return true;
+}
