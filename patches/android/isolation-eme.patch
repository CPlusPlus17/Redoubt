+  const double expiration =
+      aExpiryTimeInMS > 0 ? static_cast<double>(aExpiryTimeInMS)
+                          : std::numeric_limits<double>::quiet_NaN();
+  (void)SendOnSessionKeyExpiration(
+      RemoteCDMKeyExpirationIPDL(std::move(aSessionId), expiration));
