+  /**
+   * Wait for an active extension to register a live blocking response listener.
+   *
+   * <p>Unlike extension startup or a primed persistent listener, this waits for
+   * actual registration of a blocking onHeadersReceived listener by the running
+   * extension. It does not guarantee that arbitrary extension internals are ready.
+   * The embedding app must establish that relationship for its selected extension.
+   *
+   * <p>At app startup Gecko delays an installed extension's background until a
+   * browser window exists. An embedder holding its windows on this result would
+   * never see that happen, so this starts a delayed background itself.
+   *
+   * @param extensionId The ID of an already-installed and enabled extension.
+   * @param expectedVersion The version whose readiness the caller is awaiting.
+   * @return A result resolving on listener activation, or failing if the extension
+   *     is unavailable, changes, stops, or does not register within 30 seconds.
+   */
+  @HandlerThread
+  @NonNull
+  public GeckoResult<Void> awaitBlockingResponseListener(
+      final @NonNull String extensionId, final @NonNull String expectedVersion) {
+    ThreadUtils.assertOnHandlerThread();
+    final String requestId = UUID.randomUUID().toString();
+    final GeckoBundle bundle = new GeckoBundle(3);
+    bundle.putString("webExtensionId", extensionId);
+    bundle.putString("expectedVersion", expectedVersion);
+    bundle.putString("requestId", requestId);
+    final GeckoResult<Void> result =
+        EventDispatcher.getInstance()
+            .queryBundle("GeckoView:WebExtension:AwaitBlockingResponseListener", bundle)
+            .accept(response -> {});
+    result.setCancellationDelegate(
+        new GeckoResult.CancellationDelegate() {
+          @Override
+          public GeckoResult<Boolean> cancel() {
+            return EventDispatcher.getInstance()
+                .queryBundle("GeckoView:WebExtension:CancelBlockingResponseListener", bundle)
+                .map(response -> response.getBoolean("cancelled"));
+          }
+        });
+    return result;
+  }
