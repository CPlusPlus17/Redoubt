# branding.patch  (Android)
# Owner: LW-M4-07 ("Apply the Redoubt branding and applicationId")
#
# Changes the install identity from Mozilla's to Redoubt's, per IDENTITY.md
# (applicationId org.redoubtbrowser, decided and signed off 2026-08-23):
#   * applicationId  org.mozilla            -> org.redoubtbrowser
#   * debug suffix    .fenix.debug          -> .debug
#   * beta  suffix    .firefox_beta         -> .beta
#   * release suffix  .firefox              -> (none; release IS org.redoubtbrowser)
#   * nightly suffix  .fenix                -> .nightly
#   * benchmark suffix .fenix               -> .benchmark
#   * deepLinkScheme  fenix / fenix-beta / fenix-dev / fenix-nightly -> redoubt (single)
#   * sharedUserId  org.mozilla.firefox.sharedID (beta + release) -> removed
# The Kotlin `namespace` (org.mozilla.fenix) is NOT branding and is left
# unchanged; every ${applicationId} manifest placeholder (custom permission,
# all FileProvider authorities, launcher/theme aliases) propagates
# automatically from the applicationId change.
#
# Primary launcher icon: ic_launcher_background colour -> #1E293B (Deep Bastion
# Slate), and ic_launcher_foreground / ic_launcher_monochrome set to the Redoubt
# mark: the architectural plan view of a four-bastion square fort.
#
# Ordering: the hunk sits in defaultConfig + buildTypes (roughly lines 55-175
# of fenix/app/build.gradle), disjoint from no-adjust (:350+), no-glean (:512),
# no-gms (:32/:366+), no-crashreporter (:334+) and fenix-abi-split (splits
# block), so it is order-free with all of them; recorded in
# scripts/check-patch-order.py REVIEWED_ORDER_FREE. Touches no other patch's
# file.

--- a/mobile/android/fenix/app/build.gradle
+++ b/mobile/android/fenix/app/build.gradle
@@ -57,7 +57,7 @@
             arg("room.schemaLocation", "$projectDir/schemas".toString())
         }
 
-        applicationId "org.mozilla"
+        applicationId "org.redoubtbrowser"
         minSdk config.minSdkVersion
         targetSdk config.targetSdkVersion
         versionCode 1
@@ -77,7 +77,7 @@
         // This should be the base URL used to call the AMO API.
         buildConfigField "String", "AMO_SERVER_URL", "\"https://services.addons.mozilla.org\""
 
-        def deepLinkSchemeValue = "fenix-dev"
+        def deepLinkSchemeValue = "redoubt"
         buildConfigField "String", "DEEP_LINK_SCHEME", "\"$deepLinkSchemeValue\""
 
         manifestPlaceholders = [
@@ -118,14 +118,14 @@
         debug {
             shrinkResources = false
             minifyEnabled = false
-            applicationIdSuffix ".fenix.debug"
+            applicationIdSuffix ".debug"
             resValue "bool", "IS_DEBUG", "true"
             pseudoLocalesEnabled = true
         }
         nightly releaseTemplate >> {
-            applicationIdSuffix ".fenix"
+            applicationIdSuffix ".nightly"
             buildConfigField "boolean", "USE_RELEASE_VERSIONING", "true"
-            def deepLinkSchemeValue = "fenix-nightly"
+            def deepLinkSchemeValue = "redoubt"
             buildConfigField "String", "DEEP_LINK_SCHEME", "\"$deepLinkSchemeValue\""
             manifestPlaceholders.putAll([
                     "deepLinkScheme": deepLinkSchemeValue
@@ -133,35 +133,18 @@
         }
         beta releaseTemplate >> {
             buildConfigField "boolean", "USE_RELEASE_VERSIONING", "true"
-            applicationIdSuffix ".firefox_beta"
-            def deepLinkSchemeValue = "fenix-beta"
+            applicationIdSuffix ".beta"
+            def deepLinkSchemeValue = "redoubt"
             buildConfigField "String", "DEEP_LINK_SCHEME", "\"$deepLinkSchemeValue\""
             manifestPlaceholders.putAll([
-                    // This release type is meant to replace Firefox (Beta channel) and therefore needs to inherit
-                    // its sharedUserId for all eternity. See:
-                    // https://searchfox.org/mozilla-esr68/search?q=moz_android_shared_id&case=false&regexp=false&path=
-                    // Shipping an app update without sharedUserId can have
-                    // fatal consequences. For example see:
-                    //  - https://issuetracker.google.com/issues/36924841
-                    //  - https://issuetracker.google.com/issues/36905922
-                    "sharedUserId": "org.mozilla.firefox.sharedID",
                     "deepLinkScheme": deepLinkSchemeValue,
             ])
         }
         release releaseTemplate >> {
             buildConfigField "boolean", "USE_RELEASE_VERSIONING", "true"
-            applicationIdSuffix ".firefox"
-            def deepLinkSchemeValue = "fenix"
+            def deepLinkSchemeValue = "redoubt"
             buildConfigField "String", "DEEP_LINK_SCHEME", "\"$deepLinkSchemeValue\""
             manifestPlaceholders.putAll([
-                    // This release type is meant to replace Firefox (Release channel) and therefore needs to inherit
-                    // its sharedUserId for all eternity. See:
-                    // https://searchfox.org/mozilla-esr68/search?q=moz_android_shared_id&case=false&regexp=false&path=
-                    // Shipping an app update without sharedUserId can have
-                    // fatal consequences. For example see:
-                    //  - https://issuetracker.google.com/issues/36924841
-                    //  - https://issuetracker.google.com/issues/36905922
-                    "sharedUserId": "org.mozilla.firefox.sharedID",
                     "deepLinkScheme": deepLinkSchemeValue,
             ])
         }
@@ -169,7 +152,7 @@
             initWith buildTypes.nightly
             shrinkResources = false
             minifyEnabled = false
-            applicationIdSuffix ".fenix"
+            applicationIdSuffix ".benchmark"
             signingConfig = signingConfigs.debug
             debuggable false
             buildConfigField "boolean", "IS_BENCHMARK_BUILD", "true"
--- a/mobile/android/fenix/app/src/main/res/values/colors.xml
+++ b/mobile/android/fenix/app/src/main/res/values/colors.xml
