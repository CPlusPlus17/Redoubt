+// Redoubt backport note (LW-M7-50): upstream adds these lines to an existing
+// FFmpegAudioDecoder::ProcessFlush() that Firefox 158 does not have yet, so the
+// override is added here with only the drain reset.
+RefPtr<MediaDataDecoder::FlushPromise>
+FFmpegAudioDecoder<LIBAV_VER>::ProcessFlush() {
+  MOZ_ASSERT(mTaskQueue->IsOnCurrentThread());
+  if (mDrainFixEnabled) {
+    mHasSentDrainPacket = false;
+  }
+  return FFmpegDataDecoder::ProcessFlush();
+}
+#endif
