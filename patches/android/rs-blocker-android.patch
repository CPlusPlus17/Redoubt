# LibreWolf rs-blocker-android.patch  (Android)
# Owner: LW-M4-08 ("Apply the remote-settings blocker to the Android build")
#
# THE DEFECT
# ----------
# A first-run capture of an APK with all 13 Android patches applied still shows
# 3 Remote Settings hosts, 14 events, with real TLS:
#
#   firefox.settings.services.mozilla.com
#   firefox-settings-attachments.cdn.mozilla.net
#   content-signature-2.cdn.mozilla.net
#
# Desktop's fix (patches/rs-blocker.patch, in common.txt) touches only the
# JS/Gecko stack: services/settings/*.mjs + SearchEngineSelector.sys.mjs.
# Fenix's Remote Settings traffic goes through the RUST RemoteSettingsService
# in third_party/application-services/components/remote_settings/, which the
# desktop patch never reaches. librewolf.services.settings.allowedCollections
# (settings/common.cfg:698) is inert for the collections Fenix actually syncs.
#
# THE FIX
# -------
# Three hunks in the Rust crate, closing all network choke points:
#
#   1. service.rs  fetch_changes()  -> return empty Changes (no network)
#   2. client.rs   sync()           -> no-op (no network)
#   3. client.rs   make_request()   -> return error (block all remaining egress)
#
# The server stays Prod, so is_prod_server() remains true and the packaged
# data path (get_records Case 1, get_attachment step 2, reset_storage re-seed)
# keeps working. The seven packaged collections (regions, search-config-v2,
# search-config-icons, search-telemetry-v2, summarizer-models-config,
# translations-models, translations-wasm) and their attachments are served
# from the binary. search-config-overrides-v2 is NOT packaged, but Fenix
# passes applyEngineOverrides=false (SearchEngineSelectorRepository.kt:60-62),
# so no client is ever created for it and nothing reads it.
#
# What this does NOT do:
#   - Does NOT change the server URL (Custom would disable packaged dumps
#     via the is_prod_server() gate at client.rs:715-721 - strictly worse).
#   - Does NOT remove the RemoteSettingsService or its Kotlin wrappers -
#     the offline read path (get_records(false)) still works.
#   - Does NOT touch the JS/Gecko Remote Settings (already covered by
#     rs-blocker.patch in common.txt).
#
# SCOPE / ORDERING
# ----------------
# Touches two files in third_party/application-services/components/remote_settings/:
#   - src/service.rs
#   - src/client.rs
# No other patch in either list touches these files. No ordering constraint.
#
# 157 rebase (2026-10-02, Firefox 153.4.0esr -> 157.0)
# ----------------------------------------------------
# Same three choke points, nothing dropped. What moved upstream:
#   * service.rs: fetch_changes() is now a method of a new SyncClient (which
#     owns its own viaduct::Client and sends with send_sync()), and takes the
#     base URL and the telemetry wrapper as arguments instead of reading them
#     from self. The body is still replaced by an empty Changes; the two now
#     unused parameters are renamed _url/_telemetry.
#   * client.rs: sync() is unchanged; make_request() logs with breadcrumb!()
#     instead of trace!(). The server-info request in fetch_attachment (which
#     discovers the attachments base URL) also goes through make_request(),
#     so the comment there now names it.
#   * Checked that 157 adds no other egress to this crate: the only viaduct
#     send sites are SyncClient::fetch_changes and make_request.
# `cargo check --offline -p remote_settings` on the patched 157 tree passes.
# It warns (unused imports, never-read fields, dead backoff code), as the
# 153 patch did; rustc warnings are not fatal for this crate. The crate's
# own unit tests that drive fetch_changes/make_request against mockito
# expect network behaviour this patch removes, as on 153.

# 158 rebase (2026-10-04, pre-rebase against Firefox 158.0b3)
# -----------------------------------------------------------
# Same three choke points. client.rs: 158 split ViaductApiClient::make_request()
# into a thin wrapper that only logs errors (breadcrumb!) and _make_request(),
# which does the send. The blocking body now replaces _make_request(), the
# function that performs the request; make_request() is left as upstream wrote
# it, so every caller still gets the same Err. service.rs and sync() unchanged.
--- a/third_party/application-services/components/remote_settings/src/client.rs
+++ b/third_party/application-services/components/remote_settings/src/client.rs
@@ -379,25 +379,9 @@ impl<C: ApiClient> RemoteSettingsClient<C> {
     }
 
     pub fn sync(&self) -> Result<()> {
-        // First attempt
-        self.perform_sync_operation()?;
-        // Verify that inserted data has valid signature
-        if self.verify_signature().is_err() {
-            debug!(
-                "{0}: signature verification failed. Reset and retry.",
-                self.collection_name
-            );
-            // Retry with packaged dataset as base
-            self.reset_storage()?;
-            self.perform_sync_operation()?;
-            // Verify signature again
-            self.verify_signature().inspect_err(|_| {
-                // And reset with packaged data if it fails again.
-                self.reset_storage()
-                    .expect("Failed to reset storage after verification failure");
-            })?;
-        }
-        trace!("{0}: sync done.", self.collection_name);
+        // LibreWolf: never sync over the network.
+        // Packaged data (get_records Case 1) and cached data (Case 2) remain available.
+        trace!("{0}: sync skipped (LibreWolf: network disabled).", self.collection_name);
         Ok(())
     }
 
@@ -652,21 +636,14 @@ impl ViaductApiClient {
     }
 
     fn _make_request(&mut self, url: Url) -> Result<Response> {
-        self.remote_state.ensure_no_backoff()?;
-
-        let req = Request::get(url);
-        let resp = req.send()?;
-
-        self.remote_state.handle_backoff_hint(&resp)?;
-
-        if resp.is_success() {
-            Ok(resp)
-        } else {
-            Err(Error::response_error(
-                &resp.url,
-                format!("status code: {}", resp.status),
-            ))
-        }
+        // LibreWolf: all network requests to the Remote Settings server are blocked.
+        // This is the single choke point for all egress in this client
+        // (fetch_changeset, fetch_attachment, fetch_cert, and the server-info
+        // request that discovers the attachments base URL).
+        Err(Error::ResponseError {
+            url: url.to_string(),
+            message: "LibreWolf: Remote Settings network requests are disabled".to_string(),
+        })
     }
 }
 
--- a/third_party/application-services/components/remote_settings/src/service.rs
+++ b/third_party/application-services/components/remote_settings/src/service.rs
@@ -253,42 +253,13 @@ impl RemoteSettingsService {}
 impl SyncClient {
     fn fetch_changes(
         &mut self,
-        mut url: BaseUrl,
-        telemetry: &RemoteSettingsTelemetryWrapper,
+        _url: BaseUrl,
+        _telemetry: &RemoteSettingsTelemetryWrapper,
     ) -> Result<Changes> {
-        url.path_segments_mut()
-            .push("buckets")
-            .push("monitor")
-            .push("collections")
-            .push("changes")
-            .push("changeset");
-        // For now, always use `0` for the expected value.  This means we'll get updates based on
-        // the default TTL of 1 hour.
-        //
-        // Eventually, we should add support for push notifications and use the timestamp from the
-        // notification.
-        url.query_pairs_mut().append_pair("_expected", "0");
-        let url = url.into_inner();
-        trace!("make_request: {url}");
-        self.remote_state.ensure_no_backoff()?;
-
-        let start_time = std::time::Instant::now();
-        let req = Request::get(url);
-        let resp = self.client.send_sync(req)?;
-
-        self.remote_state.handle_backoff_hint(&resp)?;
-
-        const TELEMETRY_SOURCE_POLL: &str = "settings-changes-monitoring";
-        if resp.is_success() {
-            let body = resp.json()?;
-            let duration: u64 = start_time.elapsed().as_millis().try_into().unwrap_or(0);
-            telemetry.report_uptake_success(TELEMETRY_SOURCE_POLL, Some(duration));
-            Ok(body)
-        } else {
-            let e = Error::response_error(&resp.url, format!("status code: {}", resp.status));
-            telemetry.report_uptake_error(&e, TELEMETRY_SOURCE_POLL);
-            Err(e)
-        }
+        // LibreWolf: never fetch changes over the network.
+        // Return an empty changeset so sync() completes without any network I/O.
+        // Packaged data (get_records Case 1) and cached data (Case 2) remain available.
+        Ok(Changes { changes: Vec::new() })
     }
 }
 
