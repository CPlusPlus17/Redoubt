diff --git a/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/lw/UpdateCheckerTest.kt b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/lw/UpdateCheckerTest.kt
new file mode 100644
index 0000000000..98ecaf41f0
--- /dev/null
+++ b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/lw/UpdateCheckerTest.kt
@@ -0,0 +1,197 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// LibreWolf (LW-M6-06): pins the privacy contract of the update check where a
+// packet capture cannot see it -- inside the TLS request.
+
+package org.mozilla.fenix.lw
+
+import android.util.Base64
+import mozilla.components.concept.fetch.Client
+import mozilla.components.concept.fetch.MutableHeaders
+import mozilla.components.concept.fetch.Request
+import mozilla.components.concept.fetch.Response
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import java.io.ByteArrayInputStream
+import java.security.KeyPair
+import java.security.KeyPairGenerator
+import java.security.PrivateKey
+import java.security.Signature
+import java.security.spec.ECGenParameterSpec
+
+@RunWith(RobolectricTestRunner::class)
+class UpdateCheckerTest {
+
+    private class FakeClient(private val responses: Map<String, ByteArray>) : Client() {
+        val requests = mutableListOf<Request>()
+        override fun fetch(request: Request): Response {
+            requests += request
+            val body = responses[request.url]
+                ?: return Response(request.url, 404, MutableHeaders(), Response.Body.empty())
+            return Response(request.url, 200, MutableHeaders(), Response.Body(ByteArrayInputStream(body)))
+        }
+    }
+
+    private val endpoint = "https://redoubtbrowser.org/update/android/latest.json"
+
+    private fun keyPair(): KeyPair = KeyPairGenerator.getInstance("EC").run {
+        initialize(ECGenParameterSpec("secp256r1"))
+        generateKeyPair()
+    }
+
+    private fun pub(kp: KeyPair): String = Base64.encodeToString(kp.public.encoded, Base64.NO_WRAP)
+
+    private fun sign(document: ByteArray, key: PrivateKey): String = Signature.getInstance("SHA256withECDSA").run {
+        initSign(key)
+        update(document)
+        Base64.encodeToString(sign(), Base64.NO_WRAP)
+    }
+
+    private val document = """
+        {"latest_version": "157.0-2",
+         "download_url": "https://redoubtbrowser.org/downloads/redoubt-157.0-2.apk",
+         "release_notes_url": "https://redoubtbrowser.org/releases/157.0-2/",
+         "sha256": "0123456789abcdef",
+         "published_at": "2026-10-02T00:00:00Z"}
+    """.trimIndent().toByteArray()
+
+    @Test
+    fun `a correctly signed document naming a newer version is offered`() {
+        val kp = keyPair()
+        val client = FakeClient(mapOf(endpoint to document, "$endpoint.sig" to sign(document, kp.private).toByteArray()))
+        val result = UpdateChecker(client, endpoint, pub(kp), "157.0-1").check()
+        assertTrue(result is UpdateCheckResult.UpdateAvailable)
+        result as UpdateCheckResult.UpdateAvailable
+        assertEquals("157.0-2", result.latestVersion)
+        assertEquals("https://redoubtbrowser.org/downloads/redoubt-157.0-2.apk", result.downloadUrl)
+        assertEquals("https://redoubtbrowser.org/releases/157.0-2/", result.releaseNotesUrl)
+    }
+
+    @Test
+    fun `the running version is up to date`() {
+        val kp = keyPair()
+        val client = FakeClient(mapOf(endpoint to document, "$endpoint.sig" to sign(document, kp.private).toByteArray()))
+        assertEquals(UpdateCheckResult.UpToDate, UpdateChecker(client, endpoint, pub(kp), "157.0-2").check())
+    }
+
+    @Test
+    fun `a document signed by another key is a no-result, not an update`() {
+        val kp = keyPair()
+        val other = keyPair()
+        val client = FakeClient(mapOf(endpoint to document, "$endpoint.sig" to sign(document, other.private).toByteArray()))
+        assertTrue(UpdateChecker(client, endpoint, pub(kp), "157.0-1").check() is UpdateCheckResult.NoResult)
+    }
+
+    @Test
+    fun `a tampered document is a no-result`() {
+        val kp = keyPair()
+        val tampered = String(document).replace("redoubtbrowser.org/downloads", "evil.example/downloads").toByteArray()
+        val client = FakeClient(mapOf(endpoint to tampered, "$endpoint.sig" to sign(document, kp.private).toByteArray()))
+        assertTrue(UpdateChecker(client, endpoint, pub(kp), "157.0-1").check() is UpdateCheckResult.NoResult)
+    }
+
+    @Test
+    fun `a missing signature or document is a no-result`() {
+        val kp = keyPair()
+        assertTrue(UpdateChecker(FakeClient(mapOf(endpoint to document)), endpoint, pub(kp), "1").check() is UpdateCheckResult.NoResult)
+        assertTrue(UpdateChecker(FakeClient(emptyMap()), endpoint, pub(kp), "1").check() is UpdateCheckResult.NoResult)
+    }
+
+    @Test
+    fun `an http download url is rejected even when signed`() {
+        val kp = keyPair()
+        val insecure = String(document).replace("https://redoubtbrowser.org/downloads", "http://redoubtbrowser.org/downloads").toByteArray()
+        val client = FakeClient(mapOf(endpoint to insecure, "$endpoint.sig" to sign(insecure, kp.private).toByteArray()))
+        assertTrue(UpdateChecker(client, endpoint, pub(kp), "157.0-1").check() is UpdateCheckResult.NoResult)
+    }
+
+    @Test
+    fun `the request carries the static user agent and nothing else`() {
+        val kp = keyPair()
+        val client = FakeClient(mapOf(endpoint to document, "$endpoint.sig" to sign(document, kp.private).toByteArray()))
+        UpdateChecker(client, endpoint, pub(kp), "157.0-1").check()
+        assertEquals(listOf(endpoint, "$endpoint.sig"), client.requests.map { it.url })
+        for (request in client.requests) {
+            assertEquals(Request.Method.GET, request.method)
+            assertEquals(listOf("User-Agent" to UpdateChecker.USER_AGENT), request.headers!!.map { it.name to it.value })
+            assertEquals(Request.CookiePolicy.OMIT, request.cookiePolicy)
+            assertEquals(Request.Redirect.MANUAL, request.redirect)
+            assertFalse(request.useCaches)
+            assertTrue(request.private)
+            assertEquals(null, request.body)
+        }
+    }
+
+    private fun signed(doc: ByteArray, kp: KeyPair) =
+        FakeClient(mapOf(endpoint to doc, "$endpoint.sig" to sign(doc, kp.private).toByteArray()))
+
+    // What scripts/update-manifest.py writes: the versionName strings of two
+    // betas are identical, only the versionCode moves.
+    private val coded = """
+        {"latest_version": "157.0-1-beta.6",
+         "version_code": 2016188448,
+         "download_url": "https://github.com/CPlusPlus17/Redoubt/releases/tag/android-157.0-1-beta.6",
+         "published_at": "2026-10-05T00:00:00Z"}
+    """.trimIndent().toByteArray()
+
+    @Test
+    fun `the version code decides when both sides have one`() {
+        val kp = keyPair()
+        // beta.5 (x86_64 2016188262, universal 2016188263) is offered beta.6, whose
+        // lowest code is 2016188448, although both versionNames read 157.0-1-default.
+        val older = UpdateChecker(signed(coded, kp), endpoint, pub(kp), "157.0-1-default", 2016188263L).check()
+        assertTrue(older is UpdateCheckResult.UpdateAvailable)
+        assertEquals(2016188448L, (older as UpdateCheckResult.UpdateAvailable).versionCode)
+        // Any APK of the same build is at or above the lowest code: not offered.
+        for (code in listOf(2016188448L, 2016188450L, 2016188454L, 2016188455L)) {
+            assertEquals(UpdateCheckResult.UpToDate, UpdateChecker(signed(coded, kp), endpoint, pub(kp), "157.0-1-default", code).check())
+        }
+        // A newer install is not offered an older document, whatever the strings say.
+        assertEquals(UpdateCheckResult.UpToDate, UpdateChecker(signed(coded, kp), endpoint, pub(kp), "1-default", 2016190000L).check())
+    }
+
+    @Test
+    fun `without a version code in the document the version strings decide`() {
+        val kp = keyPair()
+        // The document has no version_code: string comparison, as before.
+        assertTrue(UpdateChecker(signed(document, kp), endpoint, pub(kp), "157.0-1", 2016188263L).check() is UpdateCheckResult.UpdateAvailable)
+        assertTrue(UpdateChecker(signed(document, kp), endpoint, pub(kp), "157.0-1", 0L).check() is UpdateCheckResult.UpdateAvailable)
+        // A non-numeric or negative version_code counts as absent.
+        val bogus = String(coded).replace("2016188448", "-5").toByteArray()
+        val parsed = UpdateChecker.parse(String(bogus))
+        assertEquals(0L, parsed!!.versionCode)
+    }
+
+    @Test
+    fun `a coded document is never offered to an install that cannot read its own code`() {
+        val kp = keyPair()
+        // beta.5 and beta.6 both read 157.0-1-default: a string fallback would
+        // offer beta.6 to itself. Unknown own code means up to date.
+        assertEquals(UpdateCheckResult.UpToDate, UpdateChecker(signed(coded, kp), endpoint, pub(kp), "157.0-1-default", 0L).check())
+        // Even where the strings alone would say "newer".
+        assertEquals(UpdateCheckResult.UpToDate, UpdateChecker(signed(coded, kp), endpoint, pub(kp), "153.4.0esr-1-default", 0L).check())
+    }
+
+    @Test
+    fun `version comparison is numeric and component-wise`() {
+        assertTrue(UpdateChecker.isNewer("157.0-2", "157.0-1"))
+        assertTrue(UpdateChecker.isNewer("154.0", "153.9.1"))
+        assertTrue(UpdateChecker.isNewer("153.1.0esr-1", "153.0esr-3"))
+        assertFalse(UpdateChecker.isNewer("157.0-1", "157.0-1"))
+        assertFalse(UpdateChecker.isNewer("157.0-1", "157.0-2"))
+        assertFalse(UpdateChecker.isNewer("latest", "157.0-1"))
+        // Release track: the Firefox version decides before the Redoubt release.
+        assertTrue(UpdateChecker.isNewer("157.0.1-1", "157.0-2"))
+        assertFalse(UpdateChecker.isNewer("157.0-2", "157.0.1-1"))
+        assertTrue(UpdateChecker.isNewer("158.0-1", "157.0.2-3"))
+        // Leaving ESR: a 153 ESR install is offered the release build.
+        assertTrue(UpdateChecker.isNewer("157.0-1", "153.4.0esr-1"))
+        assertFalse(UpdateChecker.isNewer("153.4.0esr-2", "157.0-1"))
+    }
+}
