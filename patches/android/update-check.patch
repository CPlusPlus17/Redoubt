+    <string name="lw_update_check_title">Check for updates</string>
+    <string name="lw_update_check_summary">Off by default. When on, Redoubt asks redoubtbrowser.org at most once a day whether a newer version exists. That site is hosted on GitHub Pages, so GitHub sees your IP address and the time of the request. It sends nothing that identifies you beyond the request itself — not even the version, which is compared on the device — and it never downloads or installs anything. Not needed if you installed from F-Droid or Accrescent.</string>
+    <string name="lw_update_check_available_title">Redoubt %1$s is available</string>
+    <string name="lw_update_check_available_message">A newer version was published at %1$s. Nothing has been downloaded; open the page to get it.</string>
+    <string name="lw_update_check_open_download">Open download page</string>
+    <string name="lw_update_check_later">Later</string>
+</resources>
