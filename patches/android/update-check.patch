+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// LibreWolf (LW-M6-06): the opt-in update check for the direct-APK distribution.
+//
+// The contract this implements is docs/android/DISTRIBUTION.md. The short form:
+//   * off by default; on only after the user flips the switch in Settings;
+//   * foreground only (HomeActivity.onResume), at most once per 24 h, no worker,
+//     no timer, no background service;
+//   * one static document and its detached signature are fetched from the
+//     distribution host; the request carries a static User-Agent, no cookies,
+//     no cache validators and nothing that identifies the device or install;
+//   * the signature (ECDSA P-256 / SHA-256, public key embedded at build time)
+//     is verified before a single field is read; any failure -- network, parse,
+//     signature -- is treated exactly as "no update": no prompt, no log line
+//     leaves the device, no retry storm;
+//   * it never downloads or installs anything. It tells the user a newer version
+//     exists and offers to open the download page.
+//   * builds without an embedded key (F-Droid, Accrescent) have no key, no row
+//     and no reachable code path -- BuildConfig.LW_UPDATE_CHECK_PUBKEY is empty.
+//   * the same direct-APK build, installed or last updated by a store client
+//     (Redoubt's own F-Droid repository serves the GitHub APKs unchanged), hides
+//     the row and never runs: the store notifies. See [UpdateCheck.STORE_INSTALLERS].
+
+package org.mozilla.fenix.lw
+
+import android.app.AlertDialog
+import android.content.Context
+import android.content.pm.PackageManager
+import android.os.Build
+import android.util.Base64
+import androidx.annotation.VisibleForTesting
+import androidx.core.content.pm.PackageInfoCompat
+import androidx.preference.TwoStatePreference
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import mozilla.components.concept.fetch.Client
+import mozilla.components.concept.fetch.Header
+import mozilla.components.concept.fetch.MutableHeaders
+import mozilla.components.concept.fetch.Request
+import mozilla.components.concept.fetch.isSuccess
+import mozilla.components.support.base.log.logger.Logger
+import mozilla.components.support.utils.ext.packageManagerCompatHelper
+import org.json.JSONException
+import org.json.JSONObject
+import org.mozilla.fenix.BrowserDirection
+import org.mozilla.fenix.BuildConfig
+import org.mozilla.fenix.HomeActivity
+import org.mozilla.fenix.R
+import org.mozilla.fenix.ext.components
+import org.mozilla.fenix.settings.SharedPreferenceUpdater
+import java.io.IOException
+import java.security.GeneralSecurityException
+import java.security.KeyFactory
+import java.security.Signature
+import java.security.spec.X509EncodedKeySpec
+import java.util.concurrent.TimeUnit
+
+/**
+ * What one run of the check concluded.
+ */
+sealed class UpdateCheckResult {
+    /** A signed document named a version newer than the one running. */
+    data class UpdateAvailable(
+        val latestVersion: String,
+        val downloadUrl: String,
+        val releaseNotesUrl: String?,
+        val sha256: String?,
+        /**
+         * The lowest versionCode among the release's APKs, or 0 when the
+         * document has none. When both sides have one, it decides (see
+         * [UpdateChecker.offers]).
+         */
+        val versionCode: Long = 0L,
+    ) : UpdateCheckResult()
+
+    /** A signed document named the running version (or an older one). */
+    object UpToDate : UpdateCheckResult()
+
+    /**
+     * The check could not conclude anything: network, parse or signature
+     * failure. By contract this is indistinguishable, for the user, from the
+     * check being off. [reason] is for local logs only.
+     */
+    data class NoResult(val reason: String) : UpdateCheckResult()
+}
+
+/**
+ * The pure half: two GETs, one signature verification, one version compare.
+ * Everything is injected so a unit test can drive it with a fake [Client]
+ * and its own key pair.
+ */
+class UpdateChecker(
+    private val client: Client,
+    private val endpoint: String,
+    private val publicKeySpkiBase64: String,
+    private val currentVersion: String,
+    private val currentVersionCode: Long = 0L,
+) {
+    private val logger = Logger("UpdateChecker")
+
+    fun check(): UpdateCheckResult {
+        val document = get(endpoint) ?: return UpdateCheckResult.NoResult("document fetch failed")
+        val signature = get("$endpoint.sig") ?: return UpdateCheckResult.NoResult("signature fetch failed")
+        if (!verify(document, String(signature, Charsets.UTF_8).trim(), publicKeySpkiBase64)) {
+            return UpdateCheckResult.NoResult("signature did not verify")
+        }
+        val parsed = parse(String(document, Charsets.UTF_8))
+            ?: return UpdateCheckResult.NoResult("document did not parse")
+        return if (offers(parsed, currentVersion, currentVersionCode)) parsed else UpdateCheckResult.UpToDate
+    }
+
+    /**
+     * One GET. The only things this request says about its sender are the URL
+     * and [USER_AGENT], which is the same literal on every install. Cookies are
+     * omitted, caches bypassed (no ETag / If-Modified-Since round-trips that
+     * could act as a per-install token), redirects are not followed (the
+     * document lives at one fixed URL), and the load is private. The headers
+     * Gecko adds by default that a caller can remove are removed: see
+     * [REQUEST_HEADERS].
+     */
+    @Suppress("TooGenericExceptionCaught")
+    private fun get(url: String): ByteArray? = try {
+        val request = Request(
+            url = url,
+            method = Request.Method.GET,
+            headers = MutableHeaders(REQUEST_HEADERS.map { (name, value) -> Header(name, value) }),
+            connectTimeout = Pair(TIMEOUT_SECONDS, TimeUnit.SECONDS),
+            readTimeout = Pair(TIMEOUT_SECONDS, TimeUnit.SECONDS),
+            redirect = Request.Redirect.MANUAL,
+            cookiePolicy = Request.CookiePolicy.OMIT,
+            useCaches = false,
+            private = true,
+        )
+        client.fetch(request).use { response ->
+            if (!response.isSuccess) {
+                null
+            } else {
+                response.body.useStream { readAtMost(it, MAX_BYTES + 1) }.takeIf { it.size <= MAX_BYTES }
+            }
+        }
+    } catch (e: IOException) {
+        logger.debug("update check: ${e.javaClass.simpleName} for $url")
+        null
+    } catch (e: RuntimeException) {
+        // GeckoViewFetchClient surfaces some transport failures as unchecked
+        // exceptions; every failure is "no result", never a crash.
+        logger.debug("update check: ${e.javaClass.simpleName} for $url")
+        null
+    }
+
+    /** Reads up to [limit] bytes; one more than [MAX_BYTES] is enough to reject an oversized body. */
+    private fun readAtMost(stream: java.io.InputStream, limit: Int): ByteArray {
+        val out = java.io.ByteArrayOutputStream()
+        val buf = ByteArray(8192)
+        while (out.size() < limit) {
+            val n = stream.read(buf, 0, minOf(buf.size, limit - out.size()))
+            if (n < 0) break
+            out.write(buf, 0, n)
+        }
+        return out.toByteArray()
+    }
+
+    companion object {
+        /** Static on purpose: identical on every install. */
+        const val USER_AGENT = "Redoubt-UpdateCheck/1"
+
+        /**
+         * Every header the request sets, in order. An EMPTY value is not sent
+         * as an empty header: GeckoViewFetchClient hands each pair to
+         * WebRequest.Builder.addHeader, WebExecutorSupport.cpp's
+         * SetupHttpChannel passes it to nsIHttpChannel.setRequestHeader with
+         * merge=false, and nsHttpHeaderArray::SetHeader treats an empty value
+         * as "remove this header". The channel's default headers were added
+         * before that, in HttpBaseChannel::Init
+         * (nsHttpHandler::AddStandardRequestHeaders), so the empty pairs
+         * below delete two of them:
+         *   * Accept-Language -- intl.accept_languages, i.e. the user's
+         *     locale ("en-US" in the 157.0-2 device acceptance). It differs
+         *     between users, so it is the one default header that says
+         *     something about who asked.
+         *   * Accept -- a constant for this load type; removed because
+         *     nothing needs it, not because it says anything.
+         * What a caller CANNOT remove this way is everything the channel adds
+         * after the caller's headers, at AsyncOpen / connect time: Sec-GPC: 1
+         * (nsHttpChannel::SetGlobalPrivacyControl), Sec-Fetch-*, Priority,
+         * Pragma / Cache-Control: no-cache (useCaches = false), Connection,
+         * Host. Accept-Encoding stays too: the compression-dictionary path
+         * (nsHttpHandler::AddAcceptAndDictionaryHeaders) may set it again
+         * later, so a removal could not be pinned, and its value depends only
+         * on the Gecko build. All of these are the same on every install of a
+         * given build. docs/android/DISTRIBUTION.md lists them.
+         */
+        val REQUEST_HEADERS: List<Pair<String, String>> = listOf(
+            "User-Agent" to USER_AGENT,
+            "Accept-Language" to "",
+            "Accept" to "",
+        )
+        const val TIMEOUT_SECONDS = 10L
+        const val MAX_BYTES = 64 * 1024
+
+        /**
+         * ECDSA P-256 with SHA-256 over the exact bytes of the served document;
+         * [signatureBase64] is the base64 of the DER signature (what
+         * `openssl dgst -sha256 -sign key.pem latest.json | base64 -w0` writes)
+         * and [publicKeySpkiBase64] the base64 DER SubjectPublicKeyInfo
+         * (`openssl ec -in key.pem -pubout -outform DER | base64 -w0`).
+         */
+        fun verify(document: ByteArray, signatureBase64: String, publicKeySpkiBase64: String): Boolean = try {
+            val key = KeyFactory.getInstance("EC")
+                .generatePublic(X509EncodedKeySpec(Base64.decode(publicKeySpkiBase64, Base64.DEFAULT)))
+            Signature.getInstance("SHA256withECDSA").run {
+                initVerify(key)
+                update(document)
+                verify(Base64.decode(signatureBase64, Base64.DEFAULT))
+            }
+        } catch (e: GeneralSecurityException) {
+            false
+        } catch (e: IllegalArgumentException) {
+            // malformed base64
+            false
+        }
+
+        /**
+         * The document, per DISTRIBUTION.md: `latest_version` and an https
+         * `download_url` are required; the rest is optional (`version_code` is a
+         * positive integer or treated as absent). Unknown fields are ignored.
+         */
+        fun parse(document: String): UpdateCheckResult.UpdateAvailable? = try {
+            val json = JSONObject(document)
+            val latest = json.getString("latest_version").trim()
+            val download = json.getString("download_url").trim()
+            if (latest.isEmpty() || !download.startsWith("https://")) {
+                null
+            } else {
+                UpdateCheckResult.UpdateAvailable(
+                    latestVersion = latest,
+                    downloadUrl = download,
+                    releaseNotesUrl = json.optString("release_notes_url").takeIf { it.startsWith("https://") },
+                    sha256 = json.optString("sha256").takeIf { it.isNotEmpty() },
+                    versionCode = json.optLong("version_code", 0L).coerceAtLeast(0L),
+                )
+            }
+        } catch (e: JSONException) {
+            null
+        }
+
+        /**
+         * Whether [latest] should be offered to an install running
+         * [currentVersion] / [currentVersionCode].
+         *
+         * The versionCode decides whenever both sides have one. Every Redoubt
+         * APK's versionName is "<firefox>-<release>-default" and several betas
+         * share it (beta.4 and beta.5 are both "157.0-1-default"); the
+         * versionCode is Fenix's build-hour code, which Android itself requires
+         * to increase on every update, and the document carries the LOWEST
+         * code of the release's APKs, so any APK of an older build is below it
+         * and any APK of the same build is not. When the document has a code
+         * but the install could not read its own (0), the answer is "up to
+         * date": the strings cannot tell betas apart and would offer a build
+         * its own release. [isNewer] on the strings is the fallback only for a
+         * document without a code.
+         */
+        fun offers(latest: UpdateCheckResult.UpdateAvailable, currentVersion: String, currentVersionCode: Long): Boolean =
+            if (latest.versionCode > 0L) {
+                currentVersionCode > 0L && latest.versionCode > currentVersionCode
+            } else {
+                isNewer(latest.latestVersion, currentVersion)
+            }
+
+        /**
+         * Numeric, component-wise, Firefox version first and the Redoubt release
+         * (the part after the last '-') second: "157.0-2" > "157.0-1",
+         * "157.0.1-1" > "157.0-2", "158.0-1" > "157.0.2-3", "157.0-1" > "153.4.0esr-1".
+         * Splitting matters on the release track: "157.0-2" and "157.0.1-1" have
+         * a different number of Firefox components, and a flat digit list would
+         * compare the "-2" against the ".1". Strings with no digits never count as newer.
+         */
+        fun isNewer(latest: String, current: String): Boolean {
+            val (latestFirefox, latestRelease) = split(latest)
+            val (currentFirefox, currentRelease) = split(current)
+            if (latestFirefox.isEmpty() && latestRelease.isEmpty()) return false
+            val order = compare(latestFirefox, currentFirefox)
+            return if (order != 0) order > 0 else compare(latestRelease, currentRelease) > 0
+        }
+
+        private fun split(version: String): Pair<List<Long>, List<Long>> {
+            val dash = version.lastIndexOf('-')
+            return if (dash < 0) {
+                numbers(version) to emptyList()
+            } else {
+                numbers(version.substring(0, dash)) to numbers(version.substring(dash + 1))
+            }
+        }
+
+        private fun compare(a: List<Long>, b: List<Long>): Int {
+            for (i in 0 until maxOf(a.size, b.size)) {
+                val x = a.getOrElse(i) { 0 }
+                val y = b.getOrElse(i) { 0 }
+                if (x != y) return x.compareTo(y)
+            }
+            return 0
+        }
+
+        private fun numbers(version: String): List<Long> =
+            Regex("\\d+").findAll(version).map { it.value.toLongOrNull() ?: 0L }.toList()
+    }
+}
+
+/**
+ * The app half: the switch, the once-a-day gate, the prompt.
+ */
+object UpdateCheck {
+    @VisibleForTesting internal const val PREFS = "lw_update_check"
+    @VisibleForTesting internal const val KEY_LAST_RUN_MS = "last_run_ms"
+    @VisibleForTesting internal const val KEY_LAST_OFFERED = "last_offered_version"
+    val MIN_INTERVAL_MS: Long = TimeUnit.HOURS.toMillis(24)
+
+    /** True only on a build handed a verification key at build time. */
+    val isCompiledIn: Boolean
+        get() = BuildConfig.LW_UPDATE_CHECK_PUBKEY.isNotEmpty()
+
+    /**
+     * Installers of record that bring their own update notification. Redoubt's
+     * F-Droid repository (LW-M6-03) serves the very APKs of the GitHub release,
+     * check compiled in, so the artifact alone cannot tell a store install from
+     * a direct one; the installer of record can. F-Droid and F-Droid Basic,
+     * Droid-ify, Neo Store (F-Droid clients that can add the repository),
+     * Accrescent and Google Play. Obtainium is deliberately absent: it tracks the
+     * direct-APK channel, which is the one this check exists for.
+     */
+    @VisibleForTesting internal val STORE_INSTALLERS: Set<String> = setOf(
+        "org.fdroid.fdroid",
+        "org.fdroid.basic",
+        "com.looker.droidify",
+        "com.machiav3lli.fdroid",
+        "app.accrescent.client",
+        "com.android.vending",
+    )
+
+    fun isStoreInstaller(installer: String?): Boolean = installer != null && installer in STORE_INSTALLERS
+
+    /**
+     * The installer of record: the package that performed the LAST install or
+     * update of this app (InstallSourceInfo.getInstallingPackageName, API 30+).
+     * Measured on Android 14: a hand-installed APK that F-Droid later updates
+     * reads org.fdroid.fdroid, and an APK installed by hand over an F-Droid
+     * install reads the system package installer again
+     * (docs/android/evidence/lw-m6-03/). Null when unknown (adb, a system app,
+     * an uninstalled installer): the check stays offered, off by default.
+     */
+    fun installerOf(context: Context): String? = try {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            context.packageManager.getInstallSourceInfo(context.packageName).installingPackageName
+        } else {
+            // The only API before 30; @Deprecated from 30, and the build is -Werror.
+            @Suppress("DEPRECATION")
+            context.packageManager.getInstallerPackageName(context.packageName)
+        }
+    } catch (e: PackageManager.NameNotFoundException) {
+        null
+    } catch (e: IllegalArgumentException) {
+        null
+    }
+
+    /**
+     * Whether this install offers the check at all: compiled in, and not
+     * installed or last updated by a store that notifies on its own.
+     */
+    fun isOffered(context: Context, compiledIn: Boolean = isCompiledIn): Boolean =
+        compiledIn && !isStoreInstaller(installerOf(context))
+
+    /**
+     * The user's switch. It is stored in Fenix's own preference file,
+     * components.settings.preferences ("fenix_preferences"), which is the file
+     * [bindSwitch] writes, and nowhere else. Absent means off. A store install
+     * ([isOffered] false) reads as off whatever is stored; the installer is
+     * asked only when the switch is on.
+     *
+     * [compiledIn] is a parameter only so that a unit test, whose build has no
+     * key, can reach the stored value; every production caller leaves it at
+     * [isCompiledIn].
+     */
+    fun isEnabled(context: Context, compiledIn: Boolean = isCompiledIn): Boolean =
+        compiledIn && context.components.settings.preferences.getBoolean(
+            context.getString(R.string.pref_key_lw_update_check),
+            false,
+        ) && isOffered(context, compiledIn)
+
+    /**
+     * Wires the Settings row (SettingsFragment.setupPreferences) to the file
+     * [isEnabled] reads. Left to androidx, a SwitchPreferenceCompat persists to
+     * the DEFAULT SharedPreferences file (<package>_preferences.xml), because
+     * SettingsFragment sets no sharedPreferencesName; 157.0-2 shipped exactly
+     * that, and its switch could be turned on without the check ever running.
+     * So, the way upstream wires its own switches that live in
+     * fenix_preferences (CustomizationFragment's gesture switches): the checked
+     * state is read from [isEnabled], and [SharedPreferenceUpdater] writes every
+     * change to components.settings.preferences under the row's key. The row
+     * itself is android:persistent="false" in preferences.xml, so androidx keeps
+     * no second copy that could disagree. Binding writes nothing: an install
+     * that never touches the switch has no value stored, which reads as off.
+     * On a store install ([isOffered] false) the row is hidden; a value stored
+     * before the store took over is kept but not acted on.
+     */
+    fun bindSwitch(switch: TwoStatePreference, compiledIn: Boolean = isCompiledIn) {
+        switch.isVisible = isOffered(switch.context, compiledIn)
+        switch.isChecked = isEnabled(switch.context, compiledIn)
+        switch.onPreferenceChangeListener = SharedPreferenceUpdater()
+    }
+
+    /**
+     * Called from HomeActivity.onResume. Returns without touching the network
+     * unless the check is compiled in, switched on, and at least
+     * [MIN_INTERVAL_MS] has passed since the last run.
+     */
+    fun maybeRun(activity: HomeActivity, scope: CoroutineScope) {
+        if (!isEnabled(activity)) return
+        val prefs = activity.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val now = System.currentTimeMillis()
+        val last = prefs.getLong(KEY_LAST_RUN_MS, 0L)
+        if (now - last in 0 until MIN_INTERVAL_MS) return
+        prefs.edit().putLong(KEY_LAST_RUN_MS, now).apply()
+        scope.launch(Dispatchers.IO) {
+            val info = try {
+                // PackageManager.getPackageInfo(String, Int) is @Deprecated from API 33 and
+                // the Fenix Kotlin build is -Werror; this is upstream's compat wrapper.
+                activity.packageManagerCompatHelper.getPackageInfoCompat(activity.packageName, 0)
+            } catch (e: android.content.pm.PackageManager.NameNotFoundException) {
+                null
+            }
+            val result = UpdateChecker(
+                client = activity.components.core.client,
+                endpoint = BuildConfig.LW_UPDATE_CHECK_ENDPOINT,
+                publicKeySpkiBase64 = BuildConfig.LW_UPDATE_CHECK_PUBKEY,
+                currentVersion = info?.versionName ?: "",
+                // PackageInfo.versionCode is @Deprecated (-Werror); this is what
+                // upstream's AboutFragment uses.
+                currentVersionCode = info?.let { PackageInfoCompat.getLongVersionCode(it) } ?: 0L,
+            ).check()
+            if (result is UpdateCheckResult.UpdateAvailable &&
+                prefs.getString(KEY_LAST_OFFERED, null) != result.latestVersion
+            ) {
+                prefs.edit().putString(KEY_LAST_OFFERED, result.latestVersion).apply()
+                withContext(Dispatchers.Main) { offer(activity, result) }
+            }
+        }
+    }
+
+    private fun offer(activity: HomeActivity, result: UpdateCheckResult.UpdateAvailable) {
+        if (activity.isFinishing || activity.isDestroyed) return
+        AlertDialog.Builder(activity)
+            .setTitle(activity.getString(R.string.lw_update_check_available_title, result.latestVersion))
+            .setMessage(activity.getString(R.string.lw_update_check_available_message, result.downloadUrl))
+            .setPositiveButton(R.string.lw_update_check_open_download) { _, _ ->
+                // openToBrowserAndLoad is @Deprecated (HomeActivity.kt:1361) and the
+                // Fenix build compiles Kotlin with -Werror, so calling it fails the
+                // build. This is what that wrapper does (HomeActivity.kt:1377-1388)
+                // and what its deprecation message points at.
+                activity.openToBrowser(BrowserDirection.FromHome)
+                activity.components.useCases.fenixBrowserUseCases.loadUrlOrSearch(
+                    searchTermOrURL = result.downloadUrl,
+                    newTab = true,
+                )
+            }
+            .setNegativeButton(R.string.lw_update_check_later, null)
+            .show()
+    }
+}
