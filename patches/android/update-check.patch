+++ b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/lw/UpdateCheckSwitchTest.kt
@@ -0,0 +1,166 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// LibreWolf (LW-M6-06): the Settings switch and the check read the same value.
+//
+// 157.0-2 shipped a switch that androidx persisted to the default
+// SharedPreferences file while UpdateCheck.isEnabled read fenix_preferences, so
+// turning it on never enabled the check. UpdateCheckerTest could not see that:
+// it drives UpdateChecker with everything injected and never touches the
+// switch. These tests drive the switch the way a tap does and then ask
+// UpdateCheck.isEnabled, the same question HomeActivity.onResume asks.
+//
+// Since 2026-10-05 (LW-M6-03) the same APK is also served by Redoubt's own
+// F-Droid repository, so the installer of record decides too: a store install
+// has no row and no check. The last three tests set it the way Android reports
+// it (InstallSourceInfo), as measured on an Android 14 emulator.
+
+package org.mozilla.fenix.lw
+
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import androidx.preference.SwitchPreferenceCompat
+import androidx.preference.TwoStatePreference
+import io.mockk.every
+import mozilla.components.support.test.robolectric.testContext
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mozilla.fenix.R
+import org.mozilla.fenix.ext.components
+import org.mozilla.fenix.utils.Settings
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+
+@RunWith(RobolectricTestRunner::class)
+class UpdateCheckSwitchTest {
+
+    private lateinit var settings: Settings
+    private val key: String get() = testContext.getString(R.string.pref_key_lw_update_check)
+
+    @Before
+    fun setUp() {
+        // The real Settings: its preferences are the real fenix_preferences file.
+        settings = Settings(testContext)
+        every { testContext.components.settings } returns settings
+    }
+
+    /** A Settings row as SettingsFragment.setupPreferences leaves it. */
+    private fun boundSwitch(): TwoStatePreference =
+        SwitchPreferenceCompat(testContext).apply {
+            key = this@UpdateCheckSwitchTest.key
+            isPersistent = false
+            UpdateCheck.bindSwitch(this, compiledIn = true)
+        }
+
+    /** What TwoStatePreference.onClick does when the user taps the row. */
+    private fun tap(switch: TwoStatePreference) {
+        val newValue = !switch.isChecked
+        if (switch.callChangeListener(newValue)) {
+            switch.isChecked = newValue
+        }
+    }
+
+    @Test
+    fun `by default the check is off and binding the switch stores nothing`() {
+        assertFalse(UpdateCheck.isEnabled(testContext, compiledIn = true))
+        // This test build has no key, so the production default is off as well.
+        assertFalse(UpdateCheck.isEnabled(testContext))
+
+        val switch = boundSwitch()
+
+        assertFalse(switch.isChecked)
+        assertTrue(switch.isVisible)
+        assertFalse(settings.preferences.contains(key))
+        assertFalse(UpdateCheck.isEnabled(testContext, compiledIn = true))
+    }
+
+    @Test
+    fun `turning the switch on enables the check and turning it off disables it`() {
+        val switch = boundSwitch()
+
+        tap(switch)
+
+        assertTrue(switch.isChecked)
+        assertTrue(UpdateCheck.isEnabled(testContext, compiledIn = true))
+        assertTrue(settings.preferences.getBoolean(key, false))
+        // The next time Settings opens, the row shows the stored state.
+        assertTrue(boundSwitch().isChecked)
+
+        tap(switch)
+
+        assertFalse(switch.isChecked)
+        assertFalse(UpdateCheck.isEnabled(testContext, compiledIn = true))
+        assertFalse(boundSwitch().isChecked)
+    }
+
+    @Test
+    fun `a value in the default preferences file does not enable the check`() {
+        // Where 157.0-2's switch wrote. Nothing reads it, and it is not migrated:
+        // nothing may switch the check on except a tap on the row.
+        PreferenceManager.getDefaultSharedPreferences(testContext).edit(commit = true) { putBoolean(key, true) }
+
+        assertFalse(UpdateCheck.isEnabled(testContext, compiledIn = true))
+        assertFalse(boundSwitch().isChecked)
+    }
+
+    @Test
+    fun `a build without a key hides the row and never reports the check enabled`() {
+        settings.preferences.edit(commit = true) { putBoolean(key, true) }
+        val switch = SwitchPreferenceCompat(testContext).apply { key = this@UpdateCheckSwitchTest.key }
+
+        UpdateCheck.bindSwitch(switch, compiledIn = false)
+
+        assertFalse(switch.isVisible)
+        assertFalse(switch.isChecked)
+        assertFalse(UpdateCheck.isEnabled(testContext, compiledIn = false))
+    }
+
+    private fun installedBy(installer: String?) {
+        shadowOf(testContext.packageManager).setInstallSourceInfo(testContext.packageName, installer, installer)
+    }
+
+    @Test
+    fun `an install by F-Droid or another store hides the row and never runs the check`() {
+        for (store in listOf("org.fdroid.fdroid", "org.fdroid.basic", "com.looker.droidify",
+            "com.machiav3lli.fdroid", "app.accrescent.client", "com.android.vending")) {
+            installedBy(store)
+            // Even with the switch stored ON (turned on before the store took over).
+            settings.preferences.edit(commit = true) { putBoolean(key, true) }
+
+            val switch = boundSwitch()
+
+            assertFalse(store, switch.isVisible)
+            assertFalse(store, switch.isChecked)
+            assertFalse(store, UpdateCheck.isOffered(testContext, compiledIn = true))
+            assertFalse(store, UpdateCheck.isEnabled(testContext, compiledIn = true))
+        }
+    }
+
+    @Test
+    fun `a hand install keeps the row and the switch works`() {
+        installedBy("com.google.android.packageinstaller")
+        val switch = boundSwitch()
+
+        assertTrue(switch.isVisible)
+        tap(switch)
+
+        assertTrue(UpdateCheck.isEnabled(testContext, compiledIn = true))
+    }
+
+    @Test
+    fun `a direct install that F-Droid later updates loses the check`() {
+        installedBy("com.google.android.packageinstaller")
+        tap(boundSwitch())
+        assertTrue(UpdateCheck.isEnabled(testContext, compiledIn = true))
+
+        // F-Droid updates it: Android now reports F-Droid as the installer.
+        installedBy("org.fdroid.fdroid")
+
+        assertFalse(UpdateCheck.isEnabled(testContext, compiledIn = true))
+        assertFalse(boundSwitch().isVisible)
+    }
+}
diff --git a/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/lw/UpdateCheckerTest.kt b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/lw/UpdateCheckerTest.kt
