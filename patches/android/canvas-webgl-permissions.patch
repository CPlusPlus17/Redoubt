+    <!-- Canvas/WebGL controls use the exact requesting origin and Gecko permission lifetime. -->
+    <string name="origin_permissions_title">Canvas and WebGL permissions</string>
+    <string name="origin_permissions_default">Ask for each site. WebGL and canvas readback stay protected until you allow an exception.</string>
+    <string name="origin_permissions_scope">Requests for this page and saved exceptions. Each exception applies only to the listed website address.</string>
