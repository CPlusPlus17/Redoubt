+
+package org.mozilla.fenix.browser.permissions
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.launch
+import mozilla.components.browser.state.action.ContentAction
+import mozilla.components.browser.state.selector.findTabOrCustomTab
+import mozilla.components.browser.state.selector.findTabOrCustomTabOrSelectedTab
+import mozilla.components.browser.state.store.BrowserStore
+import mozilla.components.concept.engine.permission.OriginBoundPermissionRequest
+import mozilla.components.concept.engine.permission.SitePermissions.Status
+import mozilla.components.lib.state.ext.flowScoped
+import mozilla.components.support.base.feature.LifecycleAwareFeature
+
+/** Presents a bounded prompt or a quiet, actionable notice for the actual requesting tab. */
+class OriginBoundPermissionsFeature(
+    private val store: BrowserStore,
+    private val sessionId: String?,
+    private val onQuietRequest: (String, OriginBoundPermissionRequest) -> Unit,
+    private val onPromptRequest: (String, OriginBoundPermissionRequest) -> Unit,
+    private val shouldHide: () -> Boolean = { false },
+    private val mainDispatcher: CoroutineDispatcher = Dispatchers.Main,
+) : LifecycleAwareFeature {
+    private var scope: CoroutineScope? = null
+    private val observed = mutableSetOf<String>()
+
+    override fun start() {
+        scope = store.flowScoped(dispatcher = mainDispatcher) { flow ->
+            flow.map { it.findTabOrCustomTabOrSelectedTab(sessionId) }
+                .distinctUntilChanged()
+                .collect { tab ->
+                    if (tab == null || shouldHide()) return@collect
+                    val requests = tab.content.permissionRequestsList.filterIsInstance<OriginBoundPermissionRequest>()
+                    requests.forEach { request ->
+                        if (observed.add(request.id)) {
+                            CoroutineScope(currentCoroutineContext()).launch {
+                                val applied = try {
+                                    request.awaitDecisionApplied()
+                                } catch (error: CancellationException) {
+                                    throw error
+                                } catch (_: Exception) {
+                                    // An engine failure terminates the request without granting it.
+                                    false
+                                }
+                                // Complete the Android result as well as the native actor so its
+                                // event-dispatch callback cannot outlive a canceled quiet request.
+                                if (!applied) request.reject()
+                                // Includes navigation and actor destruction before a user answers.
+                                store.dispatch(ContentAction.ConsumePermissionsRequest(tab.id, request))
+                                observed.remove(request.id)
+                            }
+                            if (request.isQuiet) {
+                                onQuietRequest(tab.id, request)
+                            } else {
+                                onPromptRequest(tab.id, request)
+                            }
+                        }
+                    }
+                }
+        }
+    }
+
+    override fun stop() {
+        scope?.cancel()
+        scope = null
+        observed.clear()
+    }
+}
+
+/** Apply one explicit choice and reload only through Gecko's original-document acknowledgment. */
+internal suspend fun applyOriginBoundDecision(
+    store: BrowserStore,
+    tabId: String,
+    request: OriginBoundPermissionRequest,
+    status: Status,
+    permanent: Boolean,
+): Boolean {
+    val tab = store.state.findTabOrCustomTab(tabId)
+    if (tab == null || tab.content.private != request.permission.privateMode ||
+        tab.contextId != request.permission.contextId ||
+        tab.content.permissionRequestsList.none { it.id == request.id }
+    ) {
+        request.reject()
+        return false
+    }
+    request.decide(status, permanent && !tab.content.private)
+    val applied = request.awaitDecisionApplied()
+    store.dispatch(ContentAction.ConsumePermissionsRequest(tabId, request))
+    // The engine checks the original WindowGlobal again in the same JS turn as the reload.
+    // An iframe decision reloads that frame, never a newly selected tab or a new document.
+    return applied && request.reloadIfCurrent()
+}
