+
+  MOZ_CAN_RUN_SCRIPT_BOUNDARY
+  void RunOnMainThread(dom::WorkerPrivate* aWorkerPrivate) override {
+    QueueAndroidCanvasPermission(aWorkerPrivate->GetAncestorWindow(),
+                                 mPrincipal, mWebGL, mQuiet);
+  }
+
+  void RunBackOnWorkerThreadForCleanup(
+      dom::WorkerPrivate* aWorkerPrivate) override {}
+
+ private:
+  nsCOMPtr<nsIPrincipal> mPrincipal;
+  const bool mWebGL;
+  const bool mQuiet;
+};
+
+static void RequestAndroidCanvasPermission(dom::OffscreenCanvas* aCanvas,
+                                           nsIPrincipal* aPrincipal,
+                                           bool aWebGL, bool aQuiet) {
+  if (NS_IsMainThread()) {
+    nsCOMPtr<nsIGlobalObject> global = aCanvas->GetRelevantGlobal();
+    if (global) {
+      QueueAndroidCanvasPermission(global->GetAsInnerWindow(), aPrincipal,
+                                   aWebGL, aQuiet);
+    }
+  } else if (auto* worker = dom::GetCurrentThreadWorkerPrivate()) {
+    RefPtr<AndroidCanvasPermissionPromptRunnable> runnable =
+        new AndroidCanvasPermissionPromptRunnable(aPrincipal, aWebGL, aQuiet);
+    runnable->Dispatch(worker);
+  }
+}
+
+static uint32_t GetAndroidWebGLPermission(nsIPrincipal* aPrincipal);
+
+class AndroidWebGLPermissionRunnable final
+    : public dom::WorkerMainThreadRunnable {
+ public:
+  AndroidWebGLPermissionRunnable(dom::WorkerPrivate* aWorker,
+                                 nsIPrincipal* aPrincipal)
+      : WorkerMainThreadRunnable(aWorker, "AndroidWebGLPermissionRunnable"_ns),
+        mPrincipal(aPrincipal) {}
+
+  bool MainThreadRun() override {
+    mResult = GetAndroidWebGLPermission(mPrincipal);
+    return true;
+  }
+
+  uint32_t Result() const { return mResult; }
+
+ private:
+  nsCOMPtr<nsIPrincipal> mPrincipal;
+  uint32_t mResult = nsIPermissionManager::UNKNOWN_ACTION;
+};
+
+static uint32_t GetAndroidWebGLPermission(nsIPrincipal* aPrincipal) {
+  if (!aPrincipal) {
+    return nsIPermissionManager::UNKNOWN_ACTION;
+  }
+  if (NS_IsMainThread()) {
+    nsCOMPtr<nsIPermissionManager> manager =
+        do_GetService(NS_PERMISSIONMANAGER_CONTRACTID);
+    uint32_t result = nsIPermissionManager::UNKNOWN_ACTION;
+    if (manager) {
+      manager->TestExactPermissionFromPrincipal(aPrincipal, "webgl"_ns, &result);
+    }
+    return result;
+  }
+  if (auto* worker = dom::GetCurrentThreadWorkerPrivate()) {
+    RefPtr<AndroidWebGLPermissionRunnable> runnable =
+        new AndroidWebGLPermissionRunnable(worker, aPrincipal);
+    ErrorResult error;
+    runnable->Dispatch(worker, dom::WorkerStatus::Canceling, error);
+    if (!error.Failed()) {
+      return runnable->Result();
+    }
+    error.SuppressException();
+  }
+  return nsIPermissionManager::UNKNOWN_ACTION;
+}
