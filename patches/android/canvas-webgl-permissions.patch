+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package mozilla.components.concept.engine.permission
+
+/** A canvas or WebGL exception owned by the engine, including its exact principal and lifetime. */
+data class OriginBoundPermission(
+    val kind: Kind,
+    val origin: String,
+    val principalOrigin: String,
+    val privateMode: Boolean,
+    val contextId: String?,
+    val status: SitePermissions.Status,
+    val permanent: Boolean,
+) {
+    /** Protected operations with an origin-specific exception. */
+    enum class Kind { WEBGL, CANVAS }
+}
+
+/**
+ * A request bound to one document and principal. These requests must not be merged by host or
+ * stored in a host-keyed permissions database. Dismissal is distinct from choosing Block.
+ */
+interface OriginBoundPermissionRequest : PermissionRequest {
+    val permission: OriginBoundPermission
+    val topLevelOrigin: String?
+    val isQuiet: Boolean
+
+    /** Completes this request once; private browsing always uses browser-session lifetime. */
+    fun decide(status: SitePermissions.Status, permanent: Boolean = false)
+
+    /** True only after the engine writes the decision for the still-current requesting document. */
+    suspend fun awaitDecisionApplied(): Boolean
+
+    /** Reloads only the original document, after an acknowledged decision. */
+    suspend fun reloadIfCurrent(): Boolean
+}
