+bool IsWebGLAllowedOnAndroid(dom::HTMLCanvasElement* aCanvas,
+                             dom::OffscreenCanvas* aOffscreenCanvas) {
+  if (!StaticPrefs::librewolf_webgl_prompt()) {
+    return true;
+  }
+  nsCOMPtr<nsIPrincipal> principal;
+  if (aCanvas) {
+    principal = aCanvas->NodePrincipal();
+  } else if (aOffscreenCanvas && aOffscreenCanvas->GetRelevantGlobal()) {
+    principal = aOffscreenCanvas->GetRelevantGlobal()->PrincipalOrNull();
+  }
+  if (IsUnrestrictedPrincipal(principal)) {
+    return true;
+  }
+  const uint32_t permission = GetAndroidWebGLPermission(principal);
+  if (permission == nsIPermissionManager::ALLOW_ACTION) {
+    return true;
+  }
+  if (permission != nsIPermissionManager::DENY_ACTION) {
+    const bool quiet = StaticPrefs::librewolf_webgl_prompt_hide();
+    if (aCanvas) {
+      QueueAndroidCanvasPermission(aCanvas->OwnerDoc()->GetInnerWindow(),
+                                   principal, true, quiet);
+    } else if (aOffscreenCanvas) {
+      RequestAndroidCanvasPermission(aOffscreenCanvas, principal, true, quiet);
+    }
+  }
+  return false;
+}
