+/** Convert only the two origin-bound types; engine lifetime is authoritative. */
+internal fun ContentPermission.toOriginBoundPermission(): OriginBoundPermission? {
+    val kind = when (permission) {
+        PERMISSION_WEBGL -> OriginBoundPermission.Kind.WEBGL
+        PERMISSION_CANVAS -> OriginBoundPermission.Kind.CANVAS
+        else -> return null
+    }
+    if (principalOrigin.isEmpty()) return null
+    return OriginBoundPermission(
+        kind = kind,
+        origin = uri,
+        principalOrigin = principalOrigin,
+        privateMode = privateMode,
+        contextId = contextId,
+        status = value.toStatus(),
+        permanent = expireType == 0 && !privateMode,
+    )
+}
