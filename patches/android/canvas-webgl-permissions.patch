+// The observer is attached to an inner window, never to an origin supplied by
+// content IPC. GeckoView's parent actor derives and checks its own principal.
+static void QueueAndroidCanvasPermission(nsPIDOMWindowInner* aWindow,
+                                         nsIPrincipal* aPrincipal, bool aWebGL,
+                                         bool aQuiet) {
+  AssertIsOnMainThread();
+  if (!aWindow || !aPrincipal || !aWindow->IsFullyActive()) {
+    return;
+  }
+  RefPtr<dom::Document> document = aWindow->GetExtantDoc();
+  if (!document || !aPrincipal->Equals(document->NodePrincipal())) {
+    return;
+  }
+  nsCOMPtr<nsPIDOMWindowInner> window = aWindow;
+  nsCOMPtr<nsIPrincipal> principal = aPrincipal;
+  // Canvas operations can run in script-unsafe callers. The observer executes
+  // JS, so defer it and validate the original document again at dispatch time.
+  window->AsGlobal()->SerialEventTarget()->Dispatch(NS_NewRunnableFunction(
+      "QueueAndroidCanvasPermission",
+      [window, principal, aWebGL, aQuiet]() {
+        RefPtr<dom::Document> current = window->GetExtantDoc();
+        if (!window->IsFullyActive() || !current ||
+            !principal->Equals(current->NodePrincipal())) {
+          return;
+        }
+        nsCOMPtr<nsIObserverService> observers = services::GetObserverService();
+        if (observers) {
+          observers->NotifyObservers(
+              window,
+              aWebGL ? "geckoview-webgl-permission"
+                     : "geckoview-canvas-permission",
+              aQuiet ? u"quiet" : u"prompt");
+        }
+      }));
+}
