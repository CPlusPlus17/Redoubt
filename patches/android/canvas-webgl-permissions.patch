+                    html + "<script>document.createElement('canvas').getContext('webgl');</script>"
+                },
+            ),
+        )
+        alternate.start(4246)
+        try {
+            val frameOrigin = "http://child.localhost:4246"
+            mainSession.evaluateJS(
