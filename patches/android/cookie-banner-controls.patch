diff --git a/toolkit/components/cookiebanners/test/unit/test_cookiebanner_private_session.js b/toolkit/components/cookiebanners/test/unit/test_cookiebanner_private_session.js
new file mode 100644
index 0000000..bc052f5
--- /dev/null
+++ b/toolkit/components/cookiebanners/test/unit/test_cookiebanner_private_session.js
@@ -0,0 +1,165 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+const { sinon } = ChromeUtils.importESModule("resource://testing-common/Sinon.sys.mjs");
+const { ContentPrefService2 } = ChromeUtils.importESModule("resource://gre/modules/ContentPrefService2.sys.mjs");
+const URI = Services.io.newURI("https://sub.example.org/path");
+do_get_profile();
+
+function privateContext() {
+  const browser = Services.appShell.createWindowlessBrowser(true);
+  browser.docShell.setOriginAttributes({ privateBrowsingId: 1 });
+  return browser;
+}
+
+function leavePrivate(browser) {
+  // Use the real browsing-context counter/notification, without forging an observer.
+  browser.docShell.setOriginAttributes({ privateBrowsingId: 0 });
+  browser.close();
+}
+
+add_task(function nested_initialization_teardown_rejects_before_map_mutation() {
+  // The manifest starts both modes at zero so the native domain service has not
+  // loaded its content-pref cache before this controlled first initialization.
+  let held;
+  const original = ContentPrefService2.prototype.getByName;
+  const stub = sinon.stub(ContentPrefService2.prototype, "getByName").callsFake(function(name, context, callback) {
+    if (name === "cookiebannerprivate") {
+      held = callback;
+      return;
+    }
+    return original.call(this, name, context, callback);
+  });
+  let browser;
+  let replacement;
+  let service;
+  let transitioned = false;
+  let replaceDuringTeardown = false;
+  // Register before DomainPrefService initializes. This observer exercises the
+  // real notification's ordering, including a new choice before its listener.
+  const earlierObserver = () => {
+    if (!replaceDuringTeardown) return;
+    replaceDuringTeardown = false;
+    replacement = privateContext();
+    held.handleCompletion(Ci.nsIContentPrefCallback2.COMPLETE_OK);
+    held = null;
+    const fresh = service.privateSessionToken;
+    service.setDomainPrefForPrivateSession(URI, 1, fresh);
+    transitioned = true;
+  };
+  Services.obs.addObserver(earlierObserver, "last-pb-context-exited");
+  browser = privateContext();
+  try {
+    Services.prefs.setIntPref("cookiebanners.service.mode", 1);
+    Services.prefs.setIntPref("cookiebanners.service.mode.privateBrowsing", 1);
+    service = Services.cookieBanners;
+    const token = service.privateSessionToken;
+    Assert.ok(held, "The real native cache load was held before completion");
+    Services.tm.dispatchToMainThread(() => {
+      replaceDuringTeardown = true;
+      leavePrivate(browser);
+      browser = null;
+      Assert.notEqual(service.privateSessionToken, token, "Real teardown changed generation");
+    });
+    // This invokes EnsureInitCompleted's actual nested event loop. Its teardown
+    // observer opens a new context and writes a different mode before the native
+    // domain listener runs. Neither the old write nor that listener may erase it.
+    Assert.throws(() => service.setDomainPrefForPrivateSession(URI, 0, token), /NS_ERROR_NOT_AVAILABLE/);
+    Assert.ok(transitioned, "The transition ran inside native initialization");
+    Assert.equal(service.getDomainPref(URI, true), 1, "New-session choice survived both teardown listeners");
+    const fresh = service.privateSessionToken;
+    service.setDomainPrefForPrivateSession(URI, 0, fresh);
+    Assert.equal(service.getDomainPref(URI, true), 0, "New-session control actually writes");
+    service.removeDomainPrefForPrivateSession(URI, fresh);
+  } finally {
+    held?.handleCompletion(Ci.nsIContentPrefCallback2.COMPLETE_OK);
+    stub.restore();
+    replaceDuringTeardown = false;
+    Services.obs.removeObserver(earlierObserver, "last-pb-context-exited");
+    if (browser) leavePrivate(browser);
+    if (replacement) leavePrivate(replacement);
+  }
+});
+
+add_task(function delayed_dispatch_after_last_private_context_is_rejected() {
+  const service = Services.cookieBanners;
+  const browser = privateContext();
+  const token = service.privateSessionToken;
+  service.setDomainPrefForPrivateSession(URI, 0, token);
+  leavePrivate(browser);
+  Assert.throws(() => service.privateSessionToken, /NS_ERROR_NOT_AVAILABLE/);
+  Assert.throws(() => service.setDomainPrefForPrivateSession(URI, 0, token), /NS_ERROR_NOT_AVAILABLE/);
+  Assert.throws(() => service.removeDomainPrefForPrivateSession(URI, token), /NS_ERROR_NOT_AVAILABLE/);
+  Assert.equal(service.getDomainPref(URI, true), service.MODE_UNSET);
+});
+
+add_task(function delayed_old_session_cannot_set_or_remove_new_session_data() {
+  const service = Services.cookieBanners;
+  const old = privateContext();
+  const oldToken = service.privateSessionToken;
+  leavePrivate(old);
+  const fresh = privateContext();
+  try {
+    const token = service.privateSessionToken;
+    Assert.notEqual(token, oldToken);
+    service.setDomainPrefForPrivateSession(URI, 0, token);
+    Assert.throws(() => service.setDomainPrefForPrivateSession(URI, 1, oldToken), /NS_ERROR_NOT_AVAILABLE/);
+    Assert.throws(() => service.removeDomainPrefForPrivateSession(URI, oldToken), /NS_ERROR_NOT_AVAILABLE/);
+    Assert.equal(service.getDomainPref(URI, true), 0, "New private choice is unchanged");
+    service.removeDomainPrefForPrivateSession(URI, token);
+    Assert.equal(service.getDomainPref(URI, true), service.MODE_UNSET);
+  } finally {
+    leavePrivate(fresh);
+  }
+});
+
+add_task(function scoped_private_changes_preserve_normal_domain_preference() {
+  const service = Services.cookieBanners;
+  service.setDomainPref(URI, 0, false);
+  const browser = privateContext();
+  try {
+    const token = service.privateSessionToken;
+    service.setDomainPrefForPrivateSession(URI, 1, token);
+    Assert.equal(service.getDomainPref(URI, false), 0);
+    Assert.equal(service.getDomainPref(URI, true), 1);
+    service.removeDomainPrefForPrivateSession(URI, token);
+    Assert.equal(service.getDomainPref(URI, false), 0);
+  } finally {
+    leavePrivate(browser);
+    service.removeDomainPref(URI, false);
+  }
+});
+
+add_task(function autostart_scoped_choices_expire_without_changing_legacy_topic_semantics() {
+  const service = Services.cookieBanners;
+  const legacyURI = Services.io.newURI("https://legacy.example.net/");
+  let legacyNotifications = 0;
+  const observe = () => legacyNotifications++;
+  Services.obs.addObserver(observe, "last-pb-context-exited");
+  Services.prefs.setBoolPref("browser.privatebrowsing.autostart", true);
+  let browser;
+  try {
+    browser = privateContext();
+    const token = service.privateSessionToken;
+    service.setDomainPrefForPrivateSession(URI, 0, token);
+    service.setDomainPref(legacyURI, 0, true);
+    leavePrivate(browser);
+    browser = null;
+    Assert.equal(legacyNotifications, 0, "The old topic remains suppressed in autostart");
+    Assert.throws(() => service.privateSessionToken, /NS_ERROR_NOT_AVAILABLE/);
+    browser = privateContext();
+    const fresh = service.privateSessionToken;
+    Assert.notEqual(token, fresh, "Actual context teardown advances generation in autostart");
+    Assert.equal(service.getDomainPref(URI, true), service.MODE_UNSET, "Scoped entry expired");
+    Assert.equal(service.getDomainPref(legacyURI, true), 0, "Legacy unscoped semantics remain unchanged");
+    Assert.throws(() => service.setDomainPrefForPrivateSession(URI, 0, token), /NS_ERROR_NOT_AVAILABLE/);
+    service.setDomainPrefForPrivateSession(URI, 0, fresh);
+    Assert.equal(service.getDomainPref(URI, true), 0);
+    service.removeDomainPrefForPrivateSession(URI, fresh);
+    service.removeDomainPref(legacyURI, true);
+  } finally {
+    if (browser) leavePrivate(browser);
+    Services.prefs.clearUserPref("browser.privatebrowsing.autostart");
+    Services.obs.removeObserver(observe, "last-pb-context-exited");
+  }
+});
