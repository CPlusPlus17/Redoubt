+nsresult CookieBannerDomainPrefService::GetPrivateSessionToken(nsACString& aToken) {
+  MOZ_ASSERT(NS_IsMainThread());
+  // Register the teardown observer before issuing a token, even when the normal
+  // idle initialization has not run yet. Content-pref loading can remain async.
+  Init();
