+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeout
+import mozilla.components.browser.state.selector.findTabOrCustomTab
+import mozilla.components.browser.state.state.SessionState
+import org.mozilla.fenix.R
+import org.mozilla.fenix.ext.requireComponents
+
+/** Shared normal/private controls, independent of rule-support detection or experiment UI flags. */
+open class CookieBannerSiteDialogFragment : DialogFragment() {
+    protected open val sessionId: String get() = requireArguments().getString(SESSION_ID).orEmpty()
+    protected open val expectedUrl: String get() = requireArguments().getString(EXPECTED_URL).orEmpty()
+    private var operation: Job? = null
+    private var closed = false
+    private var rendering = false
+    private lateinit var toggle: SwitchCompat
+    private lateinit var reset: Button
+    private lateinit var status: TextView
+    private lateinit var scopeLabel: TextView
+    private var controller: CookieBannerSiteController? = null
+
+    override fun onCreateDialog(savedInstanceState: Bundle?): Dialog {
+        val context = requireContext()
+        val content = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            val padding = (24 * resources.displayMetrics.density).toInt()
+            setPadding(padding, padding, padding, padding)
+        }
+        scopeLabel = TextView(context).apply { id = R.id.cookie_banner_site_scope }
+        toggle = SwitchCompat(context).apply {
+            id = R.id.cookie_banner_site_switch
+            setText(R.string.cookie_banner_site_enabled)
+            isEnabled = false
+        }
+        reset = Button(context).apply {
+            id = R.id.cookie_banner_site_reset
+            setText(R.string.cookie_banner_site_reset_label)
+            isAllCaps = false
+            isEnabled = false
+        }
+        status = TextView(context).apply {
+            id = R.id.cookie_banner_site_status
+            setText(R.string.cookie_banner_site_loading)
+            accessibilityLiveRegion = android.view.View.ACCESSIBILITY_LIVE_REGION_POLITE
+        }
+        content.addView(scopeLabel)
+        content.addView(toggle)
+        content.addView(reset)
+        content.addView(status)
+        toggle.setOnCheckedChangeListener { _, enabled ->
+            if (!rendering) perform { requireNotNull(controller).setEnabled(enabled) }
+        }
+        reset.setOnClickListener { perform { requireNotNull(controller).reset() } }
+        return AlertDialog.Builder(context)
+            .setTitle(R.string.cookie_banner_blocker)
+            .setView(content)
+            .setPositiveButton(R.string.cookie_banner_site_close, null)
+            .create().also { dialog -> dialog.setOnShowListener { initialize() } }
+    }
+
+    private fun initialize() {
+        perform {
+            val components = requireComponents
+            val tab = requireNotNull(components.core.store.state.findTabOrCustomTab(sessionId))
+            check(tab.content.url == expectedUrl)
+            val uri = tab.content.url.toUri()
+            check(uri.scheme == "https" || uri.scheme == "http")
+            val host = requireNotNull(uri.host)
+            val domain = requireNotNull(components.publicSuffixList.getPublicSuffixPlusOne(host).await())
+            val privateMode = tab.content.private
+            val privateArgument = arguments?.takeIf { it.containsKey(PRIVATE_MODE) }?.getBoolean(PRIVATE_MODE)
+            check(privateArgument == null || privateArgument == privateMode)
+            scopeLabel.text = getString(R.string.cookie_banner_site_scope, domain) + "\n" +
+                getString(if (privateMode) R.string.cookie_banner_site_private else R.string.cookie_banner_site_normal)
+            controller = CookieBannerSiteController(
+                uri = tab.content.url,
+                privateMode = privateMode,
+                storage = components.core.cookieBannersStorage,
+                isCurrent = {
+                    val current = components.core.store.state.findTabOrCustomTab(sessionId)
+                    !closed && current != null && current.content.url == tab.content.url &&
+                        current.content.private == privateMode
+                },
+                globalEnabled = {
+                    if (privateMode) components.settings.shouldUseCookieBannerPrivateMode
+                    else components.settings.shouldUseCookieBanner
+                },
+                reload = { components.useCases.sessionUseCases.reload(sessionId) },
+            )
+            requireNotNull(controller).read()
+        }
+    }
+
+    @Suppress("TooGenericExceptionCaught")
+    private fun perform(action: suspend () -> Boolean?) {
+        if (closed || operation?.isActive == true) return
+        toggle.isEnabled = false
+        reset.isEnabled = false
+        status.setText(R.string.cookie_banner_site_loading)
+        operation = lifecycleScope.launch {
+            try {
+                val enabled = withTimeout(OPERATION_TIMEOUT_MS) { action() }
+                rendering = true
+                toggle.isChecked = enabled == true
+                rendering = false
+                toggle.isEnabled = enabled != null
+                reset.isEnabled = enabled != null
+                status.setText(
+                    when (enabled) {
+                        null -> R.string.cookie_banner_site_global_off
+                        true -> R.string.cookie_banner_site_on
+                        false -> R.string.cookie_banner_site_off
+                    },
+                )
+            } catch (_: TimeoutCancellationException) {
+                status.setText(R.string.cookie_banner_site_error)
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                status.setText(
+                    if (controller == null) R.string.cookie_banner_site_unavailable else R.string.cookie_banner_site_error,
+                )
+            }
+        }
+    }
+
+    override fun onDismiss(dialog: DialogInterface) {
+        closed = true
+        operation?.cancel()
+        super.onDismiss(dialog)
+    }
+
+    override fun onDestroy() {
+        operation?.cancel()
+        super.onDestroy()
+    }
+
+    companion object {
+        private const val SESSION_ID = "cookie_banner_session_id"
+        private const val EXPECTED_URL = "cookie_banner_expected_url"
+        private const val PRIVATE_MODE = "cookie_banner_private_mode"
+        private const val OPERATION_TIMEOUT_MS = 10_000L
+
+        /** Captures the source tab, URL and privacy context, never the later selected tab. */
+        fun show(manager: FragmentManager, tab: SessionState) {
+            CookieBannerSiteDialogFragment().apply {
+                arguments = Bundle().apply {
+                    putString(SESSION_ID, tab.id)
+                    putString(EXPECTED_URL, tab.content.url)
+                    putBoolean(PRIVATE_MODE, tab.content.private)
+                }
+            }.show(manager, "cookie-banner-site-controls")
+        }
+    }
+}
