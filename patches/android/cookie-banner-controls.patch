+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.settings.cookiebannerhandling
+
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import mozilla.components.concept.engine.EngineSession.CookieBannerHandlingMode.DISABLED
+import mozilla.components.concept.engine.EngineSession.CookieBannerHandlingMode.REJECT_ALL
+import mozilla.components.concept.engine.cookiehandling.CookieBannersStorage
+
+/**
+ * Changes the captured domain in one browsing mode. The Gecko storage backend
+ * uses eTLD+1, including all subdomains and HTTP/HTTPS; private writes are temporary.
+ * No browsing-data clearing, persistent-private API or accept-mode write belongs here.
+ */
+internal class CookieBannerSiteController(
+    private val uri: String,
+    private val privateMode: Boolean,
+    private val storage: CookieBannersStorage,
+    private val isCurrent: () -> Boolean,
+    private val globalEnabled: () -> Boolean,
+    private val reload: () -> Unit,
+) {
+    private val mutex = Mutex()
+
+    /** Null means globally disabled; an existing exception must remain untouched. */
+    suspend fun read(): Boolean? = mutex.withLock { readCurrent() }
+
+    /** Enabling/resetting removes the exception and inherits rejection-only mode. */
+    suspend fun setEnabled(enabled: Boolean): Boolean? = mutex.withLock {
+        check(isCurrent()) { "The page changed" }
+        check(globalEnabled()) { "Cookie banner handling is disabled globally" }
+        if (enabled) {
+            storage.removeException(uri, privateMode)
+        } else {
+            storage.addException(uri, privateMode)
+        }
+        // Storage operations acknowledge Gecko callbacks before reporting success.
+        // A changed tab, URL or private context must not be reloaded. A same-URL
+        // navigation is not a document-identity fence; the domain choice is unchanged.
+        check(isCurrent()) { "The page changed during the update" }
+        val observed = readCurrent()
+        if (observed != null) {
+            check(observed == enabled) { "Cookie banner setting was not applied" }
+        }
+        reload()
+        observed
+    }
+
+    suspend fun reset(): Boolean? = setEnabled(true)
+
+    private suspend fun readCurrent(): Boolean? {
+        check(isCurrent()) { "The page changed" }
+        if (!globalEnabled()) return null
+        val mode = storage.findExceptionFor(uri, privateMode)
+        check(isCurrent()) { "The page changed while reading the setting" }
+        return when (mode) {
+            REJECT_ALL -> true
+            DISABLED -> false
+            else -> error("Unsupported or unavailable cookie banner mode")
+        }
+    }
+}
+
+/** Acquire a native private-session capability only for the still-open originating UI/tab. */
+internal suspend fun cookieBannerStorageForPage(
+    storage: CookieBannersStorage,
+    privateMode: Boolean,
+    isCurrent: () -> Boolean,
+): CookieBannersStorage {
+    check(isCurrent()) { "The originating page or dialog closed" }
+    val scoped = if (privateMode) storage.forCurrentPrivateSession() else storage
+    check(isCurrent()) { "The originating page or dialog closed during token capture" }
+    return scoped
+}
