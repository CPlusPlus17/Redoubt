+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.components
+
+import android.content.Context
+import mozilla.components.feature.addons.Addon
+import mozilla.components.feature.addons.AddonsProvider
+import mozilla.components.support.base.log.logger.Logger
+import org.mozilla.fenix.utils.Settings
+import java.io.File
+import java.io.IOException
+
+/**
+ * LibreWolf: decorator for an [AddonsProvider] that preinstalls uBlock Origin from
+ * the assets bundled with the APK.
+ *
+ * @param context A reference to the application context.
+ * @param amoProvider The wrapped add-ons provider (typically
+ * [mozilla.components.feature.addons.amo.AMOAddonsProvider]).
+ */
+class LibreWolfAddonsProvider(
+    private val context: Context,
+    private val amoProvider: AddonsProvider,
+) : AddonsProvider {
+    private val logger = Logger("LibreWolfAddonsProvider")
+
+    override suspend fun getFeaturedAddons(
+        allowCache: Boolean,
+        readTimeoutInSeconds: Long?,
+        language: String?,
+    ): List<Addon> {
+        val featuredAddons = amoProvider.getFeaturedAddons(allowCache, readTimeoutInSeconds, language)
+        if (featuredAddons.any { it.id == UBO_ADDON_ID }) {
+            return featuredAddons
+        }
+        return localUboAddon()?.let { featuredAddons + it } ?: featuredAddons
+    }
+
+    override suspend fun getAddonByID(
+        id: String,
+        readTimeoutInSeconds: Long?,
+        language: String?,
+    ): Addon? {
+        if (id == UBO_ADDON_ID) {
+            return localUboAddon()
+        }
+        return amoProvider.getAddonByID(id, readTimeoutInSeconds, language)
+    }
+
+    private fun localUboAddon(): Addon? {
+        val location = Settings.getLibreWolfUboAssetsBootstrapLocation(context)
+        if (location.isBlank() || !assetsExist(location)) {
+            logger.info("uBlock Origin assets not found at $location; not offering the preinstalled add-on")
+            return null
+        }
+
+        return Addon(
+            id = UBO_ADDON_ID,
+            author = Addon.Author(name = "Raymond Hillemans", url = "https://github.com/gorhill/uBlock"),
+            downloadUrl = location,
+            version = UBO_VERSION,
+            translatableName = mapOf(Addon.DEFAULT_LOCALE to UBO_NAME),
+            translatableDescription = mapOf(Addon.DEFAULT_LOCALE to UBO_DESCRIPTION),
+            translatableSummary = mapOf(Addon.DEFAULT_LOCALE to UBO_SUMMARY),
+            installedState = Addon.InstalledState(
+                id = UBO_ADDON_ID,
+                version = UBO_VERSION,
+                optionsPageUrl = null,
+                enabled = true,
+                supported = true,
+            ),
+        )
+    }
+
+    private fun assetsExist(location: String): Boolean {
+        return try {
+            context.assets.open(location).use { true }
+        } catch (e: IOException) {
+            // Not an APK asset; the location may be an absolute file path.
+            File(location).exists()
+        }
+    }
+
+    companion object {
+        const val UBO_ADDON_ID = "uBlock0@uvrove.com"
+
+        private const val UBO_NAME = "uBlock Origin"
+        private const val UBO_SUMMARY = "Fast, efficient, powerful ad blocker, with no tracking of its own."
+        private const val UBO_DESCRIPTION =
+            "uBlock Origin is a fast, efficient and powerful ad blocker, with no tracking of its own. " +
+                "LibreWolf bundles it and ships it preinstalled."
+        private const val UBO_VERSION = "1.62.0"
+    }
+}
