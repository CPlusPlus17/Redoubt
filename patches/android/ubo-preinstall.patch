+/** The session middleware uses this gate before creating any browsing engine session. */
+interface LibreWolfUboStartupGate {
+    val state: StateFlow<LibreWolfUboPreinstaller.State>
+    suspend fun awaitReady()
+}
+
+/**
+ * Installs the signed APK asset once, independently of the online add-on catalogue.
+ * COMPLETE records a provisioning decision, not a promise that the user kept uBO enabled.
+ * ATTEMPTED is persisted before installation: after a crash, an absent add-on requires an
+ * explicit retry. In particular, an interrupted first run must never silently undo removal.
+ *
+ * Gecko's ordinary add-on updater may replace uBO while its readiness is awaited: the
+ * signed AMO update shuts the awaited version down. Only a strictly newer, enabled copy
+ * with the same ID, installed by Gecko (which enforces the AMO signature), restarts the
+ * wait, with its own timeout and a bounded number of times. Absence, disablement or a
+ * downgrade keeps the original failure, with two exceptions that are the user's own
+ * choice and that a restart would accept anyway (LW-M7-44): a copy the user disabled
+ * during the wait, and the removal of an already provisioned copy. Neither unblocks
+ * anything that should be filtered; the user turned filtering off.
+ */
+class LibreWolfUboPreinstaller internal constructor(
+    private val dependencies: Dependencies,
+    private val scope: CoroutineScope,
+    private val timeoutMillis: Long = ATTEMPT_TIMEOUT_MILLIS,
+) : LibreWolfUboStartupGate {
+    constructor(context: Context) : this(
+        AndroidDependencies(context.applicationContext),
+        CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate),
+    )
+
+    sealed interface State {
+        data object Preparing : State
+        data class Ready(val installed: Boolean, val enabled: Boolean) : State
+        data class Failed(val reason: String) : State
+    }
+
+    /**
+     * [userDisabled] is Gecko's userDisabled flag, which only the user or chrome code sets.
+     * navigator.mozAddonManager on AMO hosts can also disable an add-on; that is not
+     * exploitable during the startup hold because no tab runs until the wait ends.
+     */
+    internal data class Installed(
+        val enabled: Boolean,
+        val version: String,
+        val userDisabled: Boolean = false,
+    )
+
+    /** How a readiness wait ended: filtering is live, or the user turned uBO off meanwhile. */
+    private enum class WaitResult { FILTERING, USER_DISABLED, USER_REMOVED }
+
+    internal data class VerifiedAsset(
+        val id: String,
+        val version: String,
+        val url: String,
+        val file: File? = null,
+    )
+
+    internal interface Dependencies {
+        suspend fun readDecision(): String?
+        suspend fun writeDecision(decision: String)
+        suspend fun installed(): Installed?
+        suspend fun prepareAsset(): VerifiedAsset
+        suspend fun install(asset: VerifiedAsset)
+        suspend fun awaitFilteringReady(version: String)
+    }
+
+    private val mutableState = MutableStateFlow<State>(State.Preparing)
+    override val state = mutableState.asStateFlow()
+    private var started = false
+    private var attempt: Job? = null
+    private var trustedAsset: VerifiedAsset? = null
+    private var permissionGranted = false
+
+    fun start() {
+        if (started) return
+        started = true
+        launchAttempt(explicitRetry = false)
+    }
+
+    fun retry() {
+        if (state.value !is State.Failed || attempt?.isActive == true) return
+        launchAttempt(explicitRetry = true)
+    }
+
+    override suspend fun awaitReady() {
+        state.first { it is State.Ready }
+    }
+
+    /** Return false to retain the ordinary permission prompt for every other installation. */
+    @Suppress("UNUSED_PARAMETER")
+    fun onInstallPermissionRequest(
+        extension: WebExtension,
+        permissions: List<String>,
+        origins: List<String>,
+        dataCollectionPermissions: List<String>,
+        onConfirm: (PermissionPromptResponse) -> Unit,
+    ): Boolean {
+        val asset = trustedAsset ?: return false
+        if (permissionGranted || extension.id != ADDON_ID || extension.id != asset.id ||
+            extension.url != asset.url || extension.getMetadata()?.version != asset.version
+        ) {
+            return false
+        }
+        // The immutable bytes were hash-checked before this transaction was made active.
+        // Gecko has separately validated the manifest and AMO signature before prompting.
+        permissionGranted = true
+        onConfirm(
+            PermissionPromptResponse(
+                isPermissionsGranted = true,
+                isPrivateModeGranted = true,
+                isTechnicalAndInteractionDataGranted = false,
+            ),
+        )
+        return true
+    }
+
+    private fun launchAttempt(explicitRetry: Boolean) {
+        mutableState.value = State.Preparing
+        attempt = scope.launch {
+            try {
+                var replacements = 0
+                while (true) {
+                    try {
+                        withTimeout(timeoutMillis) { reconcile(explicitRetry) }
+                        break
+                    } catch (replaced: ReplacedWhileStarting) {
+                        if (++replacements > MAX_REPLACEMENTS) throw replaced
+                        // The registry now holds the newer copy, so a fresh pass takes the
+                        // existing-installation path: no reinstall, its own readiness wait.
+                        logger.info("uBlock Origin was updated to ${replaced.version} during startup")
+                    }
+                }
+                logger.info("uBlock Origin startup ready: ${state.value}")
+            } catch (exception: TimeoutCancellationException) {
+                fail(exception)
+            } catch (exception: CancellationException) {
+                throw exception
+            } catch (exception: Exception) {
+                fail(exception)
+            } finally {
+                trustedAsset = null
+                permissionGranted = false
+            }
+        }
+    }
+
+    private fun fail(exception: Exception) {
+        trustedAsset = null
+        logger.error("uBlock Origin startup failed; browsing remains paused", exception)
+        mutableState.value = State.Failed(exception.message ?: exception.javaClass.simpleName)
+    }
+
+    private suspend fun reconcile(explicitRetry: Boolean) {
+        val decision = dependencies.readDecision()
+        dependencies.installed()?.let { installed ->
+            // Never reinstall, downgrade, enable or change private permission on an existing copy.
+            dependencies.writeDecision(COMPLETE)
+            val result = if (installed.enabled) {
+                awaitFilteringReady(installed.version, removalIsUserChoice = true)
+            } else {
+                null
+            }
+            mutableState.value = when (result) {
+                null -> State.Ready(installed = true, enabled = false)
+                WaitResult.FILTERING -> State.Ready(installed = true, enabled = true)
+                WaitResult.USER_DISABLED -> State.Ready(installed = true, enabled = false)
+                WaitResult.USER_REMOVED -> State.Ready(installed = false, enabled = false)
+            }
+            return
+        }
+        if (decision == COMPLETE) {
+            mutableState.value = State.Ready(installed = false, enabled = false)
+            return
+        }
+        if (decision != null && !explicitRetry) {
+            throw IOException("The earlier uBlock Origin installation did not finish. Retry is required.")
+        }
+
+        val asset = dependencies.prepareAsset()
+        try {
+            check(asset.id == ADDON_ID) { "Bundled extension ID does not match uBlock Origin" }
+            dependencies.writeDecision(ATTEMPTED)
+            permissionGranted = false
+            trustedAsset = asset
+            dependencies.install(asset)
+            trustedAsset = null
+            val installed = dependencies.installed()
+                ?: throw IOException("Installed uBlock Origin is missing from Gecko's add-on registry")
+            if (!installed.enabled) {
+                throw IOException("Gecko did not enable the installed uBlock Origin extension")
+            }
+            // A removal here keeps the failure: a restart would also require an explicit retry.
+            val result = awaitFilteringReady(installed.version, removalIsUserChoice = false)
+            dependencies.writeDecision(COMPLETE)
+            mutableState.value = State.Ready(installed = true, enabled = result == WaitResult.FILTERING)
+        } finally {
+            trustedAsset = null
+            asset.file?.delete()
+        }
+    }
+
+    private suspend fun awaitFilteringReady(version: String, removalIsUserChoice: Boolean): WaitResult {
+        try {
+            dependencies.awaitFilteringReady(version)
+            return WaitResult.FILTERING
+        } catch (exception: CancellationException) {
+            throw exception
+        } catch (exception: Exception) {
+            val settled = settleRegistry(version)
+            return when {
+                settled != null && isNewerEnabled(settled, version) ->
+                    throw ReplacedWhileStarting(settled.version, exception)
+                // Judged only on a registry that held still after the whole settle window:
+                // Gecko's reload (for example a private-browsing permission change) sets
+                // userDisabled until the old instance has shut down, then starts it again,
+                // and a starting copy reads enabled (Gecko's isActive), so it never matches.
+                settled != null && !settled.enabled && settled.userDisabled -> {
+                    logger.info("uBlock Origin was disabled by the user during startup")
+                    WaitResult.USER_DISABLED
+                }
+                settled == null && removalIsUserChoice -> {
+                    logger.info("uBlock Origin was removed by the user during startup")
+                    WaitResult.USER_REMOVED
+                }
+                else -> throw exception
+            }
+        }
+    }
+
+    /**
+     * The updater's shutdown can fail the wait before the newer copy is registered, so
+     * the registry is re-read for a short window. Returns a newer enabled copy as soon
+     * as one appears. Otherwise the registry must then read the same for
+     * [SETTLED_POLLS] further polls, so that a reload whose transient userDisabled
+     * outlasts the window on a slow device is seen restarting rather than taken for the
+     * user's disable. A registry still changing [SETTLE_EXTENSION_MILLIS] after the
+     * window fails closed.
+     */
+    private suspend fun settleRegistry(awaitedVersion: String): Installed? {
+        var waited = 0L
+        var previous: Installed? = null
+        var unchanged = 0
+        while (true) {
+            val installed = dependencies.installed()
+            if (installed != null && isNewerEnabled(installed, awaitedVersion)) return installed
+            if (waited >= REPLACEMENT_SETTLE_MILLIS) {
+                unchanged = if (waited > REPLACEMENT_SETTLE_MILLIS && installed == previous) unchanged + 1 else 0
+                if (unchanged >= SETTLED_POLLS) return installed
+                if (waited >= REPLACEMENT_SETTLE_MILLIS + SETTLE_EXTENSION_MILLIS) {
+                    throw IOException("uBlock Origin's add-on state did not settle during startup")
+                }
+            }
+            previous = installed
+            delay(REPLACEMENT_POLL_MILLIS)
+            waited += REPLACEMENT_POLL_MILLIS
+        }
+    }
+
+    private fun isNewerEnabled(installed: Installed, awaitedVersion: String) =
+        installed.enabled && compareVersions(installed.version, awaitedVersion) > 0
+
+    private class ReplacedWhileStarting(val version: String, cause: Exception) :
+        IOException("uBlock Origin was replaced by version $version while starting", cause)
+
+    private class AndroidDependencies(private val context: Context) : Dependencies {
+        private val preferences by lazy {
+            context.getSharedPreferences("librewolf_ubo_preinstall", Context.MODE_PRIVATE)
+        }
+
+        override suspend fun readDecision() = withContext(Dispatchers.IO) {
+            preferences.getString("decision", null)
+        }
+
+        override suspend fun writeDecision(decision: String) = withContext(Dispatchers.IO) {
+            if (!preferences.edit().putString("decision", decision).commit()) {
+                throw IOException("Could not persist the uBlock Origin provisioning decision")
+            }
+        }
+
+        override suspend fun installed(): Installed? {
+            WebExtensionSupport.awaitInitialization()
+            val extensions = suspendCancellableCoroutine<List<WebExtension>> { continuation ->
+                context.components.core.engine.listInstalledWebExtensions(
+                    onSuccess = { if (continuation.isActive) continuation.resume(it) },
+                    onError = { if (continuation.isActive) continuation.resumeWithException(it) },
+                )
+            }
+            return extensions.firstOrNull { it.id == ADDON_ID }?.let {
+                val metadata = it.getMetadata()
+                Installed(
+                    enabled = it.isEnabled(),
+                    version = metadata?.version.orEmpty(),
+                    userDisabled = metadata?.disabledFlags?.contains(DisabledFlags.USER) == true,
+                )
+            }
+        }
+
+        override suspend fun prepareAsset(): VerifiedAsset = withContext(Dispatchers.IO) {
+            val metadata = context.assets.open("extensions/ubo-extension.json").bufferedReader().use {
+                JSONObject(it.readText())
+            }
+            require(metadata.getInt("schema") == 1) { "Unsupported uBlock Origin asset metadata" }
+            require(metadata.getString("id") == ADDON_ID) { "Unexpected bundled extension ID" }
+            require(metadata.getString("asset") == "extensions/ublock_origin.xpi") {
+                "Unexpected bundled extension asset path"
+            }
+            val expectedHash = metadata.getString("sha256")
+            require(expectedHash.matches(Regex("[0-9a-f]{64}"))) { "Invalid extension hash pin" }
+            val file = File.createTempFile("ublock-origin-", ".xpi", context.noBackupFilesDir)
+            try {
+                context.assets.open("extensions/ublock_origin.xpi").use { input ->
+                    copyAndVerifyAsset(input, file, metadata.getLong("size"), expectedHash)
+                }
+                VerifiedAsset(ADDON_ID, metadata.getString("version"), Uri.fromFile(file).toString(), file)
+            } catch (exception: Exception) {
+                file.delete()
+                throw exception
+            }
+        }
+
+        override suspend fun install(asset: VerifiedAsset) = suspendCancellableCoroutine<Unit> { continuation ->
+            val operation = context.components.addonManager.installAddon(
+                url = asset.url,
+                installationMethod = InstallationMethod.FROM_FILE,
+                onSuccess = { if (continuation.isActive) continuation.resume(Unit) },
+                onError = { if (continuation.isActive) continuation.resumeWithException(it) },
+            )
+            continuation.invokeOnCancellation { operation.cancel() }
+        }
+
+        override suspend fun awaitFilteringReady(version: String) {
+            // On an APP_STARTUP, Gecko delays persistent background pages until the first
+            // GeckoView window sends extensions-late-startup. The session middleware holds
+            // every tab until uBO is ready, so a launcher start (home screen, no incoming
+            // URL) would otherwise never open a window and the wait could only time out.
+            // A speculative session opens that window without loading anything, exactly as
+            // IntentReceiverActivity does for VIEW intents; the first tab later adopts it.
+            withContext(Dispatchers.Main) {
+                context.components.core.engine.speculativeCreateSession(private = false)
+            }
+            awaitBlockingResponseListener(version)
+        }
+
+        private suspend fun awaitBlockingResponseListener(version: String): Unit = suspendCancellableCoroutine { continuation ->
+            val result = context.components.core.geckoRuntime.webExtensionController.awaitBlockingResponseListener(
+                ADDON_ID,
+                version,
+            )
+            result.accept(
+                { if (continuation.isActive) continuation.resume(Unit) },
+                { error ->
+                    if (continuation.isActive) {
+                        continuation.resumeWithException(
+                            error ?: IOException("Gecko did not provide a readiness failure cause"),
+                        )
+                    }
+                },
+            )
+            continuation.invokeOnCancellation { result.cancel() }
+        }
+    }
+
+    internal companion object {
+        const val ADDON_ID = "uBlock0@raymondhill.net"
+        const val ATTEMPTED = "attempted"
+        const val COMPLETE = "complete"
+        const val MAX_REPLACEMENTS = 2
+        const val REPLACEMENT_SETTLE_MILLIS = 5_000L
+        const val REPLACEMENT_POLL_MILLIS = 250L
+        const val SETTLED_POLLS = 3
+        const val SETTLE_EXTENSION_MILLIS = 5_000L
+
+        /**
+         * Numeric dotted comparison; a suffix (1.75.1b3) sorts before its release. An
+         * unparseable part never compares as newer, so it cannot restart the wait.
+         */
+        internal fun compareVersions(left: String, right: String): Int {
+            val a = left.split('.').map { VERSION_PART.matchEntire(it) }
+            val b = right.split('.').map { VERSION_PART.matchEntire(it) }
+            if (a.any { it == null } || b.any { it == null }) return if (left == right) 0 else -1
+            for (index in 0 until maxOf(a.size, b.size)) {
+                val x = a.getOrNull(index) ?: VERSION_PART.matchEntire("0")!!
+                val y = b.getOrNull(index) ?: VERSION_PART.matchEntire("0")!!
+                val number = (x.groupValues[1].toLongOrNull() ?: 0L)
+                    .compareTo(y.groupValues[1].toLongOrNull() ?: 0L)
+                if (number != 0) return number
+                val suffixX = x.groupValues[2]
+                val suffixY = y.groupValues[2]
+                if (suffixX != suffixY) {
+                    return when {
+                        suffixX.isEmpty() -> 1
+                        suffixY.isEmpty() -> -1
+                        else -> suffixX.compareTo(suffixY)
+                    }
+                }
+            }
+            return 0
+        }
+
+        private val VERSION_PART = Regex("([0-9]{0,9})([A-Za-z0-9+-]*)")
+        internal fun copyAndVerifyAsset(
+            input: InputStream,
+            destination: File,
+            expectedSize: Long,
+            expectedHash: String,
+        ) {
+            val digest = MessageDigest.getInstance("SHA-256")
+            var size = 0L
+            destination.outputStream().use { output ->
+                val buffer = ByteArray(DEFAULT_BUFFER_SIZE)
+                while (true) {
+                    val count = input.read(buffer)
+                    if (count < 0) break
+                    digest.update(buffer, 0, count)
+                    output.write(buffer, 0, count)
+                    size += count
+                }
+            }
+            val actualHash = digest.digest().joinToString("") { "%02x".format(it) }
+            require(size == expectedSize && actualHash == expectedHash) {
+                "Bundled uBlock Origin does not match its pinned size and SHA-256"
+            }
+            // Private, uniquely named, read-only file; the installed APK remains unchanged.
+            check(destination.setReadOnly()) { "Could not make the verified extension file read-only" }
+        }
+
+        private const val ATTEMPT_TIMEOUT_MILLIS = 30_000L
+        private val logger = Logger("LibreWolfUboPreinstaller")
+    }
+}
