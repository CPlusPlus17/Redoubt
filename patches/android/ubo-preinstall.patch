+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.components
+
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import mozilla.components.browser.state.action.BrowserAction
+import mozilla.components.browser.state.action.EngineAction
+import mozilla.components.browser.state.state.BrowserState
+import mozilla.components.lib.state.Middleware
+import mozilla.components.lib.state.Store
+import java.util.IdentityHashMap
+
+/** Hold incoming URLs, restored tabs and custom tabs before an engine session can load them. */
+class LibreWolfUboPreinstallMiddleware(
+    private val gate: LibreWolfUboStartupGate,
+    private val scope: CoroutineScope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate),
+) : Middleware<BrowserState, BrowserAction> {
+    private val lock = Any()
+    private val pending = mutableListOf<EngineAction.CreateEngineSessionAction>()
+    private val replays = IdentityHashMap<EngineAction.CreateEngineSessionAction, Int>()
+    private var waiting = false
+
+    override fun invoke(
+        store: Store<BrowserState, BrowserAction>,
+        next: (BrowserAction) -> Unit,
+        action: BrowserAction,
+    ) {
+        if (action !is EngineAction.CreateEngineSessionAction) {
+            next(action)
+            return
+        }
+        val passThrough = synchronized(lock) {
+            val replayCount = replays[action] ?: 0
+            when {
+                replayCount > 0 -> {
+                    if (replayCount == 1) replays.remove(action) else replays[action] = replayCount - 1
+                    true
+                }
+                gate.state.value is LibreWolfUboPreinstaller.State.Ready &&
+                    !waiting && replays.isEmpty() -> true
+                else -> {
+                    pending.add(action)
+                    if (waiting) return
+                    waiting = true
+                    false
+                }
+            }
+        }
+        if (passThrough) {
+            next(action)
+            return
+        }
+        scope.launch {
+            gate.awaitReady()
+            // Dispatch through the store again; never retain or invoke a middleware next callback
+            // asynchronously. This also lets normal session creation discard removed tabs.
+            while (true) {
+                val actions = synchronized(lock) {
+                    if (pending.isEmpty()) {
+                        waiting = false
+                        return@launch
+                    }
+                    pending.toList().also { batch ->
+                        batch.forEach { replays[it] = (replays[it] ?: 0) + 1 }
+                        pending.clear()
+                    }
+                }
+                actions.forEach { store.dispatch(it) }
+            }
+        }
+    }
+}
