+let prefSaveIOTestRunning = false;
+
+async function runPrefSaveFileAsyncIOTest(scenario, allowProfileShutdown) {
+  const PREF = "test.librewolf.savePrefFileAsync.value";
+  function requireCondition(condition, message) {
