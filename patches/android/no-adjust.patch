-     * platform checks, so a length change needs no client update.
-     */
-    fun referralCodeFrom(utmContent: String): String? {
-        if (!utmContent.startsWith(REFERRAL_UTM_CONTENT_PREFIX)) {
-            return null
-        }
-
-        return utmContent.removePrefix(REFERRAL_UTM_CONTENT_PREFIX).ifEmpty { null }
-    }
-
-    /**
-     * Submits [referralCode] on the `referrals` ping, at most once per profile, and records it in [settings] for the
-     * debug drawer.
-     *
-     * @param referralCode The referral code, with the preamble already stripped.
-     * @param settings Application settings, used to record the code and that the ping has been submitted.
-     */
-    fun submit(referralCode: String, settings: Settings) {
-        settings.referralCode = referralCode
-
-        if (settings.referralPingSubmitted) {
-            return
-        }
-
-        Referrals.code.set(referralCode)
-        Pings.referrals.submit()
-        settings.referralPingSubmitted = true
-    }
-
-    /**
-     * [installReferrerResponse] with any referral-carrying `utm_content` parameter removed entirely, so that a referral
-     * install is indistinguishable from one that carried no `utm_content` at all. This matches the blanking of
-     * [UTMParams.content] in `InstallReferrerWorker.handleSuccess`: referral installs are counted from the `referrals`
-     * ping alone, never from attribution data. Returns the response unchanged when it carries no referral code.
-     *
-     * Every matching occurrence is dropped, not just the one [UTMParams.parseInstallReferrer] would have selected. That
-     * parser keeps the last value for a repeated key, so a malformed referrer repeating `utm_content` could otherwise
-     * leave a code behind in the raw response after the parsed copy was found clean.
