+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Redoubt LW-M7-45: the hard gate for "Delete browsing data on quit" at a cold
+// start. Owner decision 2026-10-06, link starts: "Yes, hard gate".
+//
+// Every page load needs an engine session, and every engine session of the
+// BrowserStore is created through EngineAction.CreateEngineSessionAction: the
+// restored tabs, a tab opened from a link (VIEW intent), a custom tab, a PWA, a
+// widget or shortcut search, and the follow-up of a LoadUrlAction on a tab that
+// has no session yet. While DeleteOnQuitGuard's cold-start gate is open the
+// middleware passes everything through. While it is closed, it holds those
+// creations and replays them, in order, through the store once the gate opens.
+// The gate is bounded (ENGINE_TIMEOUT_MS, then fail open), so nothing is held
+// longer than that. Nothing blocks the main thread: holding is a list, and the
+// replay is a coroutine.
+//
+// The middleware also strips the back/forward history (engineSessionState)
+// from the tabs of the session restore that follows a cold-start deletion of
+// HISTORY, as upstream's EngineAction.PurgeHistoryAction does on Quit.
+//
+// Same hold-and-replay shape as LibreWolfUboPreinstallMiddleware (LW-M3-07).
+
+package org.mozilla.fenix.lw
+
+import android.content.Context
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import mozilla.components.browser.state.action.BrowserAction
+import mozilla.components.browser.state.action.EngineAction
+import mozilla.components.browser.state.action.RestoreCompleteAction
+import mozilla.components.browser.state.action.TabListAction
+import mozilla.components.browser.state.state.BrowserState
+import mozilla.components.lib.state.Middleware
+import mozilla.components.lib.state.Store
+import mozilla.components.support.base.log.logger.Logger
+import java.util.IdentityHashMap
+
+/** Holds engine-session creation until the cold-start deletion is confirmed (or its bound passed). */
+class DeleteOnQuitStartGateMiddleware(
+    private val gate: () -> Job,
+    private val purgeRestoredHistory: () -> Boolean,
+    private val onRestoreComplete: () -> Unit,
+    private val scope: CoroutineScope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate),
+) : Middleware<BrowserState, BrowserAction> {
+    private val logger = Logger(DeleteOnQuitGuard.LOG_TAG)
+    private val lock = Any()
+    private val pending = mutableListOf<EngineAction.CreateEngineSessionAction>()
+    private val replays = IdentityHashMap<EngineAction.CreateEngineSessionAction, Int>()
+    private var waiting = false
+
+    override fun invoke(
+        store: Store<BrowserState, BrowserAction>,
+        next: (BrowserAction) -> Unit,
+        action: BrowserAction,
+    ) {
+        when (action) {
+            is EngineAction.CreateEngineSessionAction -> hold(store, next, action)
+            is TabListAction.RestoreAction -> next(withoutHistoryIfPurging(action))
+            is RestoreCompleteAction -> {
+                onRestoreComplete()
+                next(action)
+            }
+            else -> next(action)
+        }
+    }
+
+    private fun withoutHistoryIfPurging(action: TabListAction.RestoreAction): TabListAction.RestoreAction {
+        if (!purgeRestoredHistory() || action.tabs.none { it.engineSessionState != null }) return action
+        logger.warn("restore: dropping the back/forward history of ${action.tabs.size} restored tab(s) (HISTORY deleted)")
+        return action.copy(tabs = action.tabs.map { it.copy(engineSessionState = null) })
+    }
+
+    private fun hold(
+        store: Store<BrowserState, BrowserAction>,
+        next: (BrowserAction) -> Unit,
+        action: EngineAction.CreateEngineSessionAction,
+    ) {
+        val currentGate = gate()
+        val passThrough =
+            synchronized(lock) {
+                val replayCount = replays[action] ?: 0
+                when {
+                    replayCount > 0 -> {
+                        if (replayCount == 1) replays.remove(action) else replays[action] = replayCount - 1
+                        true
+                    }
+                    currentGate.isCompleted && !waiting && replays.isEmpty() -> true
+                    else -> {
+                        pending.add(action)
+                        logger.warn("holding engine session for tab ${action.tabId} until the on-quit deletion is confirmed")
+                        if (waiting) return
+                        waiting = true
+                        false
+                    }
+                }
+            }
+        if (passThrough) {
+            next(action)
+            return
+        }
+        scope.launch {
+            currentGate.join()
+            // Dispatch through the store again (never call a stored `next` later);
+            // a tab removed meanwhile is discarded by the normal session creation.
+            while (true) {
+                val actions =
+                    synchronized(lock) {
+                        if (pending.isEmpty()) {
+                            waiting = false
+                            return@launch
+                        }
+                        pending.toList().also { batch ->
+                            batch.forEach { replays[it] = (replays[it] ?: 0) + 1 }
+                            pending.clear()
+                        }
+                    }
+                logger.warn("gate open: releasing ${actions.size} held engine session(s)")
+                actions.forEach { store.dispatch(it) }
+            }
+        }
+    }
+
+    companion object {
+        /** The production instance; reads the process-wide guard lazily. */
+        fun create(context: Context): DeleteOnQuitStartGateMiddleware {
+            val app = context.applicationContext
+            return DeleteOnQuitStartGateMiddleware(
+                gate = { DeleteOnQuitGuard.get(app).coldStartGate },
+                purgeRestoredHistory = { DeleteOnQuitGuard.get(app).purgeRestoredHistory },
+                onRestoreComplete = { DeleteOnQuitGuard.get(app).onRestoreComplete() },
+            )
+        }
+    }
+}
