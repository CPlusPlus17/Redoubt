+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Redoubt LW-M7-45: the hard gate on every way a cold start can load a page
+// (restore, link, custom tab, PWA, widget), and the history purge of the
+// restore that follows a HISTORY deletion.
+
+package org.mozilla.fenix.lw
+
+import io.mockk.every
+import io.mockk.mockk
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import mozilla.components.browser.state.action.BrowserAction
+import mozilla.components.browser.state.action.ContentAction
+import mozilla.components.browser.state.action.CustomTabListAction
+import mozilla.components.browser.state.action.EngineAction
+import mozilla.components.browser.state.action.RestoreCompleteAction
+import mozilla.components.browser.state.action.TabListAction
+import mozilla.components.browser.state.state.BrowserState
+import mozilla.components.browser.state.state.createCustomTab
+import mozilla.components.browser.state.state.createTab
+import mozilla.components.browser.state.state.recover.RecoverableTab
+import mozilla.components.browser.state.state.recover.TabState
+import mozilla.components.concept.engine.EngineSessionState
+import mozilla.components.lib.state.Store
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.mozilla.fenix.settings.deletebrowsingdata.DeleteBrowsingDataOnQuitType.COOKIES
+import org.mozilla.fenix.settings.deletebrowsingdata.DeleteBrowsingDataOnQuitType.HISTORY
+import java.io.File
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class DeleteOnQuitStartGateMiddlewareTest {
+    @get:Rule val tmp = TemporaryFolder()
+
+    /** A store whose dispatch runs the middleware again, as BrowserStore does. */
+    private class Harness(val middleware: DeleteOnQuitStartGateMiddleware) {
+        val delivered = mutableListOf<BrowserAction>()
+        val redispatched = mutableListOf<BrowserAction>()
+        val store = mockk<Store<BrowserState, BrowserAction>>()
+
+        init {
+            every { store.dispatch(any()) } answers {
+                val action = firstArg<BrowserAction>()
+                redispatched.add(action)
+                middleware.invoke(store, { delivered.add(it) }, action)
+            }
+        }
+
+        fun send(action: BrowserAction) = middleware.invoke(store, { delivered.add(it) }, action)
+    }
+
+    private fun middleware(
+        gate: Job,
+        purge: () -> Boolean = { false },
+        restoreDone: () -> Unit = {},
+        scope: CoroutineScope,
+    ) = DeleteOnQuitStartGateMiddleware({ gate }, purge, restoreDone, scope)
+
+    private fun creation(tabId: String) = EngineAction.CreateEngineSessionAction(tabId)
+
+    @Test
+    fun `link, custom tab, PWA and restored tabs get no engine session before the gate opens`() = runTest {
+        val gate = Job()
+        val h = Harness(middleware(gate, scope = backgroundScope))
+        // A cold start through a VIEW intent: the tab is added and its load is
+        // requested; the load needs an engine session, which is held.
+        val linkTab = createTab("http://10.0.2.2:8765/report.html", id = "link")
+        val addLink = TabListAction.AddTabAction(linkTab, select = true)
+        val loadLink = EngineAction.LoadUrlAction("link", "http://10.0.2.2:8765/report.html")
+        val custom = createCustomTab("https://example.org/", id = "custom")
+        val addCustom = CustomTabListAction.AddCustomTabAction(custom)
+        val createLink = creation("link")
+        val createCustom = EngineAction.CreateEngineSessionAction("custom", includeParent = true)
+        val createPwa = EngineAction.CreateEngineSessionAction("pwa", skipLoading = false)
+        val createRestored = EngineAction.CreateEngineSessionAction("restored", skipLoading = true)
+
+        listOf(addLink, loadLink, createLink, addCustom, createCustom, createPwa, createRestored).forEach(h::send)
+        runCurrent()
+
+        // Tab bookkeeping passes; no engine session (so no load) is created.
+        assertEquals(listOf(addLink, loadLink, addCustom), h.delivered)
+        assertTrue(h.redispatched.isEmpty())
+
+        gate.complete()
+        runCurrent()
+
+        val held = listOf(createLink, createCustom, createPwa, createRestored)
+        assertEquals(held, h.redispatched)
+        assertEquals(listOf(addLink, loadLink, addCustom) + held, h.delivered)
+
+        // Once open, the gate costs nothing: creations pass straight through.
+        val later = creation("later")
+        h.send(later)
+        assertEquals(later, h.delivered.last())
+        assertEquals(held, h.redispatched)
+    }
+
+    @Test
+    fun `a creation arriving as the gate opens cannot overtake held ones`() = runTest {
+        val gate = Job()
+        val h = Harness(middleware(gate, scope = backgroundScope))
+        val first = creation("first")
+        val second = creation("second")
+        val racing = creation("arrived-before-replay")
+        h.send(first)
+        h.send(second)
+        runCurrent()
+
+        gate.complete()
+        // Invoked before the scheduled replay runs.
+        h.send(racing)
+        runCurrent()
+
+        assertEquals(listOf(first, second, racing), h.delivered)
+    }
+
+    @Test
+    fun `no deletion pending means nothing is held`() = runTest {
+        val h = Harness(middleware(Job().apply { complete() }, scope = backgroundScope))
+        val action = creation("tab")
+        h.send(action)
+        assertEquals(listOf(action), h.delivered)
+        assertTrue(h.redispatched.isEmpty())
+    }
+
+    @Test
+    fun `held loads are released when the deletion fails open after its bound`() {
+        // The real guard: Gecko never confirms, so the gate opens after the
+        // bound and the held link load proceeds (fail open, documented).
+        val marker = QuitMarkerFile(File(tmp.root, "redoubt_session_end"))
+        marker.write(QuitMarker(SessionEnd.RUNNING))
+        val runner =
+            object : DeleteOnQuitRunner {
+                override fun startEngineDeletion(
+                    types: Set<org.mozilla.fenix.settings.deletebrowsingdata.DeleteBrowsingDataOnQuitType>,
+                    scope: CoroutineScope,
+                ) = CompletableDeferred<Boolean>()
+
+                override suspend fun deleteAppData(
+                    types: Set<org.mozilla.fenix.settings.deletebrowsingdata.DeleteBrowsingDataOnQuitType>,
+                    live: Boolean,
+                ) = true
+            }
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined)
+        val guard =
+            DeleteOnQuitGuard(
+                marker = marker,
+                selectedTypes = { setOf(COOKIES) },
+                runner = runner,
+                scope = scope,
+                ioDispatcher = Dispatchers.Unconfined,
+                appDataTimeoutMs = 100,
+                engineTimeoutMs = 200,
+            )
+        val h =
+            Harness(
+                DeleteOnQuitStartGateMiddleware(
+                    { guard.coldStartGate },
+                    { guard.purgeRestoredHistory },
+                    { guard.onRestoreComplete() },
+                    scope,
+                ),
+            )
+        guard.onColdStart()
+        val link = creation("link")
+        h.send(link)
+        assertTrue("held while Gecko has not confirmed", h.delivered.isEmpty())
+
+        runBlocking { guard.coldStartGate.join() }
+        runBlocking { kotlinx.coroutines.delay(50) }
+        assertEquals(listOf(link), h.delivered)
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+    }
+
+    @Test
+    fun `the restore after a HISTORY deletion comes back without back-forward history`() = runTest {
+        var purge = true
+        var restoreDone = 0
+        val h =
+            Harness(
+                middleware(
+                    Job().apply { complete() },
+                    purge = { purge },
+                    restoreDone = {
+                        restoreDone++
+                        purge = false
+                    },
+                    scope = backgroundScope,
+                ),
+            )
+        val history = mockk<EngineSessionState>()
+        val restore =
+            TabListAction.RestoreAction(
+                tabs =
+                    listOf(
+                        RecoverableTab(history, TabState(id = "a", url = "http://10.0.2.2:8765/b.html", title = "b")),
+                        RecoverableTab(null, TabState(id = "b", url = "https://example.org/")),
+                    ),
+                selectedTabId = "a",
+                restoreLocation = TabListAction.RestoreAction.RestoreLocation.BEGINNING,
+            )
+        h.send(restore)
+        val sent = h.delivered.single() as TabListAction.RestoreAction
+        // Same tabs, same urls, same selection: only the engine state (the
+        // back/forward history) is gone, as after EngineAction.PurgeHistoryAction.
+        assertEquals(restore.tabs.map { it.state }, sent.tabs.map { it.state })
+        assertTrue(sent.tabs.all { it.engineSessionState == null })
+        assertEquals("a", sent.selectedTabId)
+
+        h.send(RestoreCompleteAction)
+        assertEquals(1, restoreDone)
+        assertSame(RestoreCompleteAction, h.delivered.last())
+
+        // After the restore completed (or with no HISTORY deletion) restores are untouched.
+        h.send(restore)
+        assertSame(restore, h.delivered.last())
+        assertNotNull((h.delivered.last() as TabListAction.RestoreAction).tabs[0].engineSessionState)
+    }
+
+    @Test
+    fun `the guard asks for the purge only for HISTORY and clears it at restore complete`() {
+        val marker = QuitMarkerFile(File(tmp.root, "m"))
+        marker.write(QuitMarker(SessionEnd.RUNNING))
+        val runner =
+            object : DeleteOnQuitRunner {
+                override fun startEngineDeletion(
+                    types: Set<org.mozilla.fenix.settings.deletebrowsingdata.DeleteBrowsingDataOnQuitType>,
+                    scope: CoroutineScope,
+                ) = CompletableDeferred(true)
+
+                override suspend fun deleteAppData(
+                    types: Set<org.mozilla.fenix.settings.deletebrowsingdata.DeleteBrowsingDataOnQuitType>,
+                    live: Boolean,
+                ) = true
+            }
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined)
+        val guard =
+            DeleteOnQuitGuard(marker, { setOf(HISTORY) }, runner, scope, Dispatchers.Unconfined)
+        val m = DeleteOnQuitStartGateMiddleware({ guard.coldStartGate }, { guard.purgeRestoredHistory }, { guard.onRestoreComplete() }, scope)
+        val h = Harness(m)
+        guard.onColdStart()
+        runBlocking { guard.coldStartGate.join() }
+        assertTrue(guard.purgeRestoredHistory)
+        h.send(RestoreCompleteAction)
+        assertFalse(guard.purgeRestoredHistory)
+    }
+
+    @Test
+    fun `other actions are never held`() = runTest {
+        val h = Harness(middleware(Job(), scope = backgroundScope))
+        val actions =
+            listOf(
+                ContentAction.UpdateTitleAction("t", "title"),
+                RestoreCompleteAction,
+                EngineAction.PurgeHistoryAction,
+            )
+        actions.forEach(h::send)
+        assertEquals(actions, h.delivered)
+        assertFalse(h.redispatched.isNotEmpty())
+    }
+}
