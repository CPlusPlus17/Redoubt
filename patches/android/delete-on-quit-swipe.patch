+
+/** How the last session ended, as far as the marker file knows. */
+enum class SessionEnd(val token: String) {
+    /** Quit ran and its deletion was confirmed. */
+    CLEAN("clean"),
+
+    /** A session is (or was) in progress. */
+    RUNNING("running"),
+
+    /** A start-up deletion began and has not finished. */
+    CLEANING("cleaning"),
+}
+
+/** The marker's content. [attempts] counts start-up deletions begun since the last one that finished. */
+data class QuitMarker(val state: SessionEnd, val attempts: Int = 0)
+
+/**
+ * The marker file. Writes are atomic: the new content goes to a temporary
+ * file in the same directory, is fsync'ed, and replaces the marker with
+ * rename(2). A reader sees the old marker or the new one, never a torn one.
+ */
+class QuitMarkerFile(private val file: File) {
+    /** Returns null when there is no marker. Unreadable content reads as [SessionEnd.RUNNING]: unclean. */
+    fun read(): QuitMarker? {
+        if (!file.exists()) return null
+        val text =
+            try {
+                file.readText()
+            } catch (e: IOException) {
+                return QuitMarker(SessionEnd.RUNNING)
+            }
+        val fields =
+            text.lineSequence()
+                .mapNotNull { line -> line.split('=', limit = 2).takeIf { it.size == 2 } }
+                .associate { (k, v) -> k.trim() to v.trim() }
+        val state = SessionEnd.entries.firstOrNull { it.token == fields["state"] } ?: return QuitMarker(SessionEnd.RUNNING)
+        val attempts = fields["attempts"]?.toIntOrNull()?.coerceAtLeast(0) ?: 0
+        return QuitMarker(state, attempts)
+    }
+
+    /** Atomically replaces the marker. */
+    @Throws(IOException::class)
+    fun write(marker: QuitMarker) {
+        val dir = file.absoluteFile.parentFile ?: throw IOException("no parent for $file")
+        if (!dir.isDirectory && !dir.mkdirs()) throw IOException("cannot create $dir")
+        val tmp = File(dir, file.name + ".tmp")
+        FileOutputStream(tmp).use { out ->
+            out.write("format=1\nstate=${marker.state.token}\nattempts=${marker.attempts}\n".toByteArray())
+            out.flush()
+            out.fd.sync()
+        }
+        if (!tmp.renameTo(file)) {
+            tmp.delete()
+            throw IOException("rename $tmp -> $file failed")
+        }
+    }
+}
+
+/** What a cold start does about the last session. */
+sealed class StartupDecision {
+    /** Nothing to delete: the setting is off, or the last session ended through Quit. */
+    data class Skip(val reason: String) : StartupDecision()
+
+    /** Run the deletion; [attempt] is 1 for the first try. */
+    data class Run(val attempt: Int) : StartupDecision()
+
+    /** Earlier attempts died mid-deletion; continue without deleting. */
+    data class GiveUp(val attempts: Int) : StartupDecision()
+}
+
+/** The cold-start rule, kept free of Android so it can be tested on its own. */
+fun decideAtStartup(
+    marker: QuitMarker?,
+    enabled: Boolean,
+    maxAttempts: Int = DeleteOnQuitGuard.MAX_ATTEMPTS,
+): StartupDecision =
+    when {
+        !enabled -> StartupDecision.Skip("setting off")
+        marker == null -> StartupDecision.Run(1)
+        marker.state == SessionEnd.CLEAN -> StartupDecision.Skip("last session ended with Quit")
+        marker.state == SessionEnd.RUNNING -> StartupDecision.Run(1)
+        marker.attempts >= maxAttempts -> StartupDecision.GiveUp(marker.attempts)
+        else -> StartupDecision.Run(marker.attempts + 1)
+    }
+
+/** Performs the deletion for a set of categories. */
+interface DeleteOnQuitRunner {
+    /**
+     * Issues every engine-side deletion for [types] before it returns, and
+     * returns a Deferred that completes with true when the engine confirmed
+     * all of them.
+     */
+    fun startEngineDeletion(types: Set<DeleteBrowsingDataOnQuitType>, scope: CoroutineScope): Deferred<Boolean>
+
+    /**
+     * Deletes the app-side data for [types]. [live] is false at a cold start,
+     * before anything was restored; true when a running session ends, where the
+     * in-memory state (open tabs, downloads list) is cleared too.
+     */
+    suspend fun deleteAppData(types: Set<DeleteBrowsingDataOnQuitType>, live: Boolean): Boolean
+}
+
+/** Ties the marker, the setting and the runner together. One instance per process. */
+@Suppress("LongParameterList")
+class DeleteOnQuitGuard(
+    private val marker: QuitMarkerFile,
+    private val selectedTypes: () -> Set<DeleteBrowsingDataOnQuitType>,
+    private val runner: DeleteOnQuitRunner,
+    private val scope: CoroutineScope,
+    private val ioDispatcher: CoroutineDispatcher = Dispatchers.IO,
+    private val appDataTimeoutMs: Long = APP_DATA_TIMEOUT_MS,
+    private val engineTimeoutMs: Long = ENGINE_TIMEOUT_MS,
+    private val maxAttempts: Int = MAX_ATTEMPTS,
+) {
+    private val logger = Logger(LOG_TAG)
+    private val lock = Any()
+    private var foregroundEpoch = 0
+    private var lastWritten: QuitMarker? = null
+
+    /** What session and downloads restore wait for; complete when there is nothing to wait for. */
+    @Volatile var coldStartGate: Job = completedJob()
+        private set
+
+    /**
+     * Called from Application.onCreate on the main thread, before the session
+     * store is restored. Returns the Job that restore must wait for.
+     */
+    fun onColdStart(): Job = coldStart().also { coldStartGate = it }
+
+    private fun coldStart(): Job {
+        val types = selectedTypes()
+        val current = marker.read()
+        val decision = decideAtStartup(current, types.isNotEmpty(), maxAttempts)
+        synchronized(lock) { lastWritten = current }
+        when (decision) {
+            is StartupDecision.Skip -> {
+                logger.info("cold start: no deletion (${decision.reason}); marker was ${describe(current)}")
+                markRunning()
+                return completedJob()
+            }
+            is StartupDecision.GiveUp -> {
+                logger.error(
+                    "cold start: ${decision.attempts} deletion attempts did not finish; " +
+                        "continuing WITHOUT deleting ${names(types)}"
+                )
+                markRunning()
+                return completedJob()
+            }
+            is StartupDecision.Run -> {
+                logger.warn(
+                    "cold start after unclean exit (marker ${describe(current)}): deleting ${names(types)} " +
+                        "before session restore, attempt ${decision.attempt}/$maxAttempts"
+                )
+                writeMarker(QuitMarker(SessionEnd.CLEANING, decision.attempt))
+                val engine = startEngine(types)
+                // The local stores are deleted on the IO dispatcher; the main
+                // thread only WAITS for them, bounded. Only the wait is under
+                // runBlocking, so a step that needs the main thread cannot
+                // deadlock start-up: the wait times out and the gate below
+                // keeps waiting for the step off the main thread.
+                val local = scope.async(ioDispatcher) { runner.deleteAppData(types, live = false) }
+                val appOkNow = runBlocking { awaitDeferred(local, appDataTimeoutMs) }
+                logger.info("cold start: app-side deletion done (ok=$appOkNow); waiting for the engine")
+                return scope.launch {
+                    val appOk = appOkNow || awaitDeferred(local, engineTimeoutMs)
+                    val engineOk = withTimeoutOrNull(engineTimeoutMs) { engine.await() } ?: false
+                    if (appOk && engineOk) {
+                        logger.warn("cold start: deletion complete; session restore may proceed")
+                    } else {
+                        logger.error("cold start: deletion incomplete (app=$appOk engine=$engineOk); continuing")
+                    }
+                    markRunning()
+                }
+            }
+        }
+    }
+
+    /** ProcessLifecycleOwner ON_START: a session is in use again. */
+    fun onForeground() {
+        synchronized(lock) {
+            foregroundEpoch++
+            if (lastWritten?.state == SessionEnd.CLEAN) {
+                writeMarkerLocked(QuitMarker(SessionEnd.RUNNING))
+            }
+        }
+    }
+
+    /** True when the user has the feature on with at least one category. */
+    fun isEnabled(): Boolean = selectedTypes().isNotEmpty()
+
+    /**
+     * The session is ending through Quit ([reason] "quit") or a task removal
+     * ("task-removed"). Starts the deletion without blocking the caller and
+     * writes "clean" once every part of it was confirmed -- unless the app came
+     * back to the foreground meanwhile.
+     */
+    fun onSessionEnding(reason: String): Job {
+        val types = selectedTypes()
+        if (types.isEmpty()) {
+            logger.info("$reason: setting off, nothing to do")
+            return completedJob()
+        }
+        val epoch = synchronized(lock) { foregroundEpoch }
+        logger.warn("$reason: deleting ${names(types)}")
+        val engine = startEngine(types)
+        return scope.launch {
+            val appOk =
+                try {
+                    withTimeoutOrNull(appDataTimeoutMs) {
+                        withContext(ioDispatcher) { runner.deleteAppData(types, live = true) }
+                    } ?: false
+                } catch (e: Exception) {
+                    logger.error("$reason: app-side deletion failed", e)
+                    false
+                }
+            val engineOk = withTimeoutOrNull(engineTimeoutMs) { engine.await() } ?: false
+            synchronized(lock) {
+                when {
+                    !(appOk && engineOk) ->
+                        logger.error("$reason: deletion incomplete (app=$appOk engine=$engineOk); marker stays unclean")
+                    epoch != foregroundEpoch ->
+                        logger.info("$reason: app returned to the foreground; marker stays unclean")
+                    else -> {
+                        writeMarkerLocked(QuitMarker(SessionEnd.CLEAN))
+                        logger.warn("$reason: deletion confirmed; marked clean")
+                    }
+                }
+            }
+        }
+    }
+
+    private suspend fun awaitDeferred(d: Deferred<Boolean>, timeoutMs: Long): Boolean =
+        try {
+            withTimeoutOrNull(timeoutMs) { d.await() } ?: false
+        } catch (e: Exception) {
+            logger.error("app-side deletion failed", e)
+            false
+        }
+
+    private fun startEngine(types: Set<DeleteBrowsingDataOnQuitType>): Deferred<Boolean> =
+        try {
+            runner.startEngineDeletion(types, scope)
+        } catch (e: Exception) {
+            logger.error("engine deletion could not be started", e)
+            CompletableDeferred(false)
+        }
+
+    private fun markRunning() {
+        synchronized(lock) {
+            if (lastWritten != QuitMarker(SessionEnd.RUNNING)) {
+                writeMarkerLocked(QuitMarker(SessionEnd.RUNNING))
+            }
+        }
+    }
+
+    private fun writeMarker(value: QuitMarker) = synchronized(lock) { writeMarkerLocked(value) }
+
+    private fun writeMarkerLocked(value: QuitMarker) {
+        try {
+            marker.write(value)
+            lastWritten = value
+        } catch (e: IOException) {
+            // An unwritten "running" or "cleaning" leaves the previous marker,
+            // which is never "clean" while a session runs except in the window
+            // right after Quit; an unwritten "clean" only costs one extra
+            // deletion at the next start.
+            logger.error("marker write failed (${value.state.token})", e)
+        }
+    }
+
+    private fun describe(m: QuitMarker?) = m?.let { "${it.state.token}/${it.attempts}" } ?: "absent"
+
+    private fun names(types: Set<DeleteBrowsingDataOnQuitType>) = types.joinToString(",") { it.name }
+
+    private fun completedJob(): Job = Job().apply { complete() }
+
+    companion object {
+        const val LOG_TAG = "RedoubtDeleteOnQuit"
+        const val MAX_ATTEMPTS = 3
+        const val APP_DATA_TIMEOUT_MS = 5_000L
+        const val ENGINE_TIMEOUT_MS = 20_000L
+        const val MARKER_FILE = "redoubt_session_end"
+
+        @Volatile private var instance: DeleteOnQuitGuard? = null
+
+        /** The process-wide guard. */
+        fun get(context: Context): DeleteOnQuitGuard =
+            instance ?: synchronized(this) {
+                instance ?: create(context.applicationContext).also { instance = it }
+            }
+
+        private fun create(context: Context): DeleteOnQuitGuard =
+            DeleteOnQuitGuard(
+                marker = QuitMarkerFile(File(context.noBackupFilesDir, MARKER_FILE)),
+                selectedTypes = {
+                    val settings = context.components.settings
+                    if (!settings.shouldDeleteBrowsingDataOnQuit) {
+                        emptySet()
+                    } else {
+                        DeleteBrowsingDataOnQuitType.entries.filter { settings.getDeleteDataOnQuit(it) }.toSet()
+                    }
+                },
+                runner = DefaultDeleteOnQuitRunner(context),
+                scope = CoroutineScope(SupervisorJob() + Dispatchers.Main),
+            )
+    }
+}
+
+/**
+ * The deletion itself: the same categories and engine flags as upstream's
+ * DefaultDeleteBrowsingDataController, but every engine call is awaited, and
+ * the app-side stores are deleted directly so nothing depends on store
+ * middleware that runs later.
+ */
+class DefaultDeleteOnQuitRunner(private val context: Context) : DeleteOnQuitRunner {
+    private val logger = Logger(DeleteOnQuitGuard.LOG_TAG)
+    private val core get() = context.components.core
+
+    override fun startEngineDeletion(
+        types: Set<DeleteBrowsingDataOnQuitType>,
+        scope: CoroutineScope,
+    ): Deferred<Boolean> {
+        val engine = core.engine
+        val calls = mutableListOf<Deferred<Boolean>>()
+        fun clear(name: String, data: Int) {
+            calls += engineCall(name) { ok, err -> engine.clearData(Engine.BrowsingData.select(data), null, ok, err) }
+        }
+        for (type in types) {
+            when (type) {
+                DeleteBrowsingDataOnQuitType.COOKIES -> {
+                    clear("cookies", Engine.BrowsingData.COOKIES or Engine.BrowsingData.AUTH_SESSIONS)
+                    clear("dom-storages", Engine.BrowsingData.DOM_STORAGES)
+                }
+                DeleteBrowsingDataOnQuitType.CACHE -> {
+                    clear("caches", Engine.BrowsingData.ALL_CACHES)
+                    // Not counted: an engine without translations support reports an error every time.
+                    engineCall("translation-models") { ok, err ->
+                        engine.manageTranslationsLanguageModel(
+                            ModelManagementOptions(operation = ModelOperation.DELETE, operationLevel = OperationLevel.CACHE),
+                            ok,
+                            err,
+                        )
+                    }
+                }
+                DeleteBrowsingDataOnQuitType.PERMISSIONS -> {
+                    clear("site-settings", Engine.BrowsingData.ALL_SITE_SETTINGS)
+                    calls += scope.async {
+                        try {
+                            core.permissionStorage.deleteAllSitePermissions()
+                            logger.info("site permissions storage cleared")
+                            true
+                        } catch (e: Exception) {
+                            logger.error("deleting site permissions storage failed", e)
+                            false
+                        }
+                    }
+                }
+                DeleteBrowsingDataOnQuitType.HISTORY ->
+                    calls += engineCall("tracking-protection-data") { ok, err -> engine.clearTrackingProtectionData(ok, err) }
+                DeleteBrowsingDataOnQuitType.TABS, DeleteBrowsingDataOnQuitType.DOWNLOADS -> Unit
+            }
+        }
+        return scope.async { calls.map { it.await() }.all { it } }
+    }
+
+    override suspend fun deleteAppData(types: Set<DeleteBrowsingDataOnQuitType>, live: Boolean): Boolean {
+        var ok = true
+        suspend fun step(name: String, block: suspend () -> Unit) {
+            try {
+                block()
+            } catch (e: Exception) {
+                logger.error("deleting $name failed", e)
+                ok = false
+            }
+        }
+        val store = core.store
+        for (type in types) {
+            when (type) {
+                DeleteBrowsingDataOnQuitType.TABS -> {
+                    if (live) step("open tabs") { context.components.useCases.tabsUseCases.removeAllTabs(false) }
+                    step("session file") { core.sessionStorage.clear() }
+                    step("thumbnails") { core.thumbnailStorage.clearThumbnails().join() }
+                }
+                DeleteBrowsingDataOnQuitType.HISTORY -> {
+                    step("history") { core.historyStorage.deleteEverything() }
+                    step("recently closed tabs") { core.recentlyClosedTabsStorage.value.removeAllTabs() }
+                    if (live) {
+                        step("history state") {
+                            store.dispatch(EngineAction.PurgeHistoryAction)
+                            store.dispatch(RecentlyClosedAction.RemoveAllClosedTabAction)
+                        }
+                    }
+                }
+                // PERMISSIONS: Fenix's PermissionStorage is backed by Gecko's
+                // site-permission storage and needs the main thread, so it runs
+                // in startEngineDeletion, never in this (possibly awaited from
+                // the main thread) step.
+                DeleteBrowsingDataOnQuitType.DOWNLOADS -> {
+                    if (live) step("downloads list") { context.components.useCases.downloadUseCases.removeAllDownloads() }
+                    step("downloads database") { DownloadStorage(context).removeAllDownloads() }
+                }
+                DeleteBrowsingDataOnQuitType.COOKIES, DeleteBrowsingDataOnQuitType.CACHE,
+                DeleteBrowsingDataOnQuitType.PERMISSIONS -> Unit
+            }
+        }
+        return ok
+    }
+
+    private fun engineCall(
+        name: String,
+        call: (onSuccess: () -> Unit, onError: (Throwable) -> Unit) -> Unit,
+    ): Deferred<Boolean> {
+        val result = CompletableDeferred<Boolean>()
+        try {
+            call(
+                {
+                    logger.info("engine: $name cleared")
+                    result.complete(true)
+                },
+                { e ->
+                    logger.warn("engine: clearing $name failed: $e")
+                    result.complete(false)
+                },
+            )
+        } catch (e: Exception) {
+            logger.error("engine: clearing $name threw", e)
+            result.complete(false)
+        }
+        return result
+    }
+}
+
+/**
+ * Best-effort half (a). A plain started service with stopWithTask="false":
+ * Android delivers onTaskRemoved when the task is swiped away while it runs.
+ * It holds no notification and does no work of its own; Android stops it about
+ * a minute after the app went to the background, after which only (b) applies.
+ */
+class DeleteOnQuitTaskService : Service() {
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int = START_NOT_STICKY
+
+    override fun onTaskRemoved(rootIntent: Intent?) {
+        Logger(DeleteOnQuitGuard.LOG_TAG).warn("onTaskRemoved: task swiped away")
+        DeleteOnQuitGuard.get(this).onSessionEnding("task-removed")
+        stopSelf()
+    }
+
+    companion object {
+        /** Call while the app is in the foreground. Never throws. */
+        fun sync(context: Context, enabled: Boolean) {
+            val intent = Intent(context, DeleteOnQuitTaskService::class.java)
+            try {
+                if (enabled) context.startService(intent) else context.stopService(intent)
+            } catch (e: IllegalStateException) {
+                Logger(DeleteOnQuitGuard.LOG_TAG).warn("task service not (re)started: $e")
+            } catch (e: SecurityException) {
+                Logger(DeleteOnQuitGuard.LOG_TAG).warn("task service not (re)started: $e")
+            }
+        }
+    }
+}
+
+/** ProcessLifecycleOwner hook, registered by FenixApplication. */
+@VisibleForTesting
+fun onAppForeground(context: Context) {
+    val guard = DeleteOnQuitGuard.get(context)
+    guard.onForeground()
+    DeleteOnQuitTaskService.sync(context, guard.isEnabled())
+}
