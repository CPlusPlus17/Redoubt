+
+// Redoubt LW-M7-45: the marker, the cold-start rule and the guard's state
+// machine. The deletion itself (DefaultDeleteOnQuitRunner) is exercised on a
+// device; see docs/android/evidence/lw-m7-45/.
+
+package org.mozilla.fenix.lw
+
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Deferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.mozilla.fenix.settings.deletebrowsingdata.DeleteBrowsingDataOnQuitType
+import org.mozilla.fenix.settings.deletebrowsingdata.DeleteBrowsingDataOnQuitType.CACHE
+import org.mozilla.fenix.settings.deletebrowsingdata.DeleteBrowsingDataOnQuitType.COOKIES
+import org.mozilla.fenix.settings.deletebrowsingdata.DeleteBrowsingDataOnQuitType.TABS
+import java.io.File
+
+class DeleteOnQuitGuardTest {
+    @get:Rule val tmp = TemporaryFolder()
+
+    private lateinit var file: File
+    private lateinit var marker: QuitMarkerFile
+
+    /** Records calls; the engine half completes only when [engine] is completed. */
+    private inner class FakeRunner(
+        var engine: CompletableDeferred<Boolean> = CompletableDeferred(true),
+        var appOk: Boolean = true,
+        var appThrows: Boolean = false,
+        var appBlocker: CompletableDeferred<Unit>? = null,
+    ) : DeleteOnQuitRunner {
+        val engineCalls = mutableListOf<Set<DeleteBrowsingDataOnQuitType>>()
+        val appCalls = mutableListOf<Pair<Set<DeleteBrowsingDataOnQuitType>, Boolean>>()
+        val markerSeenByEngine = mutableListOf<QuitMarker?>()
+
+        override fun startEngineDeletion(
+            types: Set<DeleteBrowsingDataOnQuitType>,
+            scope: CoroutineScope,
+        ): Deferred<Boolean> {
+            engineCalls += types
+            markerSeenByEngine += marker.read()
+            return engine
+        }
+
+        override suspend fun deleteAppData(types: Set<DeleteBrowsingDataOnQuitType>, live: Boolean): Boolean {
+            appCalls += types to live
+            appBlocker?.await()
+            if (appThrows) throw IllegalStateException("boom")
+            return appOk
+        }
+    }
+
+    private var selected: Set<DeleteBrowsingDataOnQuitType> = setOf(COOKIES, CACHE, TABS)
+
+    private fun guard(
+        runner: DeleteOnQuitRunner,
+        engineTimeoutMs: Long = 2_000,
+        appDataTimeoutMs: Long = 2_000,
+        scope: CoroutineScope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined),
+    ) =
+        DeleteOnQuitGuard(
+            marker = marker,
+            selectedTypes = { selected },
+            runner = runner,
+            scope = scope,
+            ioDispatcher = Dispatchers.Unconfined,
+            appDataTimeoutMs = appDataTimeoutMs,
+            engineTimeoutMs = engineTimeoutMs,
+        )
+
+    @Before
+    fun setUp() {
+        file = File(tmp.root, "sub/redoubt_session_end")
+        marker = QuitMarkerFile(file)
+    }
+
+    // --- marker file -------------------------------------------------------
+
+    @Test
+    fun `absent marker reads as null`() {
+        assertNull(marker.read())
+    }
+
+    @Test
+    fun `marker round-trips and leaves no temporary file`() {
+        marker.write(QuitMarker(SessionEnd.CLEANING, 2))
+        assertEquals(QuitMarker(SessionEnd.CLEANING, 2), marker.read())
+        marker.write(QuitMarker(SessionEnd.CLEAN))
+        assertEquals(QuitMarker(SessionEnd.CLEAN, 0), marker.read())
+        assertEquals(listOf("redoubt_session_end"), file.parentFile!!.list()!!.toList())
+    }
+
+    @Test
+    fun `unreadable or unknown marker content counts as unclean`() {
+        file.parentFile!!.mkdirs()
+        file.writeText("garbage")
+        assertEquals(SessionEnd.RUNNING, marker.read()!!.state)
+        file.writeText("state=clean-ish\n")
+        assertEquals(SessionEnd.RUNNING, marker.read()!!.state)
+        file.writeText("state=cleaning\nattempts=-4\n")
+        assertEquals(QuitMarker(SessionEnd.CLEANING, 0), marker.read())
+    }
+
+    @Test
+    fun `a torn temporary file never replaces the marker`() {
+        marker.write(QuitMarker(SessionEnd.CLEAN))
+        File(file.parentFile, file.name + ".tmp").writeText("state=run")
+        assertEquals(QuitMarker(SessionEnd.CLEAN), marker.read())
+    }
+
+    // --- cold-start rule ---------------------------------------------------
+
+    @Test
+    fun `startup decision table`() {
+        val clean = QuitMarker(SessionEnd.CLEAN)
+        val running = QuitMarker(SessionEnd.RUNNING)
+        for (m in listOf(null, clean, running, QuitMarker(SessionEnd.CLEANING, 9))) {
+            assertTrue(decideAtStartup(m, enabled = false) is StartupDecision.Skip)
+        }
+        assertEquals(StartupDecision.Run(1), decideAtStartup(null, enabled = true))
+        assertTrue(decideAtStartup(clean, enabled = true) is StartupDecision.Skip)
+        assertEquals(StartupDecision.Run(1), decideAtStartup(running, enabled = true))
+        assertEquals(StartupDecision.Run(2), decideAtStartup(QuitMarker(SessionEnd.CLEANING, 1), true, 3))
+        assertEquals(StartupDecision.Run(3), decideAtStartup(QuitMarker(SessionEnd.CLEANING, 2), true, 3))
+        assertEquals(StartupDecision.GiveUp(3), decideAtStartup(QuitMarker(SessionEnd.CLEANING, 3), true, 3))
+    }
+
+    // --- cold start --------------------------------------------------------
+
+    @Test
+    fun `unclean exit deletes before restore and records the attempt first`() {
+        marker.write(QuitMarker(SessionEnd.RUNNING))
+        val runner = FakeRunner(engine = CompletableDeferred())
+        val g = guard(runner)
+        assertTrue(g.coldStartGate.isCompleted)
+        val gate = g.onColdStart()
+        assertTrue(gate === g.coldStartGate)
+
+        assertEquals(listOf(selected), runner.engineCalls)
+        assertEquals(listOf(selected to false), runner.appCalls)
+        // The attempt was on disk before any deletion started.
+        assertEquals(listOf<QuitMarker?>(QuitMarker(SessionEnd.CLEANING, 1)), runner.markerSeenByEngine)
+        // Restore waits for the engine.
+        assertFalse(gate.isCompleted)
+        assertEquals(QuitMarker(SessionEnd.CLEANING, 1), marker.read())
+
+        runner.engine.complete(true)
+        runBlocking { gate.join() }
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+    }
+
+    @Test
+    fun `missing marker with the setting on counts as unclean`() {
+        val runner = FakeRunner()
+        runBlocking { guard(runner).onColdStart().join() }
+        assertEquals(1, runner.engineCalls.size)
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+    }
+
+    @Test
+    fun `setting off deletes nothing whatever the marker says`() {
+        selected = emptySet()
+        for (m in listOf(null, QuitMarker(SessionEnd.RUNNING), QuitMarker(SessionEnd.CLEANING, 1))) {
+            if (m == null) file.delete() else marker.write(m)
+            val runner = FakeRunner()
+            val gate = guard(runner).onColdStart()
+            assertTrue(gate.isCompleted)
+            assertTrue(runner.engineCalls.isEmpty())
+            assertTrue(runner.appCalls.isEmpty())
+            assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+        }
+    }
+
+    @Test
+    fun `clean quit skips the deletion and marks the new session running`() {
+        marker.write(QuitMarker(SessionEnd.CLEAN))
+        val runner = FakeRunner()
+        assertTrue(guard(runner).onColdStart().isCompleted)
+        assertTrue(runner.engineCalls.isEmpty())
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+    }
+
+    @Test
+    fun `a deletion that keeps killing the process is retried a bounded number of times`() {
+        // Each "process" dies during the deletion: the engine never confirms
+        // and the gate is abandoned, so the marker keeps saying "cleaning".
+        for (attempt in 1..DeleteOnQuitGuard.MAX_ATTEMPTS) {
+            val runner = FakeRunner(engine = CompletableDeferred())
+            val process = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined)
+            guard(runner, scope = process).onColdStart()
+            assertEquals(1, runner.engineCalls.size)
+            assertEquals(QuitMarker(SessionEnd.CLEANING, attempt), marker.read())
+            process.cancel() // the process dies
+        }
+        val runner = FakeRunner()
+        val gate = guard(runner).onColdStart()
+        assertTrue(gate.isCompleted)
+        assertTrue("gave up: no further attempt", runner.engineCalls.isEmpty())
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+        // The next unclean exit starts counting again.
+        val next = FakeRunner()
+        runBlocking { guard(next).onColdStart().join() }
+        assertEquals(1, next.engineCalls.size)
+    }
+
+    @Test
+    fun `engine that never answers does not hold restore forever`() {
+        marker.write(QuitMarker(SessionEnd.RUNNING))
+        val runner = FakeRunner(engine = CompletableDeferred())
+        val gate = guard(runner, engineTimeoutMs = 50).onColdStart()
+        runBlocking { gate.join() }
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+    }
+
+    @Test
+    fun `a local step that never returns does not hold the main thread`() {
+        // Found on the device: a step that needed the main thread deadlocked
+        // onColdStart. The main thread now only waits, bounded; restore keeps
+        // waiting for the step off the main thread.
+        marker.write(QuitMarker(SessionEnd.RUNNING))
+        val blocker = CompletableDeferred<Unit>()
+        val runner = FakeRunner(appBlocker = blocker)
+        val gate = guard(runner, appDataTimeoutMs = 50).onColdStart()
+        assertFalse("restore still waits for the local step", gate.isCompleted)
+        assertEquals(QuitMarker(SessionEnd.CLEANING, 1), marker.read())
+        blocker.complete(Unit)
+        runBlocking { gate.join() }
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+    }
+
+    @Test
+    fun `app-side failure is contained`() {
+        val runner = FakeRunner(appThrows = true)
+        runBlocking { guard(runner).onColdStart().join() }
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+    }
+
+    // --- session end -------------------------------------------------------
+
+    @Test
+    fun `quit marks clean only after the deletion is confirmed`() {
+        val runner = FakeRunner(engine = CompletableDeferred())
+        val g = guard(runner)
+        runBlocking { g.onColdStart().also { runner.engine.complete(true) }.join() }
+
+        runner.engine = CompletableDeferred()
+        val job = g.onSessionEnding("quit")
+        assertEquals(selected to true, runner.appCalls.last())
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+        runner.engine.complete(true)
+        runBlocking { job.join() }
+        assertEquals(QuitMarker(SessionEnd.CLEAN), marker.read())
+
+        // Back in the foreground after Quit: the session is running again.
+        g.onForeground()
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+    }
+
+    @Test
+    fun `quit whose deletion fails stays unclean`() {
+        val runner = FakeRunner()
+        val g = guard(runner)
+        runBlocking { g.onColdStart().join() }
+        runner.engine = CompletableDeferred(false)
+        runBlocking { g.onSessionEnding("quit").join() }
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+
+        runner.engine = CompletableDeferred(true)
+        runner.appOk = false
+        runBlocking { g.onSessionEnding("quit").join() }
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+    }
+
+    @Test
+    fun `returning to the foreground before the deletion finished keeps the marker unclean`() {
+        val runner = FakeRunner()
+        val g = guard(runner)
+        runBlocking { g.onColdStart().join() }
+        runner.engine = CompletableDeferred()
+        val job = g.onSessionEnding("task-removed")
+        g.onForeground()
+        runner.engine.complete(true)
+        runBlocking { job.join() }
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+    }
+
+    @Test
+    fun `session end with the setting off does nothing`() {
+        val runner = FakeRunner()
+        val g = guard(runner)
+        runBlocking { g.onColdStart().join() }
+        selected = emptySet()
+        val calls = runner.engineCalls.size
+        runBlocking { g.onSessionEnding("task-removed").join() }
+        assertEquals(calls, runner.engineCalls.size)
+        assertEquals(QuitMarker(SessionEnd.RUNNING), marker.read())
+    }
+
+    @Test
+    fun `foreground without a preceding quit writes nothing`() {
+        val runner = FakeRunner()
+        val g = guard(runner)
+        runBlocking { g.onColdStart().join() }
+        val before = file.lastModified()
+        file.setLastModified(before - 10_000)
+        g.onForeground()
+        assertEquals(before - 10_000, file.lastModified())
+    }
+}
