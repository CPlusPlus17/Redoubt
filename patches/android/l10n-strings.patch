+// LibreWolf: strip Mozilla/Firefox branding out of every Android string
+// resource, in every locale, before AGP merges resources.  Owner: LW-M4-12.
+// See docs/android/L10N-ANDROID.md in the LibreWolf repository.
+//
+// Why here and not in scripts/librewolf-patches.py: the Fenix UI is localised
+// through in-tree res/values-*/strings.xml — 144 values*/**/*.xml files across
+// 131 res/values* directories.  A patch that carried the rewritten bytes would be megabytes of
+// churn that rejects on every rebase; a sed over the tree would be landmine L4
+// (an out-of-patch mutation nothing can see) and would also corrupt the
+// <string> entries whose value is a SharedPreferences key.  So the rewrite runs
+// as a build step whose input is the tree and whose output is a generated
+// resource directory, and the source tree is never modified.
+//
+// The mechanism is a source-set redirection, not an overlay: res.srcDirs is
+// REPLACED by the rewritten copy.  Appending an overlay directory to the same
+// source set would make every rewritten string a duplicate-resource error --
+// AGP only lets a HIGHER-priority source set override, and there is no spare
+// one here.
+
+def lwBrandDir = new File(gradle.mozconfig.topsrcdir, "mobile/android/lw-brand")
+def lwBrandScript = new File(lwBrandDir, "lw_brand_strings.py")
+def lwBrandMap = new File(lwBrandDir, "brand-map.txt")
+def lwBrandPin = new File(lwBrandDir, "android-l10n-pin.txt")
+
+if (!lwBrandScript.exists() || !lwBrandMap.exists() || !lwBrandPin.exists()) {
+    // Fail here rather than build an APK that still says Firefox.  This file
+    // is only ever applied from a LibreWolf-patched tree, so a missing piece
+    // means the patch landed half-applied.
+    throw new GradleException(
+        "lw-brand: ${lwBrandDir} is incomplete -- expected lw_brand_strings.py, " +
+        "brand-map.txt and android-l10n-pin.txt (LW-M4-12)")
+}
+
+subprojects { project ->
+    project.afterEvaluate {
+        if (!project.hasProperty('android')) {
+            return
+        }
+        def outRoot = new File(project.layout.buildDirectory.get().asFile, "lw-brand/res")
+        def args = []
+        def watched = []
+        project.android.sourceSets.each { ss ->
+            def replacement = []
+            def index = 0
+            ss.res.srcDirs.each { dir ->
+                // Only redirect directories that actually hold resource values;
+                // everything else (generated res, empty dirs) is left alone so
+                // the copy stays cheap and the wiring stays visible.
+                def values = dir.exists() ? dir.listFiles()?.findAll {
+                    it.isDirectory() && (it.name == "values" || it.name.startsWith("values-"))
+                } : null
+                if (!values) {
+                    replacement << dir
+                    return
+                }
+                def dest = new File(outRoot, "${ss.name}/${index++}")
+                args << "--pair" << dir.absolutePath << dest.absolutePath
+                watched << dir
+                replacement << dest
+            }
+            if (!replacement.isEmpty()) {
+                ss.res.srcDirs = replacement
+            }
+        }
+        if (args.isEmpty()) {
+            return
+        }
+
+        def rewrite = project.tasks.register("lwBrandStrings", Exec) { task ->
+            task.group = "librewolf"
+            task.description = "Rewrite Mozilla/Firefox branding out of the " +
+                               "Android string resources (LW-M4-12)"
+            task.commandLine([
+                "python3", lwBrandScript.absolutePath,
+                "--map", lwBrandMap.absolutePath,
+                "--pin", lwBrandPin.absolutePath,
+                "rewrite",
+                "--report", new File(outRoot.parentFile, "dropped.txt").absolutePath,
+            ] + args)
+            watched.each { d ->
+                task.inputs.dir(d).withPathSensitivity(PathSensitivity.RELATIVE)
+            }
+            task.inputs.file(lwBrandScript)
+            task.inputs.file(lwBrandMap)
+            task.inputs.file(lwBrandPin)
+            task.outputs.dir(outRoot)
+            task.doFirst { outRoot.parentFile.mkdirs() }
+        }
+
+        // The generated directory is now a resource source, so everything that
+        // reads resources has to run after the rewrite.  AGP does not infer a
+        // dependency from srcDirs, so it is declared here; a missing edge shows
+        // up as Gradle's "uses this output without declaring a dependency"
+        // error, not as a silently un-rewritten APK.
+        project.tasks.configureEach { task ->
+            def n = task.name
+            if (n == "lwBrandStrings") {
+                return
+            }
+            if ((n.startsWith("pre") && n.endsWith("Build"))
+                    || (n.startsWith("merge") && n.endsWith("Resources"))
+                    || (n.startsWith("generate") && n.endsWith("Resources"))
+                    || (n.startsWith("package") && n.endsWith("Resources"))
+                    || (n.startsWith("map") && n.endsWith("SourceSetPaths"))
+                    || n.startsWith("lint")) {
+                task.dependsOn(rewrite)
+            }
+        }
+    }
+}
