+#!/usr/bin/env python3
+"""Strip Mozilla/Firefox branding out of Fenix's Android string resources.
+
+LW-M4-12.  See docs/android/L10N-ANDROID.md in the LibreWolf repository for
+the why; this file is the what.
+
+The entire Fenix UI is localised through in-tree ``res/values-*/strings.xml``
+files that mozilla-l10n/android-l10n syncs into the tree.  ``--with-l10n-base``
+and the repository's ``l10n/`` overlay do not reach them: they cover
+``mobile/android/locales/en-US``, which is two .ftl files.  So the branding has
+to be removed from the resource XML itself, in every locale, before AGP merges
+resources.
+
+Design, in one paragraph.  Every ``<string>``/``<plurals>``/``<string-array>``
+text node is rewritten by replacing whole *words* that contain a declared brand
+stem with the Redoubt brand name; URLs are masked off first and handled by an
+explicit table, because ``firefox.com/pair`` is an endpoint and not a word.
+Whatever the substitution cannot clean is **dropped**, not shipped: a translated
+entry that still matches a brand stem, or whose English source mentions the
+brand while the rewritten translation does not mention LibreWolf, is deleted
+from the translated file so Android falls back to the rewritten English string.
+That is the fail-closed half, and it is what covers the transliterations --
+the map carries 32 non-Latin word stems across 19 locales that spell the mark
+in their own script (Фајерфокс, فايرفوكس, ഫയർഫോക്സ്,
+ෆයර්ෆොක්സ്), and no ASCII substitution can see them.  An unmatched brand stem in
+the *English* source is a hard error, because there is no fallback below it.
+
+Subcommands
+    rewrite   copy a res/ tree, rewriting values*/ XML on the way through
+    scan      report residual branding in a res/ tree or a directory of them
+    check-apk gate: fail if a built APK still ships brand stems outside the
+              url-keep and internal-key exceptions (behind android-smoke.sh
+              --check-strings)
+    derive    re-derive the per-locale brand spellings from an android-l10n
+              checkout (maintainer tool; see resync)
+    resync    download the pinned android-l10n archive, verify its sha256,
+              re-derive, and diff against the checked-in map
+    selftest  run the built-in unit tests
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import os
+import re
+import shutil
+import subprocess
+import sys
+import unicodedata
+import xml.parsers.expat
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+DEFAULT_MAP = HERE / "brand-map.txt"
+DEFAULT_PIN = HERE / "android-l10n-pin.txt"
+
+
+# --------------------------------------------------------------------------
+# Word splitting
+# --------------------------------------------------------------------------
+
+_MARKS = {"Mn", "Mc", "Me"}
+_JOINERS = {"‌", "‍", "ـ"}  # ZWNJ, ZWJ, Arabic tatweel
+
+
+def _is_word_char(ch: str) -> bool:
+    if ch.isalpha() or ch in _JOINERS:
+        return True
+    return unicodedata.category(ch) in _MARKS
+
+
+def script_of(ch: str) -> str:
+    """A coarse script name for one character; marks/joiners return "".
+
+    Used to decide how much of a word a brand stem owns.  Replacing the whole
+    word is wrong for scripts that glue grammatical particles straight onto the
+    Latin brand -- 'Firefox\ub97c' (ko), '\u12e8firefox' (am), 'mozilla\u1101\u1102'-style
+    Burmese -- and replacing only the stem is wrong for inflected Latin, where
+    'mozilli' would become 'LibreWolfli'.  Replacing the same-script run that
+    contains the stem is right in both cases.
+    """
+    if ch.isascii() or ord(ch) < 0x250 or 0x1E00 <= ord(ch) <= 0x1EFF:
+        return "LATIN"
+    if unicodedata.category(ch) in _MARKS or ch in _JOINERS:
+        return ""
+    name = unicodedata.name(ch, "")
+    return name.split(" ", 1)[0] if name else "?"
+
+
+def iter_words(text: str):
+    """Yield (start, end, word) for each maximal run of word characters.
+
+    'Word character' means alphabetic, combining mark, or ZWJ/ZWNJ/tatweel.
+    The combining-mark clause is load-bearing: a str.isalpha()-only definition
+    splits 'ഫയർഫോക്സ്' into five runs, and every stem derived from it is then a
+    fragment that either misses or over-matches.
+    """
+    n = len(text)
+    i = 0
+    while i < n:
+        if _is_word_char(text[i]):
+            j = i
+            while j < n and _is_word_char(text[j]):
+                j += 1
+            yield i, j, text[i:j]
+            i = j
+        else:
+            i += 1
+
+
+# A URL, or a bare host with a well-known TLD, or a query parameter value.
+URL_RE = re.compile(
+    r"(?i)\b(?:[a-z][a-z0-9+.-]*://)?(?:[a-z0-9-]+\.)+"
+    r"(?:com|org|net|io|dev|app|info|co|me)\b(?:[/?][^\s<>\"']*)?"
+)
+
+
+# --------------------------------------------------------------------------
+# The map file
+# --------------------------------------------------------------------------
+
+class MapError(Exception):
+    pass
+
+
+class BrandMap:
+    def __init__(self):
+        self.brand = None
+        self.derived_from = None
+        self.phrases = []     # (from, to, note)
+        self.words = []       # (stem, latin?, note)
+        self.urls = []        # (literal, replacement, note)
+        self.url_keep = []    # (literal, reason)
+        self.skip = []        # (resource name, reason)
+
+    @classmethod
+    def load(cls, path: Path) -> "BrandMap":
+        m = cls()
+        try:
+            text = path.read_text(encoding="utf-8")
+        except OSError as exc:
+            raise MapError(f"cannot read brand map {path}: {exc}") from exc
+        for lineno, raw in enumerate(text.splitlines(), 1):
+            line = raw.split("#", 1)[0].strip()
+            if not line:
+                continue
+            parts = [p.strip() for p in line.split("|")]
+            kind = parts[0]
+            try:
+                if kind == "brand":
+                    m.brand = parts[1]
+                elif kind == "derived-from":
+                    m.derived_from = parts[1]
+                elif kind == "phrase":
+                    m.phrases.append((parts[1], parts[2],
+                                      parts[3] if len(parts) > 3 else ""))
+                elif kind == "word":
+                    stem = parts[1]
+                    if not stem:
+                        raise IndexError
+                    # Case folding is applied to every stem, in every script.
+                    # It is identity for Arabic and the Indic scripts and it is
+                    # what makes the Cyrillic stems catch a lowercase spelling.
+                    m.words.append((stem.casefold(), True,
+                                    parts[2] if len(parts) > 2 else ""))
+                elif kind == "url":
+                    m.urls.append((parts[1], parts[2],
+                                   parts[3] if len(parts) > 3 else ""))
+                elif kind == "url-keep":
+                    m.url_keep.append((parts[1],
+                                       parts[2] if len(parts) > 2 else ""))
+                elif kind == "skip":
+                    m.skip.append((parts[1],
+                                   parts[2] if len(parts) > 2 else ""))
+                else:
+                    raise MapError(
+                        f"{path}:{lineno}: unknown directive {kind!r}. "
+                        "This parser refuses what it does not understand: a "
+                        "silently ignored rule is a rule that does not run.")
+            except IndexError:
+                raise MapError(f"{path}:{lineno}: malformed {kind!r} line: {raw!r}")
+        if not m.brand:
+            raise MapError(f"{path}: no 'brand|<name>' line")
+        if not m.words:
+            raise MapError(f"{path}: no 'word|<stem>' lines")
+        # Longest stems first so 'firefox' cannot shadow 'firefoxos'-style
+        # supersets; matching is substring-in-word so order only affects which
+        # note is reported, but determinism is cheap.
+        m.words.sort(key=lambda w: (-len(w[0]), w[0]))
+        m.skip_names = {n for n, _ in m.skip}
+        return m
+
+
+def read_pin(path: Path):
+    """commit + sha256, in exactly the format of assets/l10n-pin.txt."""
+    values = {}
+    try:
+        for line in path.read_text(encoding="utf-8").splitlines():
+            line = line.split("#", 1)[0].strip()
+            if not line or "=" not in line:
+                continue
+            key, _, value = line.partition("=")
+            values[key.strip()] = value.strip()
+    except OSError as exc:
+        raise MapError(f"cannot read pin file {path}: {exc}") from exc
+    commit = values.get("commit", "")
+    sha256 = values.get("sha256", "")
+    if not re.fullmatch(r"[0-9a-f]{40}", commit):
+        raise MapError(f"{path}: no valid 'commit = <40 hex>' line (got {commit!r})")
+    if not re.fullmatch(r"[0-9a-f]{64}", sha256):
+        raise MapError(f"{path}: no valid 'sha256 = <64 hex>' line (got {sha256!r})")
+    return commit, sha256
+
+
+def verify_sha256(path: Path, expected: str, description: str):
+    digest = hashlib.sha256()
+    with open(path, "rb") as fh:
+        for chunk in iter(lambda: fh.read(1 << 20), b""):
+            digest.update(chunk)
+    actual = digest.hexdigest()
+    if actual != expected:
+        raise MapError(
+            f"sha256 mismatch for {path} ({description})\n"
+            f"  expected: {expected}\n  actual:   {actual}\n"
+            f"  refusing to use an unverified download")
+    return actual
+
+
+# --------------------------------------------------------------------------
+# Offset-accurate resource XML
+# --------------------------------------------------------------------------
+
+RESOURCE_ELEMENTS = ("string", "plurals", "string-array", "array")
+
+
+class ResourceFile:
+    """Spans of a values*/*.xml file, from expat rather than from a regex.
+
+    Edits are applied to the raw bytes, so the offsets have to survive
+    comments, CDATA, entity references and inline markup.  expat reports
+    CurrentByteIndex for every event; nothing here re-implements XML lexing.
+    """
+
+    def __init__(self, data: bytes):
+        self.data = data
+        self.resources = []
+        self._parse()
+
+    def _parse(self):
+        p = xml.parsers.expat.ParserCreate()
+        p.buffer_text = False
+        stack = []
+        resources = []
+        events = []
+
+        def mark(kind, payload=None):
+            events.append((p.CurrentByteIndex, kind, payload))
+
+        def start(name, attrs):
+            mark("start")
+            stack.append([name, attrs, p.CurrentByteIndex])
+
+        def end(_name):
+            mark("end")
+            name, attrs, start_off = stack.pop()
+            if len(stack) == 1 and name in RESOURCE_ELEMENTS:
+                resources.append(dict(name=attrs.get("name"), tag=name,
+                                      start=start_off,
+                                      end_tag_start=p.CurrentByteIndex,
+                                      end=None, text_spans=[]))
+
+        p.StartElementHandler = start
+        p.EndElementHandler = end
+        p.CharacterDataHandler = lambda _t: mark("chars", tuple(f[0] for f in stack))
+        p.CommentHandler = lambda _t: mark("comment")
+        p.ProcessingInstructionHandler = lambda *_a: mark("pi")
+        p.StartCdataSectionHandler = lambda: mark("cdata")
+        p.EndCdataSectionHandler = lambda: mark("cdataend")
+        p.DefaultHandler = lambda _t: mark("default")
+        p.Parse(self.data, True)
+
+        for r in resources:
+            close = b"</" + r["tag"].encode() + b">"
+            idx = self.data.find(close, r["end_tag_start"])
+            r["end"] = idx + len(close) if idx >= 0 else \
+                self.data.find(b">", r["end_tag_start"]) + 1
+        self.resources = resources
+
+        ordered = sorted(events, key=lambda e: e[0])
+        for i, (off, kind, payload) in enumerate(ordered):
+            if kind != "chars":
+                continue
+            nxt = ordered[i + 1][0] if i + 1 < len(ordered) else len(self.data)
+            if nxt <= off or not payload or payload[0] != "resources":
+                continue
+            if len(payload) < 2 or payload[1] not in RESOURCE_ELEMENTS:
+                continue
+            for r in self.resources:
+                if r["start"] <= off < r["end"]:
+                    r["text_spans"].append((off, nxt))
+                    break
+
+    def values(self):
+        out = {}
+        for r in self.resources:
+            txt = b"".join(self.data[a:b] for a, b in r["text_spans"])
+            out[r["name"]] = out.get(r["name"], b"") + txt
+        return {k: v.decode("utf-8", "replace") for k, v in out.items()}
+
+    def edit(self, subst, drop_names):
+        edits = []
+        for r in self.resources:
+            if r["name"] in drop_names:
+                edits.append((r["start"], r["end"], b""))
+                continue
+            for a, b in r["text_spans"]:
+                old = self.data[a:b]
+                new = subst(old.decode("utf-8"), r["name"]).encode("utf-8")
+                if new != old:
+                    edits.append((a, b, new))
+        out = self.data
+        for a, b, new in sorted(edits, key=lambda e: -e[0]):
+            out = out[:a] + new + out[b:]
+        return out
+
+
+# --------------------------------------------------------------------------
+# Substitution
+# --------------------------------------------------------------------------
+
+def url_host(url: str) -> str:
+    """The host part of a URL span: after any scheme, before /, ? or :."""
+    rest = url.split("://", 1)[-1]
+    for sep in ("/", "?", ":"):
+        rest = rest.split(sep, 1)[0]
+    return rest
+
+
+class Rewriter:
+    def __init__(self, bmap: BrandMap):
+        self.map = bmap
+        self.brand = bmap.brand
+        # URL rules are keyed on the HOST, never on a substring.  A substring
+        # rule for "mozilla.org" silently rewrites "addons.mozilla.org" too,
+        # and that link has to keep working.
+        self.url_keep = {u.casefold() for u, _ in bmap.url_keep}
+        self.url_subst = {f.casefold(): t for f, t, _n in bmap.urls}
+
+    def _mask_urls(self, text):
+        """Return (masked text, list of (start, end, url))."""
+        spans = [(m.start(), m.end()) for m in URL_RE.finditer(text)]
+        return spans
+
+    def _stem_hit(self, word):
+        """Return (stem, start, end) where start/end bound the run to replace."""
+        low = word.casefold()
+        for stem, _latin, _note in self.map.words:
+            idx = low.find(stem)
+            if idx < 0:
+                continue
+            # casefold can change length (e.g. German sz); clamp to the word.
+            a = min(idx, len(word))
+            b = min(idx + len(stem), len(word))
+            return (stem,) + self._same_script_run(word, a, b)
+        return None
+
+    @staticmethod
+    def _same_script_run(word, a, b):
+        want = ""
+        for ch in word[a:b]:
+            want = script_of(ch)
+            if want:
+                break
+        i = a
+        while i > 0:
+            s = script_of(word[i - 1])
+            if s and s != want:
+                break
+            i -= 1
+        j = b
+        while j < len(word):
+            s = script_of(word[j])
+            if s and s != want:
+                break
+            j += 1
+        return i, j
+
+    def rewrite_text(self, text):
+        """Substitute brand words. Returns (new text, unresolved URL list)."""
+        for src, dst, _note in self.map.phrases:
+            text = text.replace(src, dst)
+        url_spans = self._mask_urls(text)
+
+        def in_url(a, b):
+            return any(s <= a and b <= e for s, e in url_spans)
+
+        out = []
+        last = 0
+        for a, b, word in iter_words(text):
+            if in_url(a, b):
+                continue
+            hit = self._stem_hit(word)
+            if hit:
+                _stem, ra, rb = hit
+                out.append(text[last:a + ra])
+                out.append(self.brand)
+                last = a + rb
+        out.append(text[last:])
+        new = "".join(out)
+
+        # URL rules, applied to the URL spans only, matched on the host.
+        pieces = []
+        last = 0
+        for m in URL_RE.finditer(new):
+            host = url_host(m.group(0))
+            repl = self.url_subst.get(host.casefold())
+            if repl is None:
+                continue
+            pieces.append(new[last:m.start()])
+            pieces.append(m.group(0).replace(host, repl, 1))
+            last = m.end()
+        pieces.append(new[last:])
+        new = "".join(pieces)
+
+        unresolved = []
+        for m in URL_RE.finditer(new):
+            u = m.group(0)
+            if not self._stem_hit_anywhere(u):
+                continue
+            if url_host(u).casefold() in self.url_keep:
+                continue
+            unresolved.append(u)
+        return new, unresolved
+
+    def _stem_hit_anywhere(self, text):
+        low = text.casefold()
+        for stem, _latin, _note in self.map.words:
+            if stem in low:
+                return stem
+        return None
+
+    def brand_words(self, text):
+        """Every distinct brand word in text, ignoring allowed URLs."""
+        keep = [(m.start(), m.end()) for m in URL_RE.finditer(text)
+                if url_host(m.group(0)).casefold() in self.url_keep]
+        out = []
+        for a, b, word in iter_words(text):
+            if any(s <= a and b <= e for s, e in keep):
+                continue
+            if self._stem_hit(word):
+                out.append(word)
+        return out
+
+    def residual(self, text):
+        """A brand stem still present outside an allowed URL, or None."""
+        keep_spans = []
+        for m in URL_RE.finditer(text):
+            if url_host(m.group(0)).casefold() in self.url_keep:
+                keep_spans.append((m.start(), m.end()))
+        for a, b, word in iter_words(text):
+            if any(s <= a and b <= e for s, e in keep_spans):
+                continue
+            if self._stem_hit(word):
+                return word
+        return None
+
+
+# --------------------------------------------------------------------------
+# rewrite: a whole res/ tree
+# --------------------------------------------------------------------------
+
+def is_identifier(name, value):
+    """A <string> whose value is its own name is an internal key, not prose.
+
+    'pref_key_enable_firefox_labs', 'mozac_error_asleep' and friends are looked
+    up by value at runtime -- pref_key_* are SharedPreferences keys and
+    mozac_error_* select an error-page illustration.  Rewriting them silently
+    breaks stored preferences and image lookups, and a sed over strings.xml
+    does exactly that.
+    """
+    return value.strip() == (name or "")
+
+
+class Stats:
+    def __init__(self):
+        self.files = 0
+        self.rewritten_rows = 0
+        self.dropped_rows = 0
+        self.dropped = []          # (locale, resource)
+        self.errors = []
+
+
+def rewrite_res_dir(src: Path, dst: Path, rw: Rewriter, stats: Stats,
+                    base_values=None):
+    """Copy src -> dst, rewriting values*/ XML on the way.
+
+    base_values is {resource name: English value}; when it is None the English
+    values are read from src's own values/ directory.
+    """
+    if base_values is None:
+        base_values = {}
+        vdir = src / "values"
+        if vdir.is_dir():
+            for f in sorted(vdir.glob("*.xml")):
+                try:
+                    base_values.update(ResourceFile(f.read_bytes()).values())
+                except Exception:
+                    pass
+
+    if dst.exists():
+        shutil.rmtree(dst)
+    dst.mkdir(parents=True, exist_ok=True)
+
+    for entry in sorted(src.iterdir()):
+        target = dst / entry.name
+        if entry.is_dir() and (entry.name == "values" or
+                               entry.name.startswith("values-")):
+            locale = "" if entry.name == "values" else entry.name[len("values-"):]
+            target.mkdir(parents=True, exist_ok=True)
+            for f in sorted(entry.iterdir()):
+                if f.suffix != ".xml":
+                    shutil.copy2(f, target / f.name)
+                    continue
+                stats.files += 1
+                (target / f.name).write_bytes(
+                    rewrite_file(f.read_bytes(), locale, rw, stats,
+                                 base_values, str(f)))
+        elif entry.is_dir():
+            shutil.copytree(entry, target, symlinks=True)
+        else:
+            shutil.copy2(entry, target)
+
+
+def rewrite_file(data: bytes, locale: str, rw: Rewriter, stats: Stats,
+                 base_values, where=""):
+    rf = ResourceFile(data)
+    values = rf.values()
+    drop = set()
+    skip = rw.map.skip_names
+
+    for name, value in values.items():
+        if name is None or name in skip or is_identifier(name, value):
+            continue
+        new, unresolved = rw.rewrite_text(value)
+        residual = rw.residual(new)
+        # What the fallback below this entry will say, once rewritten.
+        english_new = rw.rewrite_text(base_values.get(name, ""))[0]
+
+        if locale == "":
+            # There is nothing below en-US to fall back to, so an English
+            # value the rules cannot clean is a hard error, not a drop.
+            if unresolved:
+                stats.errors.append(
+                    f"{where}: {name}: URL {unresolved[0]!r} carries a brand "
+                    f"token and its host is in neither the 'url' nor the "
+                    f"'url-keep' table")
+            elif residual:
+                stats.errors.append(
+                    f"{where}: {name}: English value still contains "
+                    f"{residual!r} after rewriting; there is no fallback "
+                    f"below en-US")
+            continue
+
+        if unresolved:
+            drop.add(name)
+            stats.dropped.append((locale, name, f"unresolved URL {unresolved[0]!r}"))
+            continue
+        if residual is not None:
+            drop.add(name)
+            stats.dropped.append((locale, name, f"residual {residual!r}"))
+            continue
+        # The fail-closed rule.  If the rewritten English mentions the brand
+        # and the rewritten translation does not, the translation is either a
+        # transliteration this map has no stem for or a rendering that dropped
+        # the mark.  We cannot tell which, so we drop it and fall back to the
+        # English string rather than risk shipping the mark.
+        if rw.brand in english_new and rw.brand not in new:
+            drop.add(name)
+            stats.dropped.append((locale, name, "brand missing from translation"))
+
+    def subst(text, name):
+        if name is None or name in skip or is_identifier(name, values.get(name, "")):
+            return text
+        new, _ = rw.rewrite_text(text)
+        return new
+
+    out = rf.edit(subst, drop)
+    stats.dropped_rows += len(drop)
+    return out
+
+
+# --------------------------------------------------------------------------
+# Commands
+# --------------------------------------------------------------------------
+
+def find_res_dirs(root: Path):
+    for dirpath, dirnames, _files in os.walk(root):
+        if os.path.basename(dirpath) != "res":
+            continue
+        yield Path(dirpath)
+        dirnames[:] = []
+
+
+def check_pin(bmap, pin_path: Path):
+    """The map must declare which android-l10n commit it was derived from, and
+    that commit must be the pinned one.  Without this the word list can drift
+    from its source and nothing notices -- which is landmine L4's shape."""
+    commit, _sha = read_pin(pin_path)
+    if bmap.derived_from != commit:
+        raise MapError(
+            f"brand map says derived-from|{bmap.derived_from} but "
+            f"{pin_path} pins commit {commit}.\n"
+            f"  Re-derive the word list ('lw_brand_strings.py resync') and "
+            f"review the diff; do not just edit the derived-from line.")
+
+
+def cmd_rewrite(args):
+    bmap = BrandMap.load(Path(args.map))
+    check_pin(bmap, Path(args.pin))
+    rw = Rewriter(bmap)
+    stats = Stats()
+    pairs = list(args.pair or [])
+    if args.src:
+        pairs.append([args.src, args.dst])
+    if not pairs:
+        print("fatal error: no --src/--dst or --pair given", file=sys.stderr)
+        return 2
+    for src, dst in pairs:
+        rewrite_res_dir(Path(src), Path(dst), rw, stats)
+    for e in stats.errors:
+        print("error: " + e, file=sys.stderr)
+    print(f"[lw-brand] {len(pairs)} res dir(s), {stats.files} values file(s), "
+          f"{stats.dropped_rows} translated entr(ies) dropped", file=sys.stderr)
+    if args.report:
+        with open(args.report, "w", encoding="utf-8") as fh:
+            for loc, name, why in sorted(stats.dropped):
+                fh.write(f"{loc}\t{name}\t{why}\n")
+    return 1 if stats.errors else 0
+
+
+def cmd_scan(args):
+    bmap = BrandMap.load(Path(args.map))
+    check_pin(bmap, Path(args.pin))
+    rw = Rewriter(bmap)
+    bad = 0
+    for res in find_res_dirs(Path(args.root)):
+        for d in sorted(res.iterdir()):
+            if not d.is_dir() or not (d.name == "values" or
+                                      d.name.startswith("values-")):
+                continue
+            for f in sorted(d.glob("*.xml")):
+                try:
+                    vals = ResourceFile(f.read_bytes()).values()
+                except Exception as exc:
+                    print(f"error: {f}: {exc}", file=sys.stderr)
+                    bad += 1
+                    continue
+                for name, value in vals.items():
+                    if name in bmap.skip_names or is_identifier(name, value):
+                        continue
+                    hit = rw.residual(value)
+                    if hit:
+                        print(f"{f}: {name}: {hit}")
+                        bad += 1
+    print(f"[lw-brand] scan: {bad} residual branded value(s)", file=sys.stderr)
+    return 1 if bad else 0
+
+
+def cmd_derive(args):
+    """Re-derive candidate brand spellings from an android-l10n checkout."""
+    import collections
+    bmap = BrandMap.load(Path(args.map)) if Path(args.map).exists() else None
+    base = {}
+    for dirpath, dirnames, files in os.walk(args.tree):
+        if os.path.basename(dirpath) != "values":
+            continue
+        if "/samples/" in dirpath or "/examples/" in dirpath:
+            continue
+        for f in files:
+            if f.endswith(".xml"):
+                try:
+                    for k, v in ResourceFile(
+                            Path(dirpath, f).read_bytes()).values().items():
+                        base.setdefault(k, v)
+                except Exception:
+                    pass
+    per = collections.defaultdict(lambda: {"B": [], "O": []})
+    for dirpath, dirnames, files in os.walk(args.l10n):
+        b = os.path.basename(dirpath)
+        if not b.startswith("values-"):
+            continue
+        loc = b[len("values-"):]
+        for f in files:
+            if not f.endswith(".xml"):
+                continue
+            try:
+                vals = ResourceFile(Path(dirpath, f).read_bytes()).values()
+            except Exception:
+                continue
+            for name, val in vals.items():
+                en = base.get(name)
+                if en is None:
+                    continue
+                if any(w in en for w in ("Firefox", "Mozilla")):
+                    if not any(w in val for w in ("Firefox", "Mozilla")):
+                        per[loc]["B"].append(val)
+                else:
+                    per[loc]["O"].append(val)
+    rw = Rewriter(bmap) if bmap else None
+    uncovered = 0
+    for loc, d in sorted(per.items()):
+        if not d["B"]:
+            continue
+        odf = collections.Counter()
+        for v in d["O"]:
+            odf.update({w.lower() for _s, _e, w in iter_words(v)})
+        bdf = collections.Counter()
+        for v in d["B"]:
+            bdf.update({w.lower() for _s, _e, w in iter_words(v)})
+        cands = sorted(((n, w) for w, n in bdf.items() if odf[w] == 0),
+                       reverse=True)[:6]
+        covered = [w for _n, w in cands if rw and rw._stem_hit(w)]
+        flag = "" if covered else "   <-- NO STEM IN MAP"
+        if not covered:
+            uncovered += 1
+        print(f"{loc:10s} n={len(d['B']):3d} {flag}")
+        for n, w in cands:
+            mark = "*" if rw and rw._stem_hit(w) else " "
+            print(f"   {mark} {w}  ({n})")
+    print(f"[lw-brand] derive: {uncovered} locale(s) with no covered candidate",
+          file=sys.stderr)
+    return 0
+
+
+def cmd_resync(args):
+    import tempfile
+    import subprocess
+    commit, sha = read_pin(Path(args.pin))
+    with tempfile.TemporaryDirectory() as tmp:
+        zip_path = Path(tmp, "android-l10n.zip")
+        url = f"https://codeload.github.com/mozilla-l10n/android-l10n/zip/{commit}"
+        print(f"-> {url}", file=sys.stderr)
+        subprocess.check_call(["curl", "-sfL", "-o", str(zip_path), url])
+        verify_sha256(zip_path, sha, f"android-l10n zip @ {commit}")
+        print(f"sha256 ok: {sha}", file=sys.stderr)
+        subprocess.check_call(["unzip", "-qo", str(zip_path), "-d", tmp])
+        extracted = Path(tmp, f"android-l10n-{commit}")
+        if not extracted.is_dir():
+            raise MapError(f"{extracted} missing; codeload changed its layout")
+        args.l10n = str(extracted)
+        return cmd_derive(args)
+
+
+# --------------------------------------------------------------------------
+# Self-test
+# --------------------------------------------------------------------------
+
+SELFTEST_MAP = """
+brand|LibreWolf
+word|firefox|latin
+word|mozil|latin stem
+word|фајерфокс|sr
+phrase|Firefox Fenix|LibreWolf|app_name
+url|mozilla.org|librewolf.net|example domain
+url-keep|firefox.com|functional endpoint
+skip|some_key|internal
+"""
+
+SELFTEST_XML = b"""<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- a comment mentioning Firefox and Mozilla -->
+    <string name="a">Welcome to Firefox</string>
+    <string name="b" tools:ignore="X">Send data to Mozilla</string>
+    <string name="c">Scan at <b>firefox.com/pair</b></string>
+    <string name="d">e.g. mozilla.org:80</string>
+    <string name="pref_key_x">pref_key_x</string>
+    <string name="some_key">Firefox</string>
+    <string name="e">Fajerfoks &amp; co</string>
+    <plurals name="f"><item quantity="one">One Firefox tab</item></plurals>
+</resources>
+"""
+
+
+def cmd_selftest(_args):
+    import tempfile
+    failures = []
+
+    def check(label, got, want):
+        if got != want:
+            failures.append(f"{label}\n  got:  {got!r}\n  want: {want!r}")
+
+    with tempfile.TemporaryDirectory() as tmp:
+        mp = Path(tmp, "m.txt")
+        mp.write_text(SELFTEST_MAP, encoding="utf-8")
+        bmap = BrandMap.load(mp)
+        rw = Rewriter(bmap)
+
+        check("latin word", rw.rewrite_text("Welcome to Firefox")[0],
+              "Welcome to LibreWolf")
+        check("possessive", rw.rewrite_text("Firefox’s job")[0],
+              "LibreWolf’s job")
+        check("inflected latin stem", rw.rewrite_text("dane do Mozilli")[0],
+              "dane do LibreWolf")
+        check("cyrillic word", rw.rewrite_text(
+            "Фајерфоксова заштита")[0],
+              "LibreWolf заштита")
+        check("url table", rw.rewrite_text("e.g. mozilla.org:80")[0],
+              "e.g. librewolf.net:80")
+        check("url kept", rw.rewrite_text("go to https://firefox.com/pair")[0],
+              "go to https://firefox.com/pair")
+        check("unresolved url is reported",
+              rw.rewrite_text("see support.mozilla.org/kb")[1],
+              ["support.mozilla.org/kb"])
+        check("host rule does not touch a subdomain",
+              rw.rewrite_text("see support.mozilla.org/kb")[0],
+              "see support.mozilla.org/kb")
+        check("phrase before words",
+              rw.rewrite_text("Firefox Fenix")[0], "LibreWolf")
+        check("residual finds cyrillic",
+              rw.residual("Фајерфокс"),
+              "Фајерфокс")
+        check("residual ignores kept url",
+              rw.residual("open https://firefox.com/pair now"), None)
+        check("identifier detected", is_identifier("pref_key_x", "pref_key_x"), True)
+
+        # File-level: English pass must not drop, must not touch comments.
+        stats = Stats()
+        base = ResourceFile(SELFTEST_XML).values()
+        out = rewrite_file(SELFTEST_XML, "", rw, stats, base, "selftest")
+        vals = ResourceFile(out).values()
+        check("en a", vals["a"], "Welcome to LibreWolf")
+        check("en b", vals["b"], "Send data to LibreWolf")
+        check("en c", vals["c"], "Scan at firefox.com/pair")
+        check("en d", vals["d"], "e.g. librewolf.net:80")
+        check("en pref key untouched", vals["pref_key_x"], "pref_key_x")
+        check("en skip untouched", vals["some_key"], "Firefox")
+        check("en plurals", vals["f"], "One LibreWolf tab")
+        check("comments untouched",
+              b"a comment mentioning Firefox and Mozilla" in out, True)
+        check("no error on English", stats.errors, [])
+
+        # Translated pass: a transliteration we do not know must be dropped.
+        tr = SELFTEST_XML.replace(b"Welcome to Firefox", b"Vitajte vo Fajerfokse")
+        stats2 = Stats()
+        out2 = rewrite_file(tr, "sk", rw, stats2, base, "selftest-sk")
+        vals2 = ResourceFile(out2).values()
+        check("unknown transliteration dropped", "a" in vals2, False)
+        check("drop recorded", any(n == "a" for _l, n, _w in stats2.dropped), True)
+
+        # A known transliteration must be substituted, not dropped.
+        tr2 = SELFTEST_XML.replace(
+            b"Welcome to Firefox",
+            "Добро Фајерфокс".encode())
+        stats3 = Stats()
+        vals3 = ResourceFile(rewrite_file(tr2, "sr", rw, stats3, base, "st-sr")).values()
+        check("known transliteration substituted", vals3.get("a"),
+              "Добро LibreWolf")
+
+        # An unknown brand-bearing URL must be an error, not a silent pass.
+        bad = SELFTEST_XML.replace(b"Welcome to Firefox",
+                                   b"see support.mozilla.org/kb/x")
+        stats4 = Stats()
+        rewrite_file(bad, "", rw, stats4, base, "st-url")
+        check("unknown branded URL errors", len(stats4.errors), 1)
+
+        # An unknown directive must be refused.
+        mp2 = Path(tmp, "m2.txt")
+        mp2.write_text(SELFTEST_MAP + "\nwibble|x\n", encoding="utf-8")
+        try:
+            BrandMap.load(mp2)
+            failures.append("unknown directive was accepted")
+        except MapError:
+            pass
+
+    for f in failures:
+        print("FAIL " + f, file=sys.stderr)
+    print(f"[lw-brand] selftest: {len(failures)} failure(s)", file=sys.stderr)
+    return 1 if failures else 0
+
