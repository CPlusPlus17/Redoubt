+#!/usr/bin/env python3
+"""Walk the running Fenix UI and report every visible Mozilla/Firefox mark.
+
+LW-M4-12.  This is a HOST-side tool: it drives a device over adb, it is not
+part of the app build.  It exists because the acceptance for that task is
+"verified from the running app, not from grep", and because a scrape of the
+home screen and the settings root would go green on a build whose deeper
+screens still say Firefox.
+
+The deterministic hard gate is the other direction: `--check-strings` (LW-M2-07
+owns the script; the checker this patch ships is its body) reads the BUILT
+APK's compiled string table with aapt2 and FAILs on any unexplained brand
+value, so a build whose deeper screens still say Firefox cannot slip through
+the resource surface.  This walker covers what that gate cannot see -- the
+non-resource surface (here, the add-on description) -- and it REPORTS, it does
+not gate.
+
+What it does:
+
+  * navigates by DEEP LINK (fenix-dev://settings_search_engine and the other
+    thirteen routes HomeDeepLinkIntentProcessor accepts), so navigation does
+    not depend on reading localised labels -- the point is to run in Serbian
+    and Malayalam, where a coordinate or a label-matching walker cannot go;
+  * then breadth-first taps every clickable row of every screen it reaches, to
+    a bounded depth, pressing Back afterwards;
+  * dumps the accessibility tree at each stop and matches every `text` and
+    `content-desc` against the SAME brand stems the rewrite uses
+    (brand-map.txt), so a transliteration is caught in the locale that spells
+    it that way;
+  * reports a hit as (screen, attribute, value), and exits 1 if there are any.
+
+What it does NOT prove: that a screen it never reached is clean.  It prints
+the screens it visited, and the count, so that is auditable rather than
+implied.
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+import subprocess
+import sys
+import time
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+# The crude counterpart of the stem detector: a plain ASCII search that knows
+# nothing about the map's url-keep allowlist.  It is here so the enumerated
+# exceptions are OBSERVED on screen rather than assumed away -- the stem
+# detector skips an allowed URL by construction, so on its own it could never
+# tell you the pairing screen still reads firefox.com/pair.
+CRUDE = re.compile(r"(?i)firefox|mozilla|fenix")
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from lw_brand_strings import BrandMap, Rewriter  # noqa: E402
+
+DEEP_LINKS = [
+    "home", "urls_bookmarks", "urls_history", "settings", "turn_on_sync",
+    "settings_search_engine", "settings_accessibility",
+    "settings_delete_browsing_data", "settings_addon_manager",
+    "settings_logins", "settings_tracking_protection", "settings_privacy",
+    "settings_wallpapers", "settings_private_browsing", "settings_app_icon",
+    "settings_ai_controls",
+]
+
+
+class Adb:
+    def __init__(self, adb, serial):
+        self.base = [adb] + (["-s", serial] if serial else [])
+
+    def sh(self, *args, timeout=60):
+        return subprocess.run(self.base + ["shell"] + list(args),
+                              capture_output=True, text=True, timeout=timeout)
+
+    def raw(self, *args, timeout=60):
+        return subprocess.run(self.base + list(args),
+                              capture_output=True, text=True, timeout=timeout)
+
+
+def dump_tree(adb, retries=4):
+    for _ in range(retries):
+        r = adb.sh("uiautomator", "dump", "/sdcard/lwui.xml")
+        if "dumped" in (r.stdout + r.stderr):
+            out = adb.raw("exec-out", "cat", "/sdcard/lwui.xml")
+            if out.stdout.strip().startswith("<"):
+                return out.stdout
+        time.sleep(1)
+    return ""
+
+
+def nodes(xml_text):
+    try:
+        root = ET.fromstring(xml_text)
+    except ET.ParseError:
+        return []
+    return list(root.iter("node"))
+
+
+def labelled_clickables(xml_text):
+    """(label, centre) for every clickable node, labelled by its own text or,
+    failing that, by the first text of a descendant.
+
+    The descendant clause is not cosmetic.  Fenix's settings rows are Compose
+    nodes: the clickable is a container and the words live in a child, so a
+    walker that only reads a clickable's own `text` sees "Navigate up" and
+    nothing else -- and never opens "About Redoubt", which is the last row of
+    the settings list and the likeliest place for the mark to survive."""
+    try:
+        root = ET.fromstring(xml_text)
+    except ET.ParseError:
+        return []
+    out = []
+    for n in root.iter("node"):
+        if n.get("clickable") != "true":
+            continue
+        c = bounds_center(n.get("bounds"))
+        if not c:
+            continue
+        label = n.get("text") or n.get("content-desc") or ""
+        if not label:
+            for d in n.iter("node"):
+                label = d.get("text") or d.get("content-desc") or ""
+                if label:
+                    break
+        if label:
+            out.append((label, c))
+    return out
+
+
+def visible_strings(xml_text):
+    out = []
+    for n in nodes(xml_text):
+        for attr in ("text", "content-desc"):
+            v = n.get(attr, "")
+            if v:
+                out.append((attr, v, n.get("resource-id", "")))
+    return out
+
+
+def bounds_center(b):
+    m = re.match(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]", b or "")
+    if not m:
+        return None
+    x1, y1, x2, y2 = map(int, m.groups())
+    if x2 <= x1 or y2 <= y1:
+        return None
+    return (x1 + x2) // 2, (y1 + y2) // 2
+
+
+def scrollable(xml_text):
+    for n in nodes(xml_text):
+        if n.get("scrollable") == "true":
+            c = bounds_center(n.get("bounds"))
+            if c:
+                return c
+    return None
+
+
+def collect_rows(adb, xml_text, max_scrolls=12):
+    """Every clickable row with a visible label, scrolling to the bottom."""
+    rows = []
+    seen = set()
+
+    def harvest(x):
+        for label, c in labelled_clickables(x):
+            if label in seen:
+                continue
+            seen.add(label)
+            rows.append((label, c))
+
+    harvest(xml_text)
+    sc = scrollable(xml_text)
+    if sc:
+        for _ in range(max_scrolls):
+            before = dump_tree(adb)
+            adb.sh("input", "swipe", str(sc[0]), str(sc[1] + 500),
+                   str(sc[0]), str(sc[1] - 500), "300")
+            time.sleep(1.0)
+            after = dump_tree(adb)
+            harvest(after)
+            if after == before:
+                break
+    return rows
+
+
+def find_row(adb, label):
+    """Locate a row by its label on the screen now, scrolling if need be."""
+    for _ in range(14):
+        x = dump_tree(adb)
+        for got, c in labelled_clickables(x):
+            if got == label:
+                return c
+        sc = scrollable(x)
+        if not sc:
+            return None
+        adb.sh("input", "swipe", str(sc[0]), str(sc[1] + 500),
+               str(sc[0]), str(sc[1] - 500), "300")
+        time.sleep(0.9)
+    return None
+
+
+def scan_screen(rw, xml_text, screen, findings, seen_screens, crude=None):
+    seen_screens.append(screen)
+    n0 = len(findings)
+    n1 = len(crude) if crude is not None else 0
+    strings = visible_strings(xml_text)
+    for attr, value, rid in strings:
+        hit = rw.residual(value)
+        if hit:
+            findings.append((screen, attr, rid, value, hit))
+        elif crude is not None and CRUDE.search(value):
+            crude.append((screen, attr, rid, value))
+    print("  [%s] %d string(s), %d branded, %d allowed-exception" %
+          (screen, len(strings), len(findings) - n0,
+           (len(crude) - n1) if crude is not None else 0),
+          file=sys.stderr)
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--adb", default="adb")
+    ap.add_argument("--serial")
+    ap.add_argument("--package", required=True)
+    ap.add_argument("--scheme", default="fenix-dev")
+    ap.add_argument("--map", default=str(Path(__file__).resolve().parent / "brand-map.txt"))
+    ap.add_argument("--depth", type=int, default=1,
+                    help="how many levels of clickable rows to open below each "
+                         "deep-linked screen (default 1)")
+    ap.add_argument("--max-taps", type=int, default=14,
+                    help="cap on rows opened per screen")
+    ap.add_argument("--label", default="", help="tag for the report (e.g. the locale)")
+    args = ap.parse_args(argv)
+
+    bmap = BrandMap.load(Path(args.map))
+    rw = Rewriter(bmap)
+    adb = Adb(args.adb, args.serial)
+
+    findings = []
+    crude = []
+    seen = []
+
+    adb.sh("am", "force-stop", args.package)
+    adb.sh("monkey", "-p", args.package, "-c",
+           "android.intent.category.LAUNCHER", "1")
+    time.sleep(8)
+    # The Android runtime-permission dialog is part of the UI the user sees and
+    # it carries the app label, so it is scanned before it is dismissed.
+    scan_screen(rw, dump_tree(adb), "launch", findings, seen, crude)
+    for _ in range(3):
+        xml = dump_tree(adb)
+        deny = None
+        for n in nodes(xml):
+            rid = n.get("resource-id", "")
+            if rid.endswith("permission_deny_button") or rid.endswith("permission_allow_button"):
+                deny = bounds_center(n.get("bounds"))
+                break
+        if not deny:
+            break
+        scan_screen(rw, xml, "runtime-permission-dialog", findings, seen, crude)
+        adb.sh("input", "tap", str(deny[0]), str(deny[1]))
+        time.sleep(2)
+
+    for link in DEEP_LINKS:
+        adb.sh("am", "start", "-a", "android.intent.action.VIEW",
+               "-d", "%s://%s" % (args.scheme, link), args.package)
+        time.sleep(2.2)
+        xml = dump_tree(adb)
+        scan_screen(rw, xml, link, findings, seen, crude)
+        if args.depth < 1:
+            continue
+        # Scroll the screen to the bottom, collecting every labelled row on the
+        # way.  Without this the walker only ever sees the first screenful, and
+        # "About Redoubt" -- the one row most likely to carry the mark -- is
+        # the last entry in the settings list.
+        rows = collect_rows(adb, xml)
+        opened = 0
+        for i, (label, _c) in enumerate(rows):
+            if opened >= args.max_taps:
+                break
+            # Re-find the row by label after each Back: coordinates go stale as
+            # soon as the list scrolls.
+            spot = find_row(adb, label)
+            if not spot:
+                continue
+            before = dump_tree(adb)
+            adb.sh("input", "tap", str(spot[0]), str(spot[1]))
+            time.sleep(1.6)
+            sub = dump_tree(adb)
+            if sub == before:
+                continue        # the tap changed nothing; not a screen
+            opened += 1
+            scan_screen(rw, sub, "%s>%s" % (link, label[:28]), findings, seen, crude)
+            adb.sh("input", "keyevent", "KEYCODE_BACK")
+            time.sleep(1.2)
+
+    label = args.label or "device"
+    print("[ui-scan %s] visited %d screen(s)" % (label, len(seen)), file=sys.stderr)
+    for screen, attr, rid, value, hit in findings:
+        print("BRANDED\t%s\t%s\t%s\t%s\t%s" % (label, screen, attr, rid, value))
+    for screen, attr, rid, value in crude:
+        print("ALLOWED\t%s\t%s\t%s\t%s" % (label, screen, attr, value))
+    print("[ui-scan %s] %d branded string(s) visible, %d in the enumerated "
+          "url-keep exception" % (label, len(findings), len(crude)),
+          file=sys.stderr)
+    return 1 if findings else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
