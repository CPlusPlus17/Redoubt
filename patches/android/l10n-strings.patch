+# --------------------------------------------------------------------------
+# check-apk: the built-APK gate (behind android-smoke.sh --check-strings)
+# --------------------------------------------------------------------------
+
+_DUMP_TYPE = re.compile(r"^  type (\S+) id=")
+_DUMP_RES = re.compile(r"^    resource 0x[0-9a-f]+ (\S+)/(\S+)")
+_DUMP_CFG = re.compile(r"^      \(([^)]*)\) (.*)$")
+
+
+def _parse_aapt2_dump(text):
+    """Parse `aapt2 dump resources` into (type, name, config, value) rows.
+
+    A decoded "\\n" is a real newline inside the quotes, so values are
+    accumulated until the closing quote -- a single-line match would silently
+    drop every multi-line string, including one that still says
+    "client=firefox".
+    """
+    rows, cur_type, cur_name, cur_cfg, pending = [], None, None, None, None
+    for line in text.splitlines():
+        if pending is not None:
+            pending += "\n" + line
+            if line.endswith('"'):
+                rows.append((cur_type, cur_name, cur_cfg, pending[1:-1]))
+                pending = None
+            continue
+        m = _DUMP_TYPE.match(line)
+        if m:
+            cur_type, cur_name, cur_cfg = m.group(1), None, None
+            continue
+        m = _DUMP_RES.match(line)
+        if m:
+            cur_name, cur_cfg = m.group(2), None
+            continue
+        m = _DUMP_CFG.match(line)
+        if m and cur_name is not None:
+            cur_cfg = m.group(1) or "default"
+            rest = m.group(2)
+            if rest.startswith('"'):
+                if len(rest) > 1 and rest.endswith('"'):
+                    rows.append((cur_type, cur_name, cur_cfg, rest[1:-1]))
+                else:
+                    pending = rest
+            continue
+    return rows
+
+
+def cmd_check_apk(args):
+    """Gate: fail if a built APK still ships brand stems outside the enumerated
+    url-keep exceptions and internal keys (value == name).
+
+    Deterministic and offline -- it reads the compiled resources.arsc through
+    aapt2, not a grep of the tree and not a scrape of two running screens.
+    A value is UNEXPLAINED (a FAIL) iff it carries a brand word outside a
+    url-keep host; an internal key (value == its own name) and a value whose
+    only mark is a url-keep host are reported as enumerated exceptions and do
+    not fail the gate.
+    """
+    bmap = BrandMap.load(Path(args.map))
+    check_pin(bmap, Path(args.pin))
+    rw = Rewriter(bmap)
+    if args.dump:
+        text = Path(args.dump).read_text(encoding="utf-8", errors="replace")
+    elif args.apk:
+        proc = subprocess.run([args.aapt2, "dump", "resources", args.apk],
+                             capture_output=True, text=True)
+        if proc.returncode != 0:
+            print("fatal error: aapt2 failed: " + proc.stderr, file=sys.stderr)
+            return 2
+        text = proc.stdout
+    else:
+        print("fatal error: need --apk (with --aapt2) or --dump", file=sys.stderr)
+        return 2
+
+    unexplained, allowed, internal = [], [], []
+    total = 0
+    for _type, name, cfg, value in _parse_aapt2_dump(text):
+        if _type not in ("string", "plurals", "string-array"):
+            continue
+        total += 1
+        if is_identifier(name, value):
+            if rw.residual(value):
+                internal.append((name, cfg, value))
+            continue
+        if name in bmap.skip_names:
+            continue
+        hit = rw.residual(value)
+        if hit:
+            unexplained.append((name, cfg, value, hit))
+        elif any(u.casefold() in value.casefold() for u, _ in bmap.url_keep):
+            allowed.append((name, cfg, value))
+
+    print("[lw-brand check-apk] %d text rows" % total, file=sys.stderr)
+    print("[lw-brand check-apk] unexplained: %d  allowed(url-keep): %d  "
+          "internal(value==name): %d" % (len(unexplained), len(allowed),
+                                        len(internal)), file=sys.stderr)
+    for name, cfg, value, hit in unexplained[:25]:
+        print("  UNEXPLAINED %s (%s): stem=%r %r" % (name, cfg, hit, value[:80]),
+              file=sys.stderr)
+    for name, cfg, value in allowed[:25]:
+        print("  ALLOWED %s (%s): %r" % (name, cfg, value[:80]), file=sys.stderr)
+    for name, cfg, value in internal:
+        print("  INTERNAL %s (%s): %r" % (name, cfg, value[:80]), file=sys.stderr)
+    if unexplained:
+        print("[lw-brand check-apk] FAIL: %d unexplained branded value(s) in "
+              "the built APK" % len(unexplained), file=sys.stderr)
+        return 1
+    print("[lw-brand check-apk] PASS: no unexplained branded value(s); only "
+          "enumerated url-keep and internal-key exceptions", file=sys.stderr)
+    return 0
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--map", default=str(DEFAULT_MAP))
+    ap.add_argument("--pin", default=str(DEFAULT_PIN))
+    sub = ap.add_subparsers(dest="cmd", required=True)
+
+    p = sub.add_parser("rewrite")
+    p.add_argument("--src")
+    p.add_argument("--dst")
+    p.add_argument("--pair", nargs=2, action="append", metavar=("SRC", "DST"))
+    p.add_argument("--report")
+    p.set_defaults(func=cmd_rewrite)
+
+    p = sub.add_parser("scan")
+    p.add_argument("--root", required=True)
+    p.set_defaults(func=cmd_scan)
+
+    p = sub.add_parser("check-apk",
+                       help="gate: fail if a built APK still ships brand stems "
+                            "outside the url-keep and internal-key exceptions")
+    p.add_argument("--apk", help="built APK to check")
+    p.add_argument("--aapt2", default="aapt2", help="path to aapt2")
+    p.add_argument("--dump", help="a pre-made `aapt2 dump resources` file")
+    p.set_defaults(func=cmd_check_apk)
+
+    p = sub.add_parser("derive")
+    p.add_argument("--l10n", required=True)
+    p.add_argument("--tree", required=True)
+    p.set_defaults(func=cmd_derive)
+
+    p = sub.add_parser("resync")
+    p.add_argument("--tree", required=True)
+    p.set_defaults(func=cmd_resync)
+
+    p = sub.add_parser("selftest")
+    p.set_defaults(func=cmd_selftest)
+
+    args = ap.parse_args(argv)
+    try:
+        return args.func(args)
+    except MapError as exc:
+        print(f"fatal error: {exc}", file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
