 // Name of the RemoteSettings collection containing the rules.
 const COLLECTION_NAME = "cookie-banner-rules-list";
+
+// Android uses a reviewed application snapshot, never this collection's network
+// client. Updating these pins requires reviewing the complete snapshot again.
+const ANDROID_RULES_URL =
+  "resource://app/defaults/settings/main/cookie-banner-rules-list.json";
+const ANDROID_RULES_BYTES = 262208;
+const ANDROID_RULES_SHA256 =
+  "0ddab9560f17710fa1613825b1b8be0e190107dd679e2cd53c5a1822524958fd";
+const ANDROID_RULES_TIMESTAMP = 1725526980846;
+const ANDROID_RULES_COUNT = 558;
+
+async function validateAndroidRules(snapshot) {
+  if (
+    !snapshot ||
+    Object.keys(snapshot).some(key => key !== "data" && key !== "timestamp") ||
+    snapshot.timestamp !== ANDROID_RULES_TIMESTAMP ||
+    !Array.isArray(snapshot.data) ||
+    snapshot.data.length !== ANDROID_RULES_COUNT
+  ) {
+    throw new Error("Invalid Android cookie-banner snapshot envelope");
+  }
+
+  const validator = new lazy.JsonSchema.Validator(
+    await lazy.CookieBannerRuleSchema
+  );
+  const ids = new Set();
+  return snapshot.data.map(record => {
+    // Strip only known Remote Settings metadata. Unknown rule fields must still
+    // reach the schema validator and fail, rather than being silently discarded.
+    const { schema, last_modified, ...rule } = record;
+    const { valid } = validator.validate(rule);
+    if (
+      !valid ||
+      !rule.id ||
+      ids.has(rule.id) ||
+      !Number.isSafeInteger(schema) ||
+      !Number.isSafeInteger(last_modified) ||
+      rule.filter_expression
+    ) {
+      // There are no targeted records in the pinned snapshot. Do not bypass
+      // Remote Settings targeting if a future snapshot introduces one.
+      throw new Error(`Invalid Android cookie-banner rule: ${rule.id}`);
+    }
+    ids.add(rule.id);
+    return rule;
+  });
+}
+
+async function loadAndroidRules() {
+  const response = await fetch(ANDROID_RULES_URL);
+  if (!response.ok) {
+    throw new Error("Android cookie-banner snapshot is unavailable");
+  }
+  const buffer = await response.arrayBuffer();
+  if (
+    !(await lazy.SharedUtils.checkContentHash(
+      buffer,
+      ANDROID_RULES_BYTES,
+      ANDROID_RULES_SHA256
+    ))
+  ) {
+    throw new Error("Android cookie-banner snapshot integrity check failed");
+  }
+  return validateAndroidRules(
+    JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(buffer))
+  );
+}
 
