+  Assert.equal(rulesInserted.length, 558, "All pinned rules imported");
+  Assert.equal(new Set(rulesInserted.map(rule => rule.id)).size, 558, "Unique rule IDs");
+  const optOut = rulesInserted.find(rule => rule.domains.includes("duh.de"));
+  Assert.equal(optOut.cookiesOptOut[0].cookie.name, "cookie_dismiss", "Production opt-out cookie is preserved");
+  Assert.equal(optOut.cookiesOptOut[0].cookie.value, "true", "Production cookie signals dismissal");
+  Assert.ok(rulesInserted.some(rule => rule.id === "disabled"), "Intentional disabled-domain rule retained");
+  service.shutdown();
+  rulesInserted = [];
+  await service.initForTest();
+  Assert.equal(rulesInserted.length, 558, "Shutdown and reinit reload the full snapshot");
+  service.shutdown();
+  rulesInserted = [];
+});
