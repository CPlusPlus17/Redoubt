 #endif  // MOZ_WIDGET_ANDROID
 
+#ifdef MOZ_WIDGET_ANDROID
+// Redoubt (LW-M7-50, 158.0-2): isolated content and its media configuration
+// are one decision. GeckoRuntime (Java) puts
+// media.redoubt-isolation-media.enabled into MOZ_DEFAULT_PREFS, true exactly
+// when web content runs in an isolated process (owner decision 2026-10-11:
+// "158.0-2, Android 12+ only"; the SDK test is in Fenix's GeckoProvider). Here,
+// in the parent, right after that channel is parsed and before the profile,
+// autoconfig or any media code reads a pref:
+//  - the gate pref is locked to the value GeckoView gave, so neither
+//    about:config, prefs.js, librewolf.cfg nor a later SetDefaultPrefs can
+//    switch the codec allowlist without the process model;
+//  - only when it is true, upstream's eleven isolated-process media prefs
+//    (bug 1988531 part 1, mozilla-firefox e0286afb5f68, variants.yml
+//    geckoview-isolated-process) are set on the default branch and locked.
+// When it is false (Android 8-11) nothing else is touched: every media pref
+// keeps the value it has in 158.0-1. Child processes receive the values and
+// the locks from the parent.
+static void RedoubtApplyIsolationMediaPrefs() {
+  static const char kGate[] = "media.redoubt-isolation-media.enabled";
+  static const struct {
+    const char* mName;
+    bool mValue;
+  } kIsolatedMediaPrefs[] = {
+      {"media.android-media-codec.enabled", false},
+      {"media.android-media-codec.preferred", false},
+      {"media.ffmpeg.encoder.enabled", true},
+      {"media.ffvpx-hw.enabled", true},
+      {"media.rdd-ffvpx.enabled", true},
+      {"media.rdd-opus.enabled", true},
+      {"media.rdd-process.enabled", true},
+      {"media.rdd-vorbis.enabled", true},
+      {"media.rdd-vpx.enabled", true},
+      {"media.rdd-wav.enabled", true},
+      {"media.use-remote-encoder.video.platform", true},
+  };
+  bool isolated = false;
+  if (NS_FAILED(
+          Preferences::GetBool(kGate, &isolated, PrefValueKind::Default))) {
+    isolated = false;
+  }
+  if (isolated) {
+    for (const auto& p : kIsolatedMediaPrefs) {
+      Preferences::SetBool(p.mName, p.mValue, PrefValueKind::Default);
+      Preferences::Lock(p.mName);
+    }
+  }
+  Preferences::SetBool(kGate, isolated, PrefValueKind::Default);
+  Preferences::Lock(kGate);
+}
+#endif  // MOZ_WIDGET_ANDROID
