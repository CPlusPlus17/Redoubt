-    suspend fun create(): Result<TokenProvider>
-
-    companion object {
-
-        /**
-         * Returns a concrete [TokenProviderFactory] to be used by [GooglePlayIntegrityClient].
-         *
-         * @param integrityManagerProvider Provider for creating integrity managers.
