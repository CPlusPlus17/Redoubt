+
+bool CookieService::CleanupIsCurrent(const nsACString& aToken) const {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (aToken.IsEmpty() || aToken != mCleanupToken ||
+      mCleanupPersistent != mPersistentStorage ||
+      mCleanupPrivate != mPrivateStorage ||
+      AppShutdown::IsInOrBeyond(ShutdownPhase::AppShutdown)) {
+    return false;
+  }
+  CookiePersistentStorage* database = mPersistentStorage->AsPersistentStorage();
+  return database && database->CleanupConnectionIsCurrent(mCleanupDbGeneration);
+}
+
+NS_IMETHODIMP CookieService::BeginSessionCleanup(nsACString& aToken) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mCleanupToken.IsEmpty() || !IsInitialized() ||
+      AppShutdown::IsInOrBeyond(ShutdownPhase::AppShutdown)) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  RefPtr<CookieStorage> persistent = mPersistentStorage;
+  RefPtr<CookieStorage> privateStorage = mPrivateStorage;
+  persistent->EnsureInitialized();
+  // Initialization can notify observers. A reentrant begin/close must not let
+  // this request overwrite another lease or bind to replacement storage.
+  if (!mCleanupToken.IsEmpty() || persistent != mPersistentStorage ||
+      privateStorage != mPrivateStorage ||
+      AppShutdown::IsInOrBeyond(ShutdownPhase::AppShutdown)) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  CookiePersistentStorage* database = persistent->AsPersistentStorage();
+  if (!database ||
+      !database->CleanupConnectionIsCurrent(database->CleanupGeneration())) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  nsID id;
+  nsresult rv = nsID::GenerateUUIDInPlace(id);
+  NS_ENSURE_SUCCESS(rv, rv);
+  char token[NSID_LENGTH];
+  id.ToProvidedString(token);
+  mCleanupPersistent = mPersistentStorage;
+  mCleanupPrivate = mPrivateStorage;
+  mCleanupDbGeneration = database->CleanupGeneration();
+  mCleanupToken.Assign(token);
+  aToken = mCleanupToken;
+  return NS_OK;
+}
+
+void CookieService::ResolveCleanupScopes(Promise* aPromise,
+                                         const nsTArray<uint32_t>& aLiveIds) {
+  AutoJSAPI jsapi;
+  if (!jsapi.Init(aPromise->GetGlobalObject())) {
+    aPromise->MaybeReject(NS_ERROR_NOT_AVAILABLE);
+    return;
+  }
+  JSContext* cx = jsapi.cx();
+  JS::RootedObject array(cx, JS::NewArrayObject(cx, aLiveIds.Length()));
+  if (!array) {
+    aPromise->MaybeReject(NS_ERROR_OUT_OF_MEMORY);
+    return;
+  }
+  for (uint32_t i = 0; i < aLiveIds.Length(); ++i) {
+    const auto& scope = mCleanupScopes[aLiveIds[i]];
+    JS::RootedObject item(cx, JS_NewPlainObject(cx));
+    JS::RootedValue id(cx, JS::Int32Value(aLiveIds[i]));
+    JS::RootedValue host(cx);
+    JS::RootedValue attrs(cx);
+    if (!item || !ToJSValue(cx, scope.mHost, &host) ||
+        !ToJSValue(cx, scope.mOriginAttributes, &attrs) ||
+        !JS_DefineProperty(cx, item, "id", id, JSPROP_ENUMERATE) ||
+        !JS_DefineProperty(cx, item, "host", host, JSPROP_ENUMERATE) ||
+        !JS_DefineProperty(cx, item, "originAttributes", attrs, JSPROP_ENUMERATE) ||
+        !JS_SetElement(cx, array, i, item)) {
+      aPromise->MaybeReject(NS_ERROR_OUT_OF_MEMORY);
+      return;
+    }
+  }
+  JS::RootedValue value(cx, JS::ObjectValue(*array));
+  aPromise->MaybeResolve(value);
+}
+
+NS_IMETHODIMP CookieService::GetSessionCleanupScopes(
+    const nsACString& aToken, JSContext* aCx, Promise** aResult) {
+  ErrorResult error;
+  RefPtr<Promise> promise = Promise::Create(xpc::CurrentNativeGlobal(aCx), error);
+  if (error.Failed()) {
+    return error.StealNSResult();
+  }
+  if (!CleanupIsCurrent(aToken) || mCleanupBusy) {
+    promise->MaybeReject(NS_ERROR_NOT_AVAILABLE);
+    promise.forget(aResult);
+    return NS_OK;
+  }
+  mCleanupBusy = true;
+  mPersistentStorage->AsPersistentStorage()->ReadCleanupScopes()->Then(
+      GetCurrentSerialEventTarget(), __func__,
+      [self = RefPtr{this}, token = nsCString(aToken), promise](
+          nsTArray<CookieCleanupScope>&& aScopes) {
+        if (!self->CleanupIsCurrent(token)) {
+          self->mCleanupBusy = false;
+          promise->MaybeReject(NS_ERROR_NOT_AVAILABLE);
+          return;
+        }
+        self->mPersistentStorage->CollectCleanupScopes(aScopes);
+        self->mPrivateStorage->CollectCleanupScopes(aScopes);
+        if (aScopes.Length() > 100000) {
+          self->mCleanupBusy = false;
+          promise->MaybeReject(NS_ERROR_FILE_TOO_BIG);
+          return;
+        }
+        // Validate every database/memory host before publishing IDs. Never
+        // reinterpret an invalid stored predicate as a broader valid one.
+        for (const auto& scope : aScopes) {
+          nsCString canonical(scope.mHost);
+          nsAutoCString baseDomain;
+          nsresult rv = self->NormalizeHost(canonical);
+          if (NS_SUCCEEDED(rv)) {
+            rv = CookieCommons::GetBaseDomainFromHost(
+                self->mTLDService, canonical, baseDomain);
+          }
+          if (NS_FAILED(rv) || canonical != scope.mHost) {
+            self->mCleanupBusy = false;
+            promise->MaybeReject(NS_ERROR_FILE_CORRUPTED);
+            return;
+          }
+        }
+        nsTArray<uint32_t> liveIds;
+        for (const auto& scope : aScopes) {
+          if (!self->mCleanupScopes.Contains(scope)) {
+            if (self->mCleanupScopes.Length() >= 100000) {
+              self->mCleanupBusy = false;
+              promise->MaybeReject(NS_ERROR_FILE_TOO_BIG);
+              return;
+            }
+            self->mCleanupScopes.AppendElement(scope);
+          }
+          uint32_t id = self->mCleanupScopes.IndexOf(scope);
+          if (!liveIds.Contains(id)) {
+            liveIds.AppendElement(id);
+          }
+        }
+        self->mCleanupBusy = false;
+        self->ResolveCleanupScopes(promise, liveIds);
+      },
+      [self = RefPtr{this}, promise](nsresult aError) {
+        self->mCleanupBusy = false;
+        promise->MaybeReject(aError);
+      });
+  promise.forget(aResult);
+  return NS_OK;
+}
+
+NS_IMETHODIMP CookieService::RemoveSessionCleanupScopes(
+    const nsACString& aToken, const nsTArray<uint32_t>& aScopeIds,
+    JSContext* aCx, Promise** aResult) {
+  ErrorResult error;
+  RefPtr<Promise> promise = Promise::Create(xpc::CurrentNativeGlobal(aCx), error);
+  if (error.Failed()) {
+    return error.StealNSResult();
+  }
+  if (!CleanupIsCurrent(aToken) || mCleanupBusy) {
+    promise->MaybeReject(NS_ERROR_NOT_AVAILABLE);
+    promise.forget(aResult);
+    return NS_OK;
+  }
+  nsTArray<CookieCleanupScope> selected;
+  for (uint32_t id : aScopeIds) {
+    if (id >= mCleanupScopes.Length()) {
+      promise->MaybeReject(NS_ERROR_INVALID_ARG);
+      promise.forget(aResult);
+      return NS_OK;
+    }
+    if (!selected.Contains(mCleanupScopes[id])) {
+      selected.AppendElement(mCleanupScopes[id]);
+    }
+  }
+  mCleanupBusy = true;
+  mPersistentStorage->AsPersistentStorage()->DeleteCleanupScopes(selected)->Then(
+      GetCurrentSerialEventTarget(), __func__,
+      [self = RefPtr{this}, token = nsCString(aToken), promise,
+       selected = std::move(selected)](nsTArray<CookieCleanupScope>&&) {
+        if (!self->CleanupIsCurrent(token)) {
+          self->mCleanupBusy = false;
+          promise->MaybeReject(NS_ERROR_NOT_AVAILABLE);
+          return;
+        }
+        // Keep the lease busy through notifications: an observer cannot release
+        // the mutation gate or launch another cleanup between these two jars.
+        self->mPersistentStorage->RemoveCleanupScopesFromMemory(selected);
+        if (self->CleanupIsCurrent(token)) {
+          self->mPrivateStorage->RemoveCleanupScopesFromMemory(selected);
+        }
+        bool current = self->CleanupIsCurrent(token);
+        self->mCleanupBusy = false;
+        if (current) {
+          promise->MaybeResolveWithUndefined();
+        } else {
+          promise->MaybeReject(NS_ERROR_NOT_AVAILABLE);
+        }
+      },
+      [self = RefPtr{this}, promise](nsresult aError) {
+        self->mCleanupBusy = false;
+        promise->MaybeReject(aError);
+      });
+  promise.forget(aResult);
+  return NS_OK;
+}
+
+NS_IMETHODIMP CookieService::EndSessionCleanup(const nsACString& aToken) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (aToken.IsEmpty() || aToken != mCleanupToken || mCleanupBusy) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  mCleanupToken.Truncate();
+  mCleanupScopes.Clear();
+  mCleanupPersistent = nullptr;
+  mCleanupPrivate = nullptr;
+  return NS_OK;
+}
