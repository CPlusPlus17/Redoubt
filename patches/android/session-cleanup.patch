+void CookieStorage::RemoveCleanupScopesFromMemory(
+    const nsTArray<CookieCleanupScope>& aScopes) {
+  MOZ_ASSERT(NS_IsMainThread());
+  MOZ_ASSERT(CookieService::CookieMutationBlocked());
+  // Finish all mutations before sending any reentrant observer notifications.
+  // A scope references the exact stored host, including a domain cookie's dot.
+  nsTArray<std::pair<RefPtr<Cookie>, nsCString>> removed;
+  for (auto iter = mHostTable.Iter(); !iter.Done(); iter.Next()) {
+    CookieEntry* entry = iter.Get();
+    auto& cookies = entry->GetCookies();
+    for (size_t i = cookies.Length(); i > 0; --i) {
+      Cookie* cookie = cookies[i - 1];
+      if (aScopes.Contains(CookieCleanupScope{
+              cookie->Host(), cookie->OriginAttributesRef()})) {
+        removed.AppendElement(
+            std::make_pair(RefPtr{cookie}, nsCString(entry->mBaseDomain)));
+        cookies.RemoveElementAt(i - 1);
+        --mCookieCount;
+      }
+    }
+    if (cookies.IsEmpty()) {
+      iter.Remove();
+    }
+  }
+  for (const auto& item : removed) {
+    NotifyChanged(item.first, nsICookieNotification::COOKIE_DELETED, item.second);
+  }
+}
