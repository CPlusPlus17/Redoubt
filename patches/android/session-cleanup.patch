+++ b/netwerk/cookie/CookiePersistentStorage.cpp
@@ -15,9 +15,12 @@
 #include "mozIStorageBindingParamsArray.h"
 #include "mozIStorageError.h"
 #include "mozIStorageFunction.h"
+#include "mozIStorageResultSet.h"
+#include "mozIStorageRow.h"
 #include "mozIStorageService.h"
 #include "mozStorageHelper.h"
 #include "mozilla/AppShutdown.h"
+#include "mozilla/AutoRestore.h"
 #include "mozilla/Components.h"
 #include "mozilla/FileUtils.h"
 #include "mozilla/ProfilerMarkers.h"
@@ -627,7 +630,209 @@ void CookiePersistentStorage::CleanupCachedStatements() {
 // will not null out the statements, cancel a pending read or
 // asynchronously close the connection -- these must be done
 // beforehand if necessary.
+// This callback belongs to one checked cleanup statement. Ordinary cookie
+// listeners deliberately retain their existing behavior.
+class CookieCleanupCallback final : public mozIStorageStatementCallback {
+ public:
+  NS_DECL_THREADSAFE_ISUPPORTS
+
+  CookieCleanupCallback(CookiePersistentStorage* aStorage, bool aCollectScopes)
+      : mStorage(aStorage),
+        mGeneration(aStorage->CleanupGeneration()),
+        mCollectScopes(aCollectScopes) {}
+
+  RefPtr<CookiePersistentStorage::CleanupPromise> Promise() {
+    return mPromise.Ensure(__func__);
+  }
+
+  void Fail(nsresult aResult) { mPromise.Reject(aResult, __func__); }
+
+  NS_IMETHOD HandleResult(mozIStorageResultSet* aResults) override {
+    if (!mCollectScopes || NS_FAILED(mResult)) {
+      return NS_OK;
+    }
+    nsCOMPtr<mozIStorageRow> row;
+    while (NS_SUCCEEDED(mResult = aResults->GetNextRow(getter_AddRefs(row))) &&
+           row) {
+      CookieCleanupScope scope;
+      nsAutoCString suffix;
+      mResult = row->GetUTF8String(0, scope.mHost);
+      if (NS_FAILED(mResult)) {
+        break;
+      }
+      mResult = row->GetUTF8String(1, suffix);
+      if (NS_FAILED(mResult)) {
+        break;
+      }
+      // Bounded even for a manually altered database. Failure is not truncation.
+      if (mScopes.Length() >= 100000 || scope.mHost.Length() > 4096 ||
+          suffix.Length() > 16384) {
+        mResult = NS_ERROR_FILE_TOO_BIG;
+        break;
+      }
+      // Never silently collapse corrupt or unknown attributes into the default
+      // jar. Returning an empty or approximate scope set would lose data.
+      nsAutoCString canonical;
+      if (!scope.mOriginAttributes.PopulateFromSuffix(suffix)) {
+        mResult = NS_ERROR_FILE_CORRUPTED;
+        break;
+      }
+      scope.mOriginAttributes.CreateSuffix(canonical);
+      if (canonical != suffix || scope.mOriginAttributes.IsPrivateBrowsing()) {
+        mResult = NS_ERROR_FILE_CORRUPTED;
+        break;
+      }
+      mScopes.AppendElement(std::move(scope));
+    }
+    return NS_OK;
+  }
+
+  NS_IMETHOD HandleError(mozIStorageError* /*aError*/) override {
+    mResult = NS_ERROR_FAILURE;
+    return NS_OK;
+  }
+
+  NS_IMETHOD HandleCompletion(uint16_t aReason) override {
+    // mozStorage reports FINISHED only after its transaction commit. A callback
+    // from an old/closing/rebuilt connection cannot establish current success.
+    if (!mStorage->CleanupConnectionIsCurrent(mGeneration)) {
+      mResult = NS_ERROR_NOT_AVAILABLE;
+    } else if (aReason != REASON_FINISHED && NS_SUCCEEDED(mResult)) {
+      mResult = aReason == REASON_CANCELED ? NS_ERROR_ABORT : NS_ERROR_FAILURE;
+    }
+    if (NS_FAILED(mResult)) {
+      mPromise.Reject(mResult, __func__);
+    } else {
+      mPromise.Resolve(std::move(mScopes), __func__);
+    }
+    return NS_OK;
+  }
+
+ private:
+  ~CookieCleanupCallback() = default;
+  RefPtr<CookiePersistentStorage> mStorage;
+  const uint64_t mGeneration;
+  const bool mCollectScopes;
+  nsresult mResult = NS_OK;
+  nsTArray<CookieCleanupScope> mScopes;
+  MozPromiseHolder<CookiePersistentStorage::CleanupPromise> mPromise;
+};
+
+NS_IMPL_ISUPPORTS(CookieCleanupCallback, mozIStorageStatementCallback)
+
+bool CookiePersistentStorage::CleanupConnectionIsCurrent(
+    uint64_t aGeneration) const {
+  MOZ_ASSERT(NS_IsMainThread());
+  return mInitialized && mInitializedDBConn && mDBConn && mCorruptFlag == OK &&
+         !mParentCookieTransaction && mCleanupGeneration == aGeneration;
+}
+
+RefPtr<CookiePersistentStorage::CleanupPromise>
+CookiePersistentStorage::ExecuteCleanupStatement(
+    mozIStorageAsyncStatement* aStatement, bool aCollectScopes) {
+  RefPtr<CookieCleanupCallback> callback =
+      new CookieCleanupCallback(this, aCollectScopes);
+  RefPtr<CleanupPromise> promise = callback->Promise();
+  nsCOMPtr<mozIStoragePendingStatement> pending;
+  nsresult rv = aStatement->ExecuteAsync(callback, getter_AddRefs(pending));
+  if (NS_FAILED(rv)) {
+    callback->Fail(rv);
+  }
+  // The executing statement owns its parameters and callback until completion.
+  return promise;
+}
+
+RefPtr<CookiePersistentStorage::CleanupPromise>
+CookiePersistentStorage::ReadCleanupScopes() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!CleanupConnectionIsCurrent(mCleanupGeneration)) {
+    return CleanupPromise::CreateAndReject(NS_ERROR_NOT_AVAILABLE, __func__);
+  }
+  // Cookie writes are buffered by mWriteQueue (Firefox 157). Dispatch them
+  // first: the connection runs async statements in order, so this read sees
+  // every change made before it was requested.
+  mWriteQueue->FlushNow();
+  nsCOMPtr<mozIStorageAsyncStatement> statement;
+  nsresult rv = mDBConn->CreateAsyncStatement(
+      "SELECT DISTINCT host, originAttributes FROM moz_cookies"_ns,
+      getter_AddRefs(statement));
+  if (NS_FAILED(rv)) {
+    return CleanupPromise::CreateAndReject(rv, __func__);
+  }
+  return ExecuteCleanupStatement(statement, true);
+}
+
+RefPtr<CookiePersistentStorage::CleanupPromise>
+CookiePersistentStorage::DeleteCleanupScopes(
+    const nsTArray<CookieCleanupScope>& aScopes) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!CleanupConnectionIsCurrent(mCleanupGeneration)) {
+    return CleanupPromise::CreateAndReject(NS_ERROR_NOT_AVAILABLE, __func__);
+  }
+  uint32_t count = 0;
+  nsAutoCString sql("DELETE FROM moz_cookies WHERE (host, originAttributes) "
+                    "IN (VALUES ");
+  for (const auto& scope : aScopes) {
+    if (!scope.mOriginAttributes.IsPrivateBrowsing()) {
+      if (count++) {
+        sql.AppendLiteral(", ");
+      }
+      sql.AppendLiteral("(?, ?)");
+    }
+  }
+  if (!count) {
+    return ReadCleanupScopes();
+  }
+  // Order any buffered write (an insertion queued before the lease began)
+  // ahead of this DELETE, so a later batch cannot re-create a removed row.
+  mWriteQueue->FlushNow();
+  sql.Append(')');
+  nsCOMPtr<mozIStorageAsyncStatement> statement;
+  nsresult rv = mDBConn->CreateAsyncStatement(sql, getter_AddRefs(statement));
+  if (NS_FAILED(rv)) {
+    // Includes SQLite's parameter/SQL-size limits; no prefix was executed.
+    return CleanupPromise::CreateAndReject(rv, __func__);
+  }
+  nsCOMPtr<mozIStorageBindingParamsArray> parameters;
+  rv = statement->NewBindingParamsArray(getter_AddRefs(parameters));
+  if (NS_FAILED(rv)) {
+    return CleanupPromise::CreateAndReject(rv, __func__);
+  }
+  nsCOMPtr<mozIStorageBindingParams> values;
+  rv = parameters->NewBindingParams(getter_AddRefs(values));
+  if (NS_FAILED(rv)) {
+    return CleanupPromise::CreateAndReject(rv, __func__);
+  }
+  uint32_t index = 0;
+  for (const auto& scope : aScopes) {
+    if (scope.mOriginAttributes.IsPrivateBrowsing()) {
+      continue;
+    }
+    nsAutoCString suffix;
+    scope.mOriginAttributes.CreateSuffix(suffix);
+    rv = values->BindUTF8StringByIndex(index++, scope.mHost);
+    if (NS_SUCCEEDED(rv)) {
+      rv = values->BindUTF8StringByIndex(index++, suffix);
+    }
+    if (NS_FAILED(rv)) {
+      return CleanupPromise::CreateAndReject(rv, __func__);
+    }
+  }
+  rv = parameters->AddParams(values);
+  if (NS_SUCCEEDED(rv)) {
+    rv = statement->BindParameters(parameters);
+  }
+  if (NS_FAILED(rv)) {
+    return CleanupPromise::CreateAndReject(rv, __func__);
+  }
+  // Exactly one DELETE with one parameter set: SQLite atomically executes the
+  // complete selection. Do not rely on mozStorage's multi-binding BEGIN path,
+  // which can proceed after a failed BEGIN or join an ambient transaction.
+  return ExecuteCleanupStatement(statement, false);
+}
