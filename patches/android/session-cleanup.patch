+already_AddRefed<Promise> nsFrameLoader::WhenDestroyed(ErrorResult& aRv) {
+  if (!mDestroyedPromise) {
+    // Use the same stable privileged global as GetParentObject(). The owner
+    // document may already have been detached when the first waiter arrives.
+    mDestroyedPromise = Promise::Create(
+        xpc::NativeGlobal(xpc::PrivilegedJunkScope()), aRv);
+    if (aRv.Failed()) {
+      return nullptr;
+    }
+    if (mDestroyComplete) {
+      mDestroyedPromise->MaybeResolveWithUndefined();
+    }
+  }
