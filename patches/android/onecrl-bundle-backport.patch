# Redoubt onecrl-bundle-backport.patch  (Android, android.txt, 158.0.1-1)
# Owner: LW-M7-52. BACKPORT of upstream bug 2084311, the only Gecko change in
# Firefox for Android 158.0.2 (MFSA 2026-116, CVE-2026-113470, high).
#
#   Bug 2084311 - ensure OneCRL bundle is loaded at init a=diannaS
#   Author: Dana Keeler <dkeeler@mozilla.com>, 2026-10-21
#   mozilla-firefox commit 08d23041955657e661eef22c8fdc967735300233
#   (FIREFOX-ANDROID_158_0_2_RELEASE; 158.0.1 + this commit + the version bump)
#   Differential Revision: https://phabricator.services.mozilla.com/D335838
#   Upstream patch sha256 (github.com/.../commit/<sha>.patch, fetched 2026-10-26):
#   2ecebdafe90b8682924a481e49c9da8456333813ecccc88e4cb1c6f44f92857c
#
# Why: Mozilla shipped no firefox-158.0.2.source.tar.xz, so Redoubt builds the
# 158.0.1 tarball and carries the fix (SECURITY.md, "Android-only with no source
# tarball"). Without it RemoteSecuritySettings.init() only listens for OneCRL
# "sync" events, so the revocations bundled in the dump never reach cert_storage
# until the first remote sync (upstream's test: six emSign G3 intermediates
# stay trusted). Redoubt keeps security-state/* (settings/android.cfg).
#
# Code hunk only; upstream's xpcshell test (test_onecrl_loads_bundle.js and its
# xpcshell.toml entry) is not carried, since no test runs from the shipped tree.
# Unchanged from upstream. Drop at the first rebase whose tarball already has
# it (RemoteSecuritySettings.init() calls OneCRLBlocklistClient.get()).

diff --git a/security/manager/ssl/RemoteSecuritySettings.sys.mjs b/security/manager/ssl/RemoteSecuritySettings.sys.mjs
index 0c896c80d530d..3e5f9f35ae383 100644
--- a/security/manager/ssl/RemoteSecuritySettings.sys.mjs
+++ b/security/manager/ssl/RemoteSecuritySettings.sys.mjs
@@ -259,6 +259,28 @@ export var RemoteSecuritySettings = {
       signerName: SECURITY_STATE_SIGNER,
     });
     this.OneCRLBlocklistClient.on("sync", updateCertBlocklist);
+    // Ensure the bundled list of revocations is loaded.
+    this.OneCRLBlocklistClient.get()
+      .then(records => {
+        return updateCertBlocklist({
+          data: {
+            current: records,
+            created: records,
+            updated: [],
+            deleted: [],
+          },
+        });
+      })
+      .catch(e => {
+        lazy.log.error(e);
+      })
+      .finally(() => {
+        // Only used by tests, to know when the bundled list is in cert_storage.
+        Services.obs.notifyObservers(
+          null,
+          "remote-security-settings:onecrl-bundle-loaded"
+        );
+      });
 
     this.IntermediatePreloadsClient = new IntermediatePreloads();
 
